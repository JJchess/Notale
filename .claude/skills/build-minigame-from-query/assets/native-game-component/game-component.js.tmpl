const GAME_TITLE = __TITLE_JSON__;

const componentTemplate = document.createElement("template");
componentTemplate.innerHTML = `
  <style>
    :host {
      --game-bg: #151817;
      --game-surface: #202422;
      --game-line: #48504b;
      --game-text: #f0eee7;
      --game-muted: #adb3ae;
      --game-accent: #e8da55;
      display: block;
      min-width: 280px;
      min-height: 100dvh;
      color: var(--game-text);
      background: var(--game-bg);
      font-family: Arial, "Helvetica Neue", sans-serif;
      color-scheme: dark;
    }

    * { box-sizing: border-box; }

    button { font: inherit; }

    button:focus-visible,
    [tabindex]:focus-visible {
      outline: 3px solid var(--game-accent);
      outline-offset: 3px;
    }

    .shell {
      width: min(100% - 32px, 720px);
      margin: 0 auto;
      padding: clamp(32px, 7vw, 72px) 0;
    }

    header { margin-bottom: 28px; }

    h1 {
      max-width: 16ch;
      margin: 0 0 14px;
      font-size: clamp(36px, 7vw, 68px);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 0.98;
    }

    .brief {
      max-width: 54ch;
      margin: 0;
      color: var(--game-muted);
      font-size: 16px;
      line-height: 1.55;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 9px;
      color: var(--game-muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
    }

    .playfield {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      aspect-ratio: 1;
      padding: 12px;
      border: 1px solid var(--game-line);
      background: var(--game-surface);
    }

    .cell {
      border: 1px solid var(--game-line);
      border-radius: 0;
      background: #2a302d;
      color: var(--game-text);
      cursor: pointer;
      font-size: clamp(22px, 6vw, 40px);
      transition: background 140ms ease, color 140ms ease, transform 120ms ease;
    }

    .cell:hover:not(:disabled) { background: #373e3a; }

    .cell:active:not(:disabled) { transform: scale(0.97); }

    .cell[data-target="true"] {
      background: var(--game-accent);
      color: #222216;
    }

    .cell:disabled { cursor: default; }

    .actions {
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }

    .primary {
      min-height: 42px;
      padding: 0 22px;
      border: 0;
      border-radius: 0;
      background: var(--game-text);
      color: #202220;
      cursor: pointer;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .primary:hover { background: var(--game-accent); }

    .primary:active { transform: translateY(1px); }

    .message {
      min-height: 1.5em;
      margin: 15px 0 0;
      color: var(--game-text);
      line-height: 1.5;
