# Notale model keys. Copy to .env.local in this directory and fill in what you use.
# Read by notale-ts (Valar generates, Istar edits) and notale-editor; shell variables win.
# .env.local is git-ignored.

# Google Gemini — required.
#   gemini-3.8-flash: understanding each message, planning, visual direction, building
#   pages, and Istar edits (PDF and video input through the Gemini Files API).
#   Image search (Google Search grounding) uses the same key.
GEMINI_API_KEY=

# Paratera — recommended.
#   Doubao-Seedream-4.0: ImageGen illustrations.
#   GLM-5.3-Flash: builds code pages.
#   Editor model picker: any model the account lists (e.g. AWS-Claude-Sonnet-5).
PARATERA_API_KEY=

# SiliconFlow — optional.
#   DeepSeek-V4-Flash: alternative page builder (--profile deepseek-v4-flash-*),
#   and the editor model picker.
SILICONFLOW_API_KEY=

# OpenRouter — optional. Editor model picker only.
OPENROUTER_API_KEY=

# The editor picker also accepts OPENAI_API_KEY, DEEPSEEK_API_KEY, XAI_API_KEY and
# MOONSHOT_API_KEY if you add them.
