# 外部参考克隆 —— 各自带独立 .git，是调研输入而非本项目代码，不纳入版本控制
/refs/

# 密钥（绝不入库）
# .env 这个模式只匹配名字正好是 .env 的文件,不覆盖 .env.local ——
# 实测 notale/.env.local 和 notale-v2/.env.local 里都是真 key,差点被提交上去。
.env
.env.local
*.env.local
*.key

# 实验台：抓包、归档页面、预览产物，不入库
/experiments/lab/
*.mp4

# Harness 运行产物统一落在这里。它既包含可再生的大文件，也可能包含未脱敏
# 的逐字工具结果，因此整个目录只留在本机，不纳入版本控制。
/runs
/experiments/runs/

# 临时/输出
scratchpad/
*.tmp
__pycache__/
*.pyc

# 实验区默认不入库；只保留明确列出的实验代码与轻量证据。
/experiments/
# 隔离的 Builder 收敛实验代码需要入库；它自己的 `.runs/` 仍由子目录忽略。
!/experiments/
/experiments/*
!/experiments/builder-convergence-2x2/
!/experiments/builder-convergence-2x2/**
!/experiments/notale-v2/
!/experiments/notale-v2/**
/outputs/
/lecture-agent/experiments/*
!/lecture-agent/experiments/single_owner_shm_20260807_final/
!/lecture-agent/experiments/frame_constrained_shm_final_20260807/
!/lecture-agent/experiments/frame_constrained_shm_valid_20260807/

# OS / 编辑器杂物
.DS_Store
Thumbs.db
desktop.ini
*~

# 轨迹采集台:抓包含密钥(脱敏前)且体积大,不入库;起点清单是机器本地状态
/infra/harness-kit/runs/
/infra/harness-kit/.manifests/

# 采集实验的被试工作目录(每轮 reset 清空)
/exp/

# 外部 benchmark 克隆，各自带 .git，同 refs/ 处理
/benchmark/
