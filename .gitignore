# 外部参考克隆 —— 各自带独立 .git，是调研输入而非本项目代码，不纳入版本控制
/refs/

# 密钥（绝不入库）
# .env 这个模式只匹配名字正好是 .env 的文件,不覆盖 .env.local ——
# 实测 notale/.env.local 和 notale-v2/.env.local 里都是真 key,差点被提交上去。
.env
.env.local
*.env.local
*.key

# 实验台：抓包、归档页面、预览产物，不入库
*.mp4

# Harness 运行产物统一落在这里。它既包含可再生的大文件，也可能包含未脱敏
# 的逐字工具结果，因此整个目录只留在本机，不纳入版本控制。
/runs

# 临时/输出
scratchpad/
*.tmp
__pycache__/
*.pyc

# 本地实验、开发基础设施和原始课件模板，不纳入版本控制。
/experiments/
/infra/
/秀钟书院特色课程PPT模板-课程名称在母版视图修改.pptx
/outputs/
/lecture-agent/experiments/*
