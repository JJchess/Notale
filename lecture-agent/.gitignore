# —— Python 重写产物（旧 Node 的忽略项仍在仓库根 .gitignore）——
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/

# 实验目录 experiments/：输入(fixtures 录制盒 + topics 题集)入库；生成物不入库。
experiments/results/
experiments/corpus/
# serve_app 每个 job 的生成物（per-run deck），临时产物不入库
experiments/app/
# Hydra 每次运行的输出目录（.hydra 配置 + 运行日志），临时产物不入库
outputs/

# LLM 录制盒：默认提交（离线 replay 需要）；若快照过大改走 release 时再忽略
# fixtures/
.env
