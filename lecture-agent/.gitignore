# —— Python 重写产物（旧 Node 的忽略项仍在仓库根 .gitignore）——
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# 实验产物：每 run 一目录，不入库（走 release/DVC）
results/
# Hydra 每次运行的输出目录（.hydra 配置 + 运行日志），临时产物不入库
outputs/

# 大生成语料不入库；data/topics 与 data/human_ratings 版本化（见 PROJECT_STRUCTURE §2）
data/corpus/

# LLM 录制盒：默认提交（离线 replay 需要）；若快照过大改走 release 时再忽略
# fixtures/
.env
