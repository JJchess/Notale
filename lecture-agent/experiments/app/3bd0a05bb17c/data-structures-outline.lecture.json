        {
          "type": "sim",
          "engine": "widget",
          "caption": "拖动滑块调整排序速度，观察元素移动过程",
          "html": "<style>#container { display: flex; flex-direction: column; align-items: center; gap: 12px; } #controls { width: 100%; } canvas { background: var(--bg); border: 1px solid var(--line); }</style><div id='container'><canvas id='cv' width='400' height='200'></canvas><div id='controls'><input type='range' id='speed' min='1' max='10' value='5'></div><div><button id='bubble'>冒泡排序</button><button id='insertion'>插入排序</button></div></div><script>const cv = document.getElementById('cv'); const ctx = cv.getContext('2d'); const speedControl = document.getElementById('speed'); let arr = [5, 3, 8, 4, 2, 7, 1, 10, 6, 9]; let sorting = false; let currentAlgorithm = null; function drawArray(highlight = []) { ctx.clearRect(0, 0, cv.width, cv.height); const w = 30; const hUnit = 15; for (let i = 0; i < arr.length; i++) { ctx.fillStyle = highlight.includes(i) ? 'var(--accent)' : 'var(--ink)'; ctx.fillRect(40 + i * (w + 10), 180 - arr[i] * hUnit, w, arr[i] * hUnit); ctx.strokeStyle = 'var(--line)'; ctx.strokeRect(40 + i * (w + 10), 180 - arr[i] * hUnit, w, arr[i] * hUnit); } } async function bubbleSort() { if (sorting) return; sorting = true; currentAlgorithm = 'bubble'; for (let i = 0; i < arr.length - 1; i++) { for (let j = 0; j < arr.length - 1 - i; j++) { drawArray([j, j + 1]); await new Promise(r => setTimeout(r, 1100 - speedControl.value * 100)); if (arr[j] > arr[j + 1]) { [arr[j], arr[j + 1]] = [arr[j + 1], arr[j]]; drawArray([j, j + 1]); await new Promise(r => setTimeout(r, 1100 - speedControl.value * 100)); } } } sorting = false; } async function insertionSort() { if (sorting) return; sorting = true; currentAlgorithm = 'insertion'; for (let i = 1; i < arr.length; i++) { let key = arr[i]; let j = i - 1; while (j >= 0 && arr[j] > key) { drawArray([j, j + 1]); await new Promise(r => setTimeout(r, 1100 - speedControl.value * 100)); arr[j + 1] = arr[j]; j--; } arr[j + 1] = key; drawArray([j + 1]); await new Promise(r => setTimeout(r, 1100 - speedControl.value * 100)); } sorting = false; } document.getElementById('bubble').addEventListener('click', () => { if (!sorting || currentAlgorithm !== 'bubble') { arr = [5, 3, 8, 4, 2, 7, 1, 10, 6, 9]; bubbleSort(); } }); document.getElementById('insertion').addEventListener('click', () => { if (!sorting || currentAlgorithm !== 'insertion') { arr = [5, 3, 8, 4, 2, 7, 1, 10, 6, 9]; insertionSort(); } }); drawArray();</script>",
          "id": "b4"
        }
      ],
