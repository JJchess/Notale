          "xLabel": "排序算法",
          "yLabel": "时间复杂度 (O(n^2)/O(n log n))",
          "caption": "常见排序算法的时间复杂度对比，数值越小性能越好",
          "id": "b5"
        },
        {
          "type": "sim",
          "engine": "widget",
          "html": "<style>\n  .quicksort {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    padding: 16px;\n    background: var(--bg);\n    color: var(--ink);\n    font-family: var(--sans);\n  }\n  .controls {\n    display: flex;\n    gap: 12px;\n    align-items: center;\n  }\n  button {\n    padding: 6px 12px;\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    color: var(--ink);\n    font-family: var(--sans);\n    cursor: pointer;\n    transition: all 150ms ease;\n  }\n  button:hover {\n    background: var(--bg2);\n  }\n  button:active {\n    transform: translateY(1px);\n  }\n  .mono {\n    font-family: var(--mono);\n    font-variant-numeric: tabular-nums;\n  }\n  .stage {\n    width: 100%;\n    height: 200px;\n    background: var(--card);\n    border-radius: var(--radius);\n    overflow: visible;\n  }\n  .legend {\n    display: flex;\n    gap: 16px;\n    font-size: 12px;\n    color: var(--text2);\n  }\n  .legend-item {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .legend-color {\n    width: 12px;\n    height: 12px;\n    border-radius: 2px;\n  }\n</style>\n\n<div class=\"quicksort\">\n  <div class=\"stage\" id=\"svgContainer\"></div>\n  \n  <div class=\"controls\">\n    <button id=\"next\">下一步</button>\n    <button id=\"reset\">重置</button>\n  </div>\n  \n  <div class=\"legend\">\n    <div class=\"legend-item\">\n      <div class=\"legend-color\" style=\"background: var(--accent)\"></div>\n      <span>基准值</span>\n    </div>\n    <div class=\"legend-item\">\n      <div class=\"legend-color\" style=\"background: var(--accent-light)\"></div>\n      <span>i指针</span>\n    </div>\n    <div class=\"legend-item\">\n      <div class=\"legend-color\" style=\"background: var(--accent-dark)\"></div>\n      <span>j指针</span>\n    </div>\n    <div class=\"legend-item\">\n      <div class=\"legend-color\" style=\"background: var(--bg2)\"></div>\n      <span>已处理</span>\n    </div>\n  </div>\n</div>\n\n<script>\n  const state = {\n    array: [5, 3, 1, 9, 8, 2, 4, 7],\n    pivotIndex: 0,\n    i: 1,\n    j: 7,\n    step: 'partition'\n  };\n\n  const svgNS = \"http://www.w3.org/2000/svg\";\n  const svg = document.createElementNS(svgNS, \"svg\");\n  svg.setAttribute(\"width\", \"100%\");\n  svg.setAttribute(\"height\", \"100%\");\n  svg.setAttribute(\"viewBox\", \"0 0 800 200\");\n  document.getElementById('svgContainer').appendChild(svg);\n\n  function getColors() {\n    const style = getComputedStyle(document.documentElement);\n    return {\n      bg: style.getPropertyValue('--bg').trim(),\n      card: style.getPropertyValue('--card').trim(),\n      ink: style.getPropertyValue('--ink').trim(),\n      accent: style.getPropertyValue('--accent').trim(),\n      accentLight: style.getPropertyValue('--accent-light') || '#8ab4f8',\n      accentDark: style.getPropertyValue('--accent-dark') || '#81c784',\n      line: style.getPropertyValue('--line').trim(),\n      text2: style.getPropertyValue('--text2').trim()\n    };\n  }\n\n  function update() {\n    const colors = getColors();\n    svg.innerHTML = '';\n    \n    const barWidth = 80;\n    const barHeightUnit = 15;\n    const startX = 50;\n    const startY = 150;\n    \n    state.array.forEach((value, index) => {\n      const x = startX + index * barWidth;\n      const height = value * barHeightUnit;\n      \n      let fill = colors.card;\n      if (index === state.pivotIndex) fill = colors.accent;\n      else if (index < state.pivotIndex) fill = colors.bg2;\n      \n      const rect = document.createElementNS(svgNS, \"rect\");\n      rect.setAttribute(\"x\", x);\n      rect.setAttribute(\"y\", startY - height);\n      rect.setAttribute(\"width\", barWidth - 10);\n      rect.setAttribute(\"height\", height);\n      rect.setAttribute(\"fill\", fill);\n      rect.setAttribute(\"stroke\", colors.line);\n      rect.setAttribute(\"stroke-width\", \"1\");\n      svg.appendChild(rect);\n      \n      const text = document.createElementNS(svgNS, \"text\");\n      text.setAttribute(\"x\", x + (barWidth - 10) / 2);\n      text.setAttribute(\"y\", startY - height - 5);\n      text.setAttribute(\"text-anchor\", \"middle\");\n      text.setAttribute(\"fill\", colors.ink);\n      text.setAttribute(\"font-family\", colors.mono);\n      text.textContent = value;\n      svg.appendChild(text);\n      \n      const indexText = document.createElementNS(svgNS, \"text\");\n      indexText.setAttribute(\"x\", x + (barWidth - 10) / 2);\n      indexText.setAttribute(\"y\", startY + 20);\n      indexText.setAttribute(\"text-anchor\", \"middle\");\n      indexText.setAttribute(\"fill\", colors.text2);\n      indexText.setAttribute(\"font-family\", colors.mono);\n      indexText.textContent = index;\n      svg.appendChild(indexText);\n    });\n    \n    const iX = startX + state.i * barWidth + (barWidth - 10) / 2;\n    const iMarker = document.createElementNS(svgNS, \"path\");\n    iMarker.setAttribute(\"d\", `M${iX},${startY + 30} L${iX - 10},${startY + 50} L${iX + 10},${startY + 50} Z`);\n    iMarker.setAttribute(\"fill\", colors.accentLight);\n    svg.appendChild(iMarker);\n    \n    const iLabel = document.createElementNS(svgNS, \"text\");\n    iLabel.setAttribute(\"x\", iX);\n    iLabel.setAttribute(\"y\", startY + 70);\n    iLabel.setAttribute(\"text-anchor\", \"middle\");\n    iLabel.setAttribute(\"fill\", colors.accentLight);\n    iLabel.textContent = \"i\";\n    svg.appendChild(iLabel);\n    \n    const jX = startX + state.j * barWidth + (barWidth - 10) / 2;\n    const jMarker = document.createElementNS(svgNS, \"path\");\n    jMarker.setAttribute(\"d\", `M${jX},${startY + 30} L${jX - 10},${startY + 50} L${jX + 10},${startY + 50} Z`);\n    jMarker.setAttribute(\"fill\", colors.accentDark);\n    svg.appendChild(jMarker);\n    \n    const jLabel = document.createElementNS(svgNS, \"text\");\n    jLabel.setAttribute(\"x\", jX);\n    jLabel.setAttribute(\"y\", startY + 70);\n    jLabel.setAttribute(\"text-anchor\", \"middle\");\n    jLabel.setAttribute(\"fill\", colors.accentDark);\n    jLabel.textContent = \"j\";\n    svg.appendChild(jLabel);\n    \n    const desc = document.createElementNS(svgNS, \"text\");\n    desc.setAttribute(\"x\", 20);\n    desc.setAttribute(\"y\", 30);\n    desc.setAttribute(\"fill\", colors.ink);\n    desc.textContent = getStepDescription();\n    svg.appendChild(desc);\n  }\n  \n  function getStepDescription() {\n    switch(state.step) {\n      case 'partition':\n        return `划分中: 比较元素 ${state.array[state.i]} 和基准值 ${state.array[state.pivotIndex]}`;\n      case 'swap':\n        return `交换元素: ${state.array[state.i]} ↔ ${state.array[state.j]}`;\n      case 'recurse':\n        return `递归处理子数组`;\n      default:\n        return '';\n    }\n  }\n  \n  function nextStep() {\n    if (state.step === 'partition') {\n      if (state.i <= state.j) {\n        if (state.array[state.i] <= state.array[state.pivotIndex]) {\n          state.i++;\n        } else if (state.array[state.j] >= state.array[state.pivotIndex]) {\n          state.j--;\n        } else {\n          state.step = 'swap';\n        }\n      } else {\n        [state.array[state.pivotIndex], state.array[state.j]] = [state.array[state.j], state.array[state.pivotIndex]];\n        state.pivotIndex = state.j;\n        state.step = 'recurse';\n      }\n    } else if (state.step === 'swap') {\n      [state.array[state.i], state.array[state.j]] = [state.array[state.j], state.array[state.i]];\n      state.step = 'partition';\n    } else if (state.step === 'recurse') {\n      if (state.pivotIndex > 0) {\n        state.j = state.pivotIndex - 1;\n        state.pivotIndex = 0;\n        state.i = 1;\n        state.step = 'partition';\n      } else if (state.pivotIndex < state.array.length - 1) {\n        state.i = state.pivotIndex + 2;\n        state.j = state.array.length - 1;\n        state.pivotIndex = state.pivotIndex + 1;\n        state.step = 'partition';\n      } else {\n        state.step = 'complete';\n      }\n    }\n    update();\n  }\n  \n  function reset() {\n    state.array = [5, 3, 1, 9, 8, 2, 4, 7];\n    state.pivotIndex = 0;\n    state.i = 1;\n    state.j = 7;\n    state.step = 'partition';\n    update();\n  }\n  \n  document.getElementById('next').addEventListener('click', nextStep);\n  document.getElementById('reset').addEventListener('click', reset);\n  \n  update();\n</script>",
          "id": "b6"
        }
      ],
