    {
      "id": "linear-structures",
      "kind": "content",
      "eyebrow": "线性结构",
      "headline": "数组与链表",
      "lead": "数组和链表是两种最基本的线性结构，各有优缺点。",
      "transition": "zoom",
      "notes": "同学们注意，数组和链表的对比是理解数据结构选择的关键。数组的连续内存特性带来O(1)随机访问优势，但插入/删除成本高；而链表通过指针实现动态扩展，插入/删除只需O(1)，但随机访问需要O(n)遍历。常见误区是认为链表在任何情况下都优于数组，实际上在需要频繁随机访问的场景（如二分查找），数组性能更好。接下来我们将看到这些特性如何影响排序算法的选择。",
      "blocks": [
        {
          "type": "compare",
          "left": {
            "caption": "数组",
            "block": {
              "type": "list",
              "items": [
                {
                  "text": "连续内存存储，支持 `O(1)` 随机访问"
                },
                {
                  "text": "插入/删除需移动元素，最坏 `O(n)`"
                },
                {
                  "text": "示例：`int arr[5] = {1, 3, 5, 7, 9}`"
                }
              ]
            }
          },
          "right": {
            "caption": "链表",
            "block": {
              "type": "list",
              "items": [
                {
                  "text": "非连续节点通过指针链接，访问需遍历"
                },
                {
                  "text": "插入/删除仅修改指针，`O(1)` 完成"
                },
                {
                  "text": "示例：`struct Node { int data; Node* next; }`"
                }
              ]
            }
          },
          "id": "b3"
        },
        {
          "type": "sim",
          "engine": "widget",
          "caption": "调整数组容量观察扩容时机",
          "html": "<style>#cv { width:100%; height:200px; border:1px solid var(--line); } .controls { display:flex; gap:1em; margin-top:0.5em; }</style><div class='controls'><button id='add'>添加元素</button><span>容量: <span id='cap'>4</span></span></div><canvas id='cv'></canvas><script>const cv = document.getElementById('cv');const ctx = cv.getContext('2d');let size = 0;let capacity = 4;const colors = {bg: getComputedStyle(document.documentElement).getPropertyValue('--bg'),accent: getComputedStyle(document.documentElement).getPropertyValue('--accent'),ink: getComputedStyle(document.documentElement).getPropertyValue('--ink')};function drawArray() {ctx.clearRect(0, 0, cv.width, cv.height);const w = cv.width / capacity;for (let i = 0; i < capacity; i++) {ctx.strokeStyle = colors.ink;ctx.strokeRect(i * w, 10, w, 30);if (i < size) {ctx.fillStyle = colors.accent;ctx.fillRect(i * w + 1, 11, w - 2, 28);}}document.getElementById('cap').textContent = capacity;}function resizeCanvas() {cv.width = cv.clientWidth;cv.height = cv.clientHeight;drawArray();}window.addEventListener('resize', resizeCanvas);document.getElementById('add').addEventListener('click', () => {if (size === capacity) {capacity *= 2;drawArray();}size++;drawArray();});resizeCanvas();</script>",
          "id": "b4"
        }
