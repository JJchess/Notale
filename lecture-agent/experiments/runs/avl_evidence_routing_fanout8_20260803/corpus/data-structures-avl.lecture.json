      "notes": "引导学生注意树高的增长，对比平衡树。",
      "blocks": [
        {
          "type": "hero",
          "title": [
            "二叉搜索树的退化",
            "有序插入的后果"
          ],
          "tag": "BST",
          "sub": "点击按钮逐步插入节点，观察树如何退化为链表",
          "facts": "最坏情况下树高等于节点数，查找需遍历所有节点。",
          "hint": "如何避免退化？AVL 树通过旋转保持平衡。",
          "id": "b2_1"
        },
        {
          "type": "sim",
          "engine": "widget",
          "html": "<style>\n  #root {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    height: 100%;\n    min-width: 0;\n    min-height: 0;\n    background: var(--bg, #1a1a2e);\n    color: var(--ink, #e0e0e0);\n    font-family: var(--font-sans, system-ui, sans-serif);\n    --bg: #1a1a2e;\n    --ink: #e0e0e0;\n    --accent: #00d4ff;\n    --line: #ff6b6b;\n    --bg2: #2a2a3e;\n    --text2: #a0a0a0;\n    --font-sans: system-ui, sans-serif;\n    --font-mono: monospace;\n  }\n  #treeSvg {\n    flex: 1;\n    width: 100%;\n    height: 100%;\n    max-width: 800px;\n    display: block;\n  }\n  .controls {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 8px 16px;\n    border-top: 1px solid var(--line, #ff6b6b);\n    flex-shrink: 0;\n  }\n  #insertBtn {\n    padding: 6px 16px;\n    border: 1px solid var(--line, #ff6b6b);\n    border-radius: 6px;\n    background: var(--bg2, #2a2a3e);\n    color: var(--ink, #e0e0e0);\n    cursor: pointer;\n    font-size: 14px;\n    transition: background .15s, transform .1s;\n    font-family: var(--font-sans, system-ui, sans-serif);\n  }\n  #insertBtn:hover { filter: brightness(1.15); }\n  #insertBtn:active { transform: scale(.97); }\n  #insertBtn:disabled { opacity: .5; cursor: default; filter: none; transform: none; }\n  .readout {\n    font-family: var(--font-mono, monospace);\n    font-variant-numeric: tabular-nums;\n    font-size: 13px;\n    color: var(--text2, #a0a0a0);\n  }\n</style>\n<div id=\"root\">\n  <svg id=\"treeSvg\" viewBox=\"0 0 800 600\" preserveAspectRatio=\"xMidYMid meet\"></svg>\n  <div class=\"controls\">\n    <button id=\"insertBtn\">插入节点</button>\n    <span class=\"readout\">已插入: <span id=\"insertedCount\">0</span></span>\n    <span class=\"readout\">高度: <span id=\"heightDisplay\">0</span></span>\n  </div>\n</div>\n<script>\n  (function() {\n    var step = 0;\n    var svg = document.getElementById('treeSvg');\n    var insertBtn = document.getElementById('insertBtn');\n    var insertedCount = document.getElementById('insertedCount');\n    var heightDisplay = document.getElementById('heightDisplay');\n\n    function getTreeData(s) {\n      if (s === 0) return { nodes: [], edges: [] };\n      var nodes = [];\n      var edges = [];\n      for (var i = 1; i <= s; i++) {\n        var x = 400;\n        var y = 100 + (i - 1) * 80;\n        nodes.push({ value: i, x: x, y: y, isNew: i === s });\n        if (i > 1) {\n          edges.push({ from: i - 1, to: i });\n        }\n      }\n      return { nodes: nodes, edges: edges };\n    }\n\n    console.assert(getTreeData(0).nodes.length === 0, 'step=0 should have 0 nodes');\n    console.assert(getTreeData(0).edges.length === 0, 'step=0 should have 0 edges');\n    console.assert(getTreeData(1).nodes.length === 1, 'step=1 should have 1 node');\n    console.assert(getTreeData(1).edges.length === 0, 'step=1 should have 0 edges');\n    console.assert(getTreeData(3).nodes.length === 3, 'step=3 should have 3 nodes');\n    console.assert(getTreeData(3).edges.length === 2, 'step=3 should have 2 edges');\n    console.assert(getTreeData(3).nodes[0].value === 1, 'first node value should be 1');\n    console.assert(getTreeData(3).nodes[2].isNew === true, 'last node should be marked new');\n    console.assert(getTreeData(3).nodes[0].y === 100, 'first node y should be 100');\n    console.assert(getTreeData(3).nodes[1].y === 180, 'second node y should be 180');\n    console.assert(getTreeData(3).nodes[2].y === 260, 'third node y should be 260');\n    console.assert(getTreeData(3).nodes[0].x === 400, 'x should be 400');\n    var data3 = getTreeData(3);\n    console.assert(data3.edges[0].from === 1 && data3.edges[0].to === 2, 'edge 1->2');\n    console.assert(data3.edges[1].from === 2 && data3.edges[1].to === 3, 'edge 2->3');\n\n    function update() {\n      svg.innerHTML = '';\n      var data = getTreeData(step);\n      for (var e = 0; e < data.edges.length; e++) {\n        var edge = data.edges[e];\n        var fromNode = data.nodes[edge.from - 1];\n        var toNode = data.nodes[edge.to - 1];\n        var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n        line.setAttribute('x1', fromNode.x);\n        line.setAttribute('y1', fromNode.y + 25);\n        line.setAttribute('x2', toNode.x);\n        line.setAttribute('y2', toNode.y - 25);\n        line.style.stroke = 'var(--line, #ff6b6b)';\n        line.setAttribute('stroke-width', '2');\n        svg.appendChild(line);\n      }\n      for (var n = 0; n < data.nodes.length; n++) {\n        var node = data.nodes[n];\n        var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n        circle.setAttribute('cx', node.x);\n        circle.setAttribute('cy', node.y);\n        circle.setAttribute('r', 25);\n        circle.style.fill = node.isNew ? 'var(--accent, #00d4ff)' : 'var(--bg2, #2a2a3e)';\n        circle.style.stroke = 'var(--line, #ff6b6b)';\n        circle.setAttribute('stroke-width', '1.5');\n        svg.appendChild(circle);\n        var text = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n        text.setAttribute('x', node.x);\n        text.setAttribute('y', node.y);\n        text.setAttribute('text-anchor', 'middle');\n        text.setAttribute('dominant-baseline', 'central');\n        text.style.fill = node.isNew ? 'var(--bg, #1a1a2e)' : 'var(--ink, #e0e0e0)';\n        text.style.fontSize = '16px';\n        text.style.fontFamily = 'var(--font-mono, monospace)';\n        text.textContent = node.value;\n        svg.appendChild(text);\n      }\n      insertedCount.textContent = step;\n      heightDisplay.textContent = step;\n      insertBtn.disabled = (step >= 5);\n    }\n\n    insertBtn.addEventListener('click', function() {\n      if (step < 5) {\n        step++;\n        update();\n      }\n    });\n\n    update();\n  })();\n</script>",
          "spec": {
            "core_insight": "在二叉搜索树中按递增顺序插入节点会导致树退化为链表，查找性能从O(log n)恶化到O(n)。",
            "render_medium": "svg",
            "render_medium_reason": "树结构由节点和连接线组成，SVG能精确控制每个元素的位置和样式，适合几何图形。",
            "aesthetic_direction": "lab-dark",
            "direction_reason": "深色背景突出节点和连接线，适合算法可视化。",
            "palette": [
