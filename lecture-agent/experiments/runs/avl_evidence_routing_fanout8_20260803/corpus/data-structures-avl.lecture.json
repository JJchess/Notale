            ],
            "signature_detail": "新节点以accent2颜色出现，连接线从父节点绘制到子节点。",
            "layout_pattern": "stage+readout-row",
            "layout_skeleton": "controls wrap row (100%) / stage svg 4:3 (100%) / readout row (2x 1fr)",
            "state_model": [
