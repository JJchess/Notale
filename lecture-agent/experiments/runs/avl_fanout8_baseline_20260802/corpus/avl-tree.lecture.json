  "tutor": {
    "suggestions": [
      "AVL树如何通过旋转保持平衡？",
      "四种旋转（LL、RR、LR、RL）分别对应什么情况？",
      "为什么AVL树的高度严格小于1.44log₂(n+2)？",
      "AVL树和红黑树在实际应用中如何选择？"
    ],
    "kb": [
      {
        "pattern": "平衡因子|BF|平衡系数",
        "answer": "平衡因子 = 左子树高度 - 右子树高度，AVL树要求所有节点的平衡因子绝对值不超过1。"
      },
      {
        "pattern": "LL旋转|右单旋|LL",
        "answer": "LL旋转（右单旋）用于解决在失衡节点的左子树的左孩子上插入导致的不平衡。"
      },
      {
        "pattern": "RR旋转|左单旋|RR",
        "answer": "RR旋转（左单旋）用于解决在失衡节点的右子树的右孩子上插入导致的不平衡。"
      },
      {
        "pattern": "LR旋转|左右双旋|LR",
        "answer": "LR旋转（左右双旋）用于解决在失衡节点的左子树的右孩子上插入导致的不平衡，先左旋后右旋。"
      },
      {
        "pattern": "RL旋转|右左双旋|RL",
        "answer": "RL旋转（右左双旋）用于解决在失衡节点的右子树的左孩子上插入导致的不平衡，先右旋后左旋。"
      },
      {
        "pattern": "插入调整|插入后平衡",
        "answer": "插入新节点后，从插入点向上回溯，更新高度，检查平衡因子，若失衡则进行相应旋转，最多一次旋转即可恢复平衡。"
      },
      {
        "pattern": "删除调整|删除后平衡",
        "answer": "删除节点后，从删除点向上回溯，可能需要进行多次旋转才能恢复平衡，但总次数为O(log n)。"
      }
    ]
  },
