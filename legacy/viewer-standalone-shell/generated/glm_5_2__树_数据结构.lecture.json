          "html": "<style>\n  .widget {\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    background: var(--bg);\n    color: var(--ink);\n    font-family: var(--sans);\n    padding: 16px;\n    box-sizing: border-box;\n    gap: 12px;\n  }\n  .controls {\n    display: flex;\n    gap: 8px;\n    align-items: center;\n    flex-wrap: wrap;\n  }\n  .trav-group {\n    display: flex;\n    gap: 2px;\n    background: var(--bg2);\n    padding: 3px;\n    border-radius: var(--radius);\n    border: 1px solid var(--line);\n  }\n  .trav-btn {\n    padding: 7px 16px;\n    font-size: 13px;\n    background: transparent;\n    border: none;\n    color: var(--text2);\n    cursor: pointer;\n    border-radius: calc(var(--radius) - 3px);\n    transition: all 120ms linear;\n    font-family: var(--sans);\n  }\n  .trav-btn:hover { color: var(--ink); }\n  .trav-btn.active {\n    background: var(--accent);\n    color: var(--bg);\n  }\n  .spacer { flex: 1; }\n  .ctrl-btn {\n    padding: 7px 14px;\n    font-size: 12px;\n    background: var(--card);\n    border: 1px solid var(--line);\n    color: var(--ink);\n    cursor: pointer;\n    border-radius: var(--radius);\n    transition: all 120ms linear;\n    font-family: var(--mono);\n    letter-spacing: 0.05em;\n  }\n  .ctrl-btn:hover {\n    border-color: var(--accent);\n    color: var(--accent);\n  }\n  .ctrl-btn:active { transform: translateY(1px); }\n  .stage {\n    flex: 1;\n    position: relative;\n    background: var(--bg2);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    overflow: hidden;\n    min-height: 0;\n  }\n  .stage svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n  }\n  .readout {\n    position: absolute;\n    top: 10px;\n    left: 14px;\n    font-family: var(--mono);\n    font-size: 11px;\n    color: var(--text2);\n    letter-spacing: 0.06em;\n    z-index: 2;\n    pointer-events: none;\n  }\n  .readout .hl { color: var(--accent); }\n  .readout .sep { opacity: 0.4; margin: 0 6px; }\n  .seq-bar {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 10px 14px;\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    min-height: 48px;\n  }\n  .seq-label {\n    font-family: var(--mono);\n    font-size: 10px;\n    color: var(--text2);\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n  .seq-items {\n    display: flex;\n    gap: 6px;\n    flex: 1;\n    align-items: center;\n    flex-wrap: wrap;\n    min-height: 28px;\n  }\n  .seq-item {\n    font-family: var(--mono);\n    font-size: 14px;\n    font-weight: 600;\n    padding: 3px 10px;\n    border-radius: 4px;\n    background: var(--bg2);\n    color: var(--ink);\n    border: 1px solid var(--line);\n    animation: pop 220ms cubic-bezier(.22,1,.36,1);\n    font-variant-numeric: tabular-nums;\n  }\n  .seq-item.root {\n    color: var(--accent);\n    border-color: var(--accent);\n  }\n  @keyframes pop {\n    from { transform: scale(0.5); opacity: 0; }\n    to { transform: scale(1); opacity: 1; }\n  }\n  .seq-empty {\n    font-family: var(--mono);\n    font-size: 12px;\n    color: var(--text2);\n    opacity: 0.4;\n  }\n  .node-label {\n    font-family: var(--mono);\n    font-size: 17px;\n    font-weight: 600;\n    text-anchor: middle;\n    dominant-baseline: central;\n    pointer-events: none;\n    transition: fill 250ms ease;\n  }\n  .node-idx {\n    font-family: var(--mono);\n    font-size: 10px;\n    font-weight: 700;\n    text-anchor: middle;\n    dominant-baseline: central;\n    pointer-events: none;\n  }\n  .edge {\n    stroke: var(--line);\n    stroke-width: 1.5;\n    fill: none;\n  }\n  .node-circle {\n    transition: fill 250ms ease, stroke 250ms ease, stroke-width 250ms ease, filter 250ms ease;\n  }\n  .node-circle.current {\n    filter: drop-shadow(0 0 7px var(--accent));\n  }\n  .pulse-ring {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: pulseRing 1.1s ease-in-out infinite;\n  }\n  @keyframes pulseRing {\n    0%, 100% { opacity: 0.55; transform: scale(1); }\n    50% { opacity: 0.1; transform: scale(1.5); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .pulse-ring { animation: none; opacity: 0.3; }\n    .seq-item { animation: none; }\n    .node-circle { transition: none; }\n  }\n</style>\n<div class=\"widget\">\n  <div class=\"controls\">\n    <div class=\"trav-group\">\n      <button class=\"trav-btn active\" data-traversal=\"pre\">前序</button>\n      <button class=\"trav-btn\" data-traversal=\"in\">中序</button>\n      <button class=\"trav-btn\" data-traversal=\"post\">后序</button>\n      <button class=\"trav-btn\" data-traversal=\"level\">层序</button>\n    </div>\n    <div class=\"spacer\"></div>\n    <button class=\"ctrl-btn\" id=\"play-pause\">播放</button>\n    <button class=\"ctrl-btn\" id=\"reset\">重置</button>\n  </div>\n  <div class=\"stage\">\n    <div class=\"readout\" id=\"readout\"></div>\n    <svg id=\"tree\" viewBox=\"0 0 680 310\" preserveAspectRatio=\"xMidYMid meet\">\n      <g id=\"edges\"></g>\n      <g id=\"nodes\"></g>\n      <g id=\"ticks\"></g>\n    </svg>\n  </div>\n  <div class=\"seq-bar\">\n    <span class=\"seq-label\">访问序列</span>\n    <div class=\"seq-items\" id=\"seq-items\"></div>\n  </div>\n</div>\n<script>\n  const state = {\n    traversalType: 'pre',\n    step: 1,\n    isPlaying: false\n  };\n\n  const sequences = {\n    pre:   ['A','B','D','E','C','F','G'],\n    in:    ['D','B','E','A','F','C','G'],\n    post:  ['D','E','B','F','G','C','A'],\n    level: ['A','B','C','D','E','F','G']\n  };\n\n  const labels = { pre: '前序', in: '中序', post: '后序', level: '层序' };\n  const rootPos = { pre: 1, in: 4, post: 7, level: 1 };\n\n  const nodes = {\n    A: { x: 340, y: 50 },\n    B: { x: 210, y: 135 },\n    C: { x: 470, y: 135 },\n    D: { x: 140, y: 225 },\n    E: { x: 280, y: 225 },\n    F: { x: 400, y: 225 },\n    G: { x: 540, y: 225 }\n  };\n\n  const edges = [['A','B'],['A','C'],['B','D'],['B','E'],['C','F'],['C','G']];\n  const circled = ['①','②','③','④','⑤','⑥','⑦'];\n  const R = 22;\n  const svgNS = 'http://www.w3.org/2000/svg';\n\n  let timer = null;\n  let seqDirty = true;\n\n  function initSVG() {\n    const edgesG = document.getElementById('edges');\n    const nodesG = document.getElementById('nodes');\n    const ticksG = document.getElementById('ticks');\n\n    edges.forEach(function(e){\n      const line = document.createElementNS(svgNS, 'line');\n      line.setAttribute('x1', nodes[e[0]].x);\n      line.setAttribute('y1', nodes[e[0]].y);\n      line.setAttribute('x2', nodes[e[1]].x);\n      line.setAttribute('y2', nodes[e[1]].y);\n      line.setAttribute('class', 'edge');\n      edgesG.appendChild(line);\n    });\n\n    Object.keys(nodes).forEach(function(id){\n      const n = nodes[id];\n      const g = document.createElementNS(svgNS, 'g');\n      g.setAttribute('id', 'g-' + id);\n\n      const ring = document.createElementNS(svgNS, 'circle');\n      ring.setAttribute('cx', n.x);\n      ring.setAttribute('cy', n.y);\n      ring.setAttribute('r', R + 3);\n      ring.setAttribute('fill', 'none');\n      ring.setAttribute('stroke', 'var(--accent)');\n      ring.setAttribute('stroke-width', '2');\n      ring.setAttribute('id', 'ring-' + id);\n      ring.style.opacity = '0';\n      g.appendChild(ring);\n\n      const circle = document.createElementNS(svgNS, 'circle');\n      circle.setAttribute('cx', n.x);\n      circle.setAttribute('cy', n.y);\n      circle.setAttribute('r', R);\n      circle.setAttribute('class', 'node-circle');\n      circle.setAttribute('id', 'circle-' + id);\n      g.appendChild(circle);\n\n      const text = document.createElementNS(svgNS, 'text');\n      text.setAttribute('x', n.x);\n      text.setAttribute('y', n.y);\n      text.setAttribute('class', 'node-label');\n      text.setAttribute('id', 'label-' + id);\n      text.textContent = id;\n      g.appendChild(text);\n\n      const idxBg = document.createElementNS(svgNS, 'circle');\n      idxBg.setAttribute('cx', n.x + R - 1);\n      idxBg.setAttribute('cy', n.y - R + 1);\n      idxBg.setAttribute('r', 9);\n      idxBg.setAttribute('id', 'idxbg-' + id);\n      idxBg.style.opacity = '0';\n      g.appendChild(idxBg);\n\n      const idxText = document.createElementNS(svgNS, 'text');\n      idxText.setAttribute('x', n.x + R - 1);\n      idxText.setAttribute('y', n.y - R + 1);\n      idxText.setAttribute('class', 'node-idx');\n      idxText.setAttribute('id', 'idx-' + id);\n      idxText.style.opacity = '0';\n      g.appendChild(idxText);\n\n      nodesG.appendChild(g);\n    });\n\n    for (let i = 0; i <= 34; i++) {\n      const x = i * 20;\n      const tick = document.createElementNS(svgNS, 'line');\n      tick.setAttribute('x1', x);\n      tick.setAttribute('y1', 295);\n      tick.setAttribute('x2', x);\n      tick.setAttribute('y2', 295 + (i % 5 === 0 ? 10 : 5));\n      tick.setAttribute('stroke', 'var(--line)');\n      tick.setAttribute('stroke-width', '1');\n      tick.setAttribute('opacity', i % 5 === 0 ? '0.55' : '0.25');\n      ticksG.appendChild(tick);\n    }\n  }\n\n  function update() {\n    const seq = sequences[state.traversalType];\n    const visited = seq.slice(0, state.step);\n    const currentId = state.step > 0 ? seq[state.step - 1] : null;\n\n    document.querySelectorAll('[data-traversal]').forEach(function(btn){\n      btn.classList.toggle('active', btn.dataset.traversal === state.traversalType);\n    });\n\n    const rootIdx = rootPos[state.traversalType];\n    document.getElementById('readout').innerHTML =\n      '<span class=\"hl\">' + labels[state.traversalType] + '</span>' +\n      '<span class=\"sep\">·</span>步 ' + state.step + '/7' +\n      '<span class=\"sep\">·</span>根A @ 第' + rootIdx + '位';\n\n    document.getElementById('play-pause').textContent = state.isPlaying ? '暂停' : '播放';\n\n    Object.keys(nodes).forEach(function(id){\n      const circle = document.getElementById('circle-' + id);\n      const label = document.getElementById('label-' + id);\n      const ring = document.getElementById('ring-' + id);\n      const idxBg = document.getElementById('idxbg-' + id);\n      const idxText = document.getElementById('idx-' + id);\n      const isRoot = id === 'A';\n      const visIdx = visited.indexOf(id);\n      const isCurrent = id === currentId;\n\n      circle.classList.toggle('current', isCurrent);\n\n      if (isCurrent) {\n        circle.setAttribute('fill', 'var(--accent)');\n        circle.setAttribute('stroke', 'var(--accent)');\n        circle.setAttribute('stroke-width', '2.5');\n        label.setAttribute('fill', 'var(--bg)');\n        ring.style.opacity = '1';\n        ring.classList.add('pulse-ring');\n        idxText.textContent = circled[visIdx];\n        idxText.setAttribute('fill', 'var(--accent)');\n        idxBg.setAttribute('fill', 'var(--bg)');\n        idxBg.setAttribute('stroke', 'var(--accent)');\n        idxBg.setAttribute('stroke-width', '1.5');\n        idxBg.style.opacity = '1';\n        idxText.style.opacity = '1';\n      } else if (visIdx >= 0) {\n        circle.setAttribute('fill', 'var(--card)');\n        circle.setAttribute('stroke', isRoot ? 'var(--accent)' : 'var(--ink)');\n        circle.setAttribute('stroke-width', isRoot ? '2.5' : '2');\n        label.setAttribute('fill', 'var(--ink)');\n        ring.style.opacity = '0';\n        ring.classList.remove('pulse-ring');\n        idxText.textContent = circled[visIdx];\n        idxText.setAttribute('fill', 'var(--bg)');\n        idxBg.setAttribute('fill', 'var(--accent)');\n        idxBg.setAttribute('stroke', 'none');\n        idxBg.style.opacity = '1';\n        idxText.style.opacity = '1';\n      } else {\n        circle.setAttribute('fill', 'var(--bg2)');\n        circle.setAttribute('stroke', isRoot ? 'var(--accent)' : 'var(--line)');\n        circle.setAttribute('stroke-width', '1.5');\n        label.setAttribute('fill', 'var(--text2)');\n        ring.style.opacity = '0';\n        ring.classList.remove('pulse-ring');\n        idxBg.style.opacity = '0';\n        idxText.style.opacity = '0';\n      }\n    });\n\n    const seqItems = document.getElementById('seq-items');\n    if (seqDirty) {\n      seqItems.innerHTML = '';\n      if (visited.length === 0) {\n        const empty = document.createElement('span');\n        empty.className = 'seq-empty';\n        empty.textContent = '—';\n        seqItems.appendChild(empty);\n      } else {\n        visited.forEach(function(id){\n          const isRoot = id === 'A';\n          const span = document.createElement('span');\n          span.className = 'seq-item' + (isRoot ? ' root' : '');\n          span.textContent = id;\n          seqItems.appendChild(span);\n        });\n      }\n      seqDirty = false;\n    } else {\n      const empty = seqItems.querySelector('.seq-empty');\n      if (empty) empty.remove();\n      const existing = seqItems.querySelectorAll('.seq-item').length;\n      if (visited.length > existing) {\n        for (let i = existing; i < visited.length; i++) {\n          const id = visited[i];\n          const isRoot = id === 'A';\n          const span = document.createElement('span');\n          span.className = 'seq-item' + (isRoot ? ' root' : '');\n          span.textContent = id;\n          seqItems.appendChild(span);\n        }\n      } else if (visited.length < existing) {\n        const items = seqItems.querySelectorAll('.seq-item');\n        for (let i = visited.length; i < items.length; i++) {\n          items[i].remove();\n        }\n      }\n    }\n  }\n\n  function startTimer() {\n    stopTimer();\n    timer = setInterval(function(){\n      if (state.step >= 7) {\n        stopTimer();\n        state.isPlaying = false;\n        update();\n        return;\n      }\n      state.step++;\n      update();\n    }, 800);\n  }\n\n  function stopTimer() {\n    if (timer) { clearInterval(timer); timer = null; }\n  }\n\n  document.querySelectorAll('[data-traversal]').forEach(function(btn){\n    btn.addEventListener('click', function(){\n      state.traversalType = btn.dataset.traversal;\n      state.step = 0;\n      state.isPlaying = true;\n      seqDirty = true;\n      startTimer();\n      update();\n    });\n  });\n\n  document.getElementById('play-pause').addEventListener('click', function(){\n    if (!state.isPlaying && state.step >= 7) {\n      state.step = 0;\n      seqDirty = true;\n    }\n    state.isPlaying = !state.isPlaying;\n    if (state.isPlaying) startTimer();\n    else stopTimer();\n    update();\n  });\n\n  document.getElementById('reset').addEventListener('click', function(){\n    state.step = 0;\n    state.isPlaying = false;\n    seqDirty = true;\n    stopTimer();\n    update();\n  });\n\n  initSVG();\n  update();\n</script>",
          "id": "b_traversal_sim"
        },
        {
          "type": "list",
          "items": [
            {
              "lead": "前序",
              "text": "根→左→右。对 BST `4(2(1,3),6(5,7))` 得 `4,2,1,3,6,5,7`。根最先访问，故用于**序列化**与**深拷贝**——读到根即可重建结构。",
              "fragment": "fade-up",
              "icon": "layers"
            },
            {
              "lead": "中序",
              "text": "左→根→右。同一棵树得 `1,2,3,4,5,6,7`。BST 的中序即**升序输出**，这是\"中序=排序\"的来源。",
              "fragment": "fade-up",
              "icon": "printer"
            },
            {
              "lead": "后序",
              "text": "左→右→根。得 `1,3,2,5,7,6,4`。子树全部处理完才轮到根，故适合**释放资源**（先 `free` 子节点再 `free` 父）与**子树聚合**（如统计目录大小）。",
              "fragment": "fade-up",
              "icon": "bar-chart-3"
            },
            {
              "lead": "层序",
              "text": "按深度逐层、同层从左到右，用队列实现。得 `4,2,6,1,3,5,7`。等价 BFS，用于**无权最短路径**，如求二叉树的最小深度。",
              "fragment": "fade-up",
              "icon": "users"
            }
          ],
          "id": "b_traversal_list"
        }
      ]
    },
    {
      "id": "storage-representation",
      "kind": "content",
      "eyebrow": "物理存储",
      "headline": "同一棵树，四种存法",
      "lead": "树的逻辑结构是层级，但内存是线性的——不同的映射方式各有取舍。",
      "notes": "四种表示法的工程动机：双亲表示法（每个节点存父指针）→找父 O(1) 找子 O(N)，适合并查集；孩子链表→找子 O(度数) 找父 O(N)，适合文件系统；左孩子右兄弟→用二叉链表表示多叉树，空间 O(N) 且能统一处理任意度数，是通用方案；数组存储→只适合完全二叉树（如堆），下标 i 的左孩子 2i+1 右孩子 2i+2，内存连续缓存友好但浪费空间存非完全树。重点讲清楚：为什么堆用数组而不用链表——缓存局部性 + 无指针开销 + 下标计算 O(1)。",
      "blocks": [
        {
          "type": "table",
          "head": [
            "存储方式",
            "空间",
            "找父",
            "找子",
            "适用场景"
          ],
          "rows": [
            [
              "双亲表示法",
              "O(n)：`(data,parent)` 数组",
              "O(1)：读 `parent`，如 D→1→B",
              "O(n)：扫全表找谁的父亲是自己",
              "并查集、频繁查父"
            ],
            [
              "孩子链表",
              "O(n+e)：节点+孩子单链表",
              "O(n)（无父指针时）",
              "O(度数)：遍历该节点链表",
              "DFS、向下遍历子树"
            ],
            [
              "左孩子右兄弟",
              "O(n)：`firstChild`+`nextSibling` 两指针",
              "O(n)：需回溯",
              "O(1)：读 `firstChild`",
              "通用树↔二叉树、森林"
            ],
            [
              "数组存储",
              "O(n)：下标 1..n 连续",
              "O(1)：$i \\to \\lfloor i/2 \\rfloor$",
              "O(1)：$i \\to 2i,\\,2i{+}1$",
              {
                "text": "仅完全二叉树、堆、线段树",
                "hi": true
              }
            ]
          ],
          "id": "b_storage_table"
        },
        {
          "type": "callout",
          "label": "数组存堆",
          "text": "下标 `i` 的左孩子是 `2i+1`、右孩子是 `2i+2`，连续内存让 CPU 缓存行一次命中多个节点且零指针开销——代价是只对完全二叉树成立，普通树会留下大量空洞。",
          "id": "b_heap_array_callout"
        }
      ],
      "layout": {
        "kind": "split",
        "anchor": [
          "b_heap_array_callout"
        ],
        "ratio": 0.4
      }
    },
    {
      "id": "degradation-balancing",
      "kind": "content",
      "eyebrow": "退化灾难",
      "headline": "当树退化成链表：O(logN) 的崩塌",
      "lead": "按顺序插入 1,2,3,…,N 到 BST，你会得到一根棍子——这就是平衡树存在的全部理由。",
      "notes": "这是全课的工程核心页。具象锚点：向 BST 依次插入 1,2,3,4,5，每个新节点都变成右孩子的右孩子，树退化成右斜链表。查找从 O(logN) 变成 O(N)。chart 展示 N=10/100/1000/10000 时平衡树 vs 退化树的查找次数对比。引出平衡机制：AVL（严格平衡，增删旋转多）、红黑树（近似平衡，增删旋转少，工程首选）。C++ map、Java TreeMap、Linux CFS 调度器都用红黑树。",
      "blocks": [
        {
          "type": "chart",
          "chartType": "line",
          "categories": [
            "10",
            "100",
            "1000",
            "10000"
          ],
          "series": [
            {
              "name": "平衡二叉树 O(logN)",
              "values": [
                4,
                7,
                10,
                14
              ]
            },
            {
              "name": "退化树 O(N)",
              "values": [
                10,
                100,
                1000,
                10000
              ]
            }
          ],
          "xLabel": "N（数据规模）",
          "yLabel": "最坏查找次数",
          "caption": "N=10000 时，平衡树最多比较 14 次，退化树要比较 10000 次——相差逾 700 倍。",
          "id": "b_degradation_chart"
        },
        {
          "type": "callout",
          "label": "工程取舍",
          "text": "AVL 严格平衡（高度差 $\\leq 1$）查找最快但增删旋转频繁；红黑树近似平衡、旋转更少，成为 C++ `map`、Java `TreeMap`、Linux CFS 的工程首选。",
          "id": "b_balancing_callout"
        }
      ],
      "layout": {
        "kind": "split",
        "anchor": [
          "b_balancing_callout"
        ],
        "ratio": 0.4
      }
    },
    {
      "id": "engineering-tree-selection",
      "kind": "content",
      "eyebrow": "工程选型",
      "headline": "BST·AVL·红黑树·B树·Trie：为什么不止一种树",
      "lead": "没有最好的树，只有最匹配场景的树——选型取决于数据特征、操作频率和运行环境。",
      "notes": "上一页我们看到未平衡的BST会退化成链表，这页正是要解答“为什么工程界发明了这么多树结构”——核心在于约束条件与应用场景的权衡。同学们常误以为红黑树绝对优于AVL树，实际上AVL树更严格平衡适合查多写少的场景，而红黑树在频繁增删时旋转开销更小（如Java的TreeMap），B树则是为减少磁盘IO量身定制，Trie则是牺牲空间换取字符串前缀匹配的极致效率。理清了这些设计动机背后的取舍，大家就可以带着对“时空权衡”的理解，去迎接下一页的随堂检验了。",
      "blocks": [
        {
          "type": "table",
          "head": [
