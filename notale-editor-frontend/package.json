{
  "name": "@notale/editor-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:scripts && next build --webpack",
    "start": "npm run build:scripts && NODE_ENV=production node .local/tooling/scripts/serve.js",
    "dev": "npm run build:scripts && NODE_ENV=development node .local/tooling/scripts/serve.js",
    "test:browser": "playwright test",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "templates:prepare": "npm run build:scripts && node .local/tooling/scripts/templates/prepare-original.js",
    "diagrams:prepare": "npm run templates:prepare",
    "audit:lecture": "npm run build:scripts && node .local/tooling/scripts/audit-lecture-preview.js",
    "experience:create": "npm run build:scripts && node .local/tooling/scripts/create-experience.js",
    "typecheck:files": "npm run build:scripts --silent && node .local/tooling/scripts/typecheck-files.js",
    "contract:update": "npm run build:scripts && node .local/tooling/scripts/update-editor-contract.js",
    "start:local": "npm run build:scripts && node .local/tooling/scripts/start-local.js",
    "licenses:inventory": "npm run build:scripts && node .local/tooling/scripts/audit-dependency-licenses.js",
    "licenses:collect": "npm run licenses:inventory && node .local/tooling/scripts/collect-third-party-notices.js",
    "release:inventory": "npm run build:scripts && node .local/tooling/scripts/release-inventory.js",
    "release:stage": "npm run release:inventory && node .local/tooling/scripts/stage-source-release.js",
    "licenses:runtime": "npm run build:scripts && node .local/tooling/scripts/audit-runtime-dependencies.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@notale/editor": "file:vendor/notale-editor-1.0.0-203c7d64aaff4a6f.tgz",
    "@revolist/revogrid": "4.27.10",
    "@stencil/core": "4.44.2",
    "drauu": "1.0.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reveal.js": "5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide": "^1.43.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
