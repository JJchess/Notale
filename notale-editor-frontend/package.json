{
  "name": "@notale/editor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:scripts && node .local/tooling/scripts/build.js",
    "start": "npm run build:scripts && node .local/tooling/scripts/serve.js",
    "dev": "npm run build && npm start",
    "test:browser": "playwright test",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "templates:prepare": "npm run build:scripts && node .local/tooling/scripts/templates/prepare.js",
    "diagrams:prepare": "npm run build:scripts && node .local/tooling/scripts/templates/prepare-diagrams.js",
    "audit:lecture": "npm run build:scripts && node .local/tooling/scripts/audit-lecture-preview.js",
    "experience:create": "npm run build:scripts && node .local/tooling/scripts/create-experience.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@notale/editor": "file:vendor/notale-editor-0.1.0.tgz",
    "@revolist/revogrid": "4.27.10",
    "@stencil/core": "4.44.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "esbuild": "0.25.9",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide": "^1.43.0",
    "typescript": "5.9.3"
  }
}
