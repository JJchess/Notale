{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../../notale-format/node_modules/@types"
    ],
    "rootDir": "../../..",
    "outDir": "../../../.local/motale-film/check",
    "paths": {
      "@notale/format/film": [
        "../../../notale-format/src/film.ts"
      ],
      "@notale/editor/film": [
        "../../../notale-editor/src/film/index.ts"
      ],
      "@notale/editor/browser": [
        "../../../notale-editor/src/browser-api.ts"
      ]
    }
  },
  "include": [
    "../../../notale-format/src/film.ts",
    "../../../notale-editor-frontend/src/film/**/*.ts",
    "../../../notale-editor/src/film/**/*.ts",
    "../../../notale-editor/tests/film/**/*.ts"
  ]
}
