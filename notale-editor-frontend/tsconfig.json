{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": false,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.tsx",
    "next.config.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next-candidate/types/**/*.ts",
    ".next-candidate/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-save-candidate/types/**/*.ts",
    ".next-save-candidate/dev/types/**/*.ts",
    ".next-animation-candidate/types/**/*.ts",
    ".next-animation-candidate/dev/types/**/*.ts",
    ".next-objects-candidate/types/**/*.ts",
    ".next-objects-candidate/dev/types/**/*.ts",
    ".next-objects-release/types/**/*.ts",
    ".next-objects-release/dev/types/**/*.ts",
    ".next-save-validation/types/**/*.ts",
    ".next-save-validation/dev/types/**/*.ts",
    ".next-selection-fix/types/**/*.ts",
    ".next-selection-fix/dev/types/**/*.ts",
    ".next-style-sidebar/types/**/*.ts",
    ".next-style-sidebar/dev/types/**/*.ts",
    ".next-author-kernel/types/**/*.ts",
    ".next-author-kernel/dev/types/**/*.ts",
    ".next-author-kernel-final/types/**/*.ts",
    ".next-author-kernel-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".local"
  ]
}
