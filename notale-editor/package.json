{
  "name": "@notale/editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser-api.d.ts",
      "import": "./dist/browser-api.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "compose.yaml"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "import:slides": "tsx scripts/import-slides.ts",
    "test:package": "bash scripts/verify-package.sh",
    "test:restore": "tsx scripts/verify-restore.ts",
    "build:ensure": "node scripts/build-cache.mjs",
    "test:smoke": "playwright test --grep \"real Canvas slide:|native steps and real SVG|a lost successful save response survives reload|presentation overview, speaker notes\"",
    "verify:quick": "node scripts/verify-quick.mjs"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "echarts": "6.0.0",
    "fastify": "5.12.3",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "mime-types": "3.0.1",
    "moveable": "^0.53.0",
    "paper": "0.12.18",
    "parse5": "7.3.0",
    "pathkit-wasm": "1.0.0",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3",
    "reveal.js": "5.2.1",
    "svgpath": "2.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/mime-types": "3.0.1",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.9",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
