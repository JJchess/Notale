{
  "name": "@notale/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "notale": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && node dist/cli/build-browser.js",
    "start": "node dist/cli/main.js serve",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "verify:quick": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@vscode/codicons": "0.0.46-24",
    "basic-ftp": "6.2.1",
    "fastify": "5.12.3",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "htmlparser2": "10.0.0",
    "ipaddr.js": "2.2.0",
    "monaco-editor": "0.55.1",
    "parse5": "7.3.0",
    "playwright": "1.55.1",
    "postcss": "8.5.28",
    "pyodide": "314.0.6",
    "sharp": "0.34.3",
    "subset-font": "2.7.0",
    "undici": "6.28.1",
    "yaml": "^2.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "22.18.6",
    "esbuild": "0.25.9",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  }
}
