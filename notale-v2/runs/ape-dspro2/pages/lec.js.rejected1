(function () {
  'use strict';

  // ========== 1. 常量 ==========
  var K = {
    // 物理常数
    G: 6.67430e-11,          // 万有引力常数，单位 N·m^2/kg^2
    c: 299792458,            // 真空中光速，单位 m/s

    // 天体 – 地球
    earth: {
      radius: 6371e3,        // 平均半径，单位 m
      mass: 5.972e24,        // 质量，单位 kg
      g: 9.80665,            // 标准地表重力加速度，单位 m/s^2
      siderealDay: 23.9345 * 3600,  // 恒星日，单位 s
      orbitalPeriod: 365.256 * 86400, // 公转周期，单位 s
      semiMajorAxis: 149.6e9 // 轨道半长轴（日地平均距离），单位 m
    },

    // 天体 – 月球
    moon: {
      radius: 1737.4e3,      // 平均半径，单位 m
      mass: 7.342e22,        // 质量，单位 kg
      g: 1.62,               // 表面重力加速度，单位 m/s^2
      meanDistance: 384400e3 // 地月平均距离，单位 m
    },

    // 天体 – 火星
    mars: {
      radius: 3389.5e3,      // 平均半径，单位 m
      mass: 6.39e23,         // 质量，单位 kg
      g: 3.72076,            // 表面重力加速度，单位 m/s^2
      semiMajorAxis: 227.9e9 // 轨道半长轴（火日平均距离），单位 m
    },

    // 人类参考值
    human: {
      height: 1.7,           // 平均身高，单位 m
      mass: 70,              // 平均质量，单位 kg
      walkSpeed: 1.4,        // 步行速度，单位 m/s
      runSpeed: 6,           // 跑步速度，单位 m/s
      verticalJump: 0.5,     // 垂直起跳高度，单位 m
      throwSpeed: 10         // 投掷初速度，单位 m/s
    },

    // 猿人参考值
    apeman: {
      height: 1.2,           // 平均身高，单位 m
      mass: 50,              // 平均质量，单位 kg
      walkSpeed: 1.0,        // 步行速度，单位 m/s
      runSpeed: 4,           // 跑步速度，单位 m/s
      verticalJump: 0.3,     // 垂直起跳高度，单位 m
      throwSpeed: 8          // 投掷初速度，单位 m/s
    },

    // 单位换算
    AU: 149597870700,        // 天文单位，单位 m
    km: 1000,                // 1 km = 1000 m
    hour: 3600,              // 1 小时 = 3600 s
    day: 86400,              // 1 天 = 86400 s
    year: 31557600           // 1 年 ≈ 365.25 天，单位 s
  };

  // ========== 2. 算法与公式 ==========
  var P = {
    // 重力加速度（距离天体中心距离 r 处）
    gravity: function (mass, r) {
      return (K.G * mass) / (r * r);
    },

    // 天体表面重力加速度
    surfaceGravity: function (mass, radius) {
      return P.gravity(mass, radius);
    },

    // 逃逸速度
    escapeVelocity: function (mass, r) {
      return Math.sqrt((2 * K.G * mass) / r);
    },

    // 圆形轨道速度
    circularOrbitVelocity: function (mass, r) {
      return Math.sqrt((K.G * mass) / r);
    },

    // 自由落体时间（高度 h，重力加速度 g）
    freeFallTime: function (h, g) {
      return Math.sqrt((2 * h) / g);
    },

    // 自由落体末速度
    freeFallSpeed: function (h, g) {
      return Math.sqrt(2 * g * h);
    },

    // 抛体运动最大高度（初速度 v0，重力加速度 g，垂直向上）
    maxHeight: function (v0, g) {
      return (v0 * v0) / (2 * g);
    },

    // 抛体运动飞行时间（垂直向上，落地时间）
    flightTime: function (v0, g) {
      return (2 * v0) / g;
    },

    // 动能
    kineticEnergy: function (mass, velocity) {
      return 0.5 * mass * velocity * velocity;
    },

    // 重力势能（地表近似 mgh；若高精度需用 -GMm/r 的差值）
    potentialEnergy: function (mass, g, h) {
      return mass * g * h;
    },

    // 火箭方程：delta-v = ve * ln(m0/mf)
    deltaV: function (exhaustVelocity, m0, mf) {
      return exhaustVelocity * Math.log(m0 / mf);
    },

    // 火箭方程反算：质量比 m0/mf
    massRatio: function (deltaV, exhaustVelocity) {
      return Math.exp(deltaV / exhaustVelocity);
    },

    // 霍曼转移轨道：从半径为 r1 的圆轨道转移到半径为 r2 的圆轨道所需总速度增量
    // 中心天体质量为 M
    hohmannDeltaV: function (r1, r2, M) {
      var v1 = P.circularOrbitVelocity(M, r1);
      var v2 = P.circularOrbitVelocity(M, r2);
      var a_transfer = (r1 + r2) / 2;
      var v_transfer_peri = Math.sqrt(K.G * M * (2 / r1 - 1 / a_transfer));
      var v_transfer_apo = Math.sqrt(K.G * M * (2 / r2 - 1 / a_transfer));
      var deltaV1 = v_transfer_peri - v1;
      var deltaV2 = v2 - v_transfer_apo;
      return Math.abs(deltaV1) + Math.abs(deltaV2);
    },

    // 光行时间（距离 distance，单位 m）
    lightTravelTime: function (distance) {
      return distance / K.c;
    },

    // 同步轨道半径（中心天体质量 M，自转周期 T）
    synchronousOrbitRadius: function (M, T) {
      return Math.pow((K.G * M * T * T) / (4 * Math.PI * Math.PI), 1 / 3);
    },

    // 比较两个天体的表面重力
    gravityRatio: function (mass1, radius1, mass2, radius2) {
      var g1 = P.surfaceGravity(mass1, radius1);
      var g2 = P.surfaceGravity(mass2, radius2);
      return g1 / g2;
    }
  };

  // ========== 3. 统一挂载入口 ==========
  function mount(cfg) {
    if (!cfg) cfg = {};

    var stage = document.getElementById('stage');
    var main = document.getElementById('main');
    if (!stage || !main) return;

    // 读取页码与总页数（仅用于进度条和翻页，绝不显示）
    var body = document.body;
    var page = parseInt(body.getAttribute('data-page'), 10);
    var total = parseInt(body.getAttribute('data-total'), 10);
    if (isNaN(page) || page < 1) page = null;
    if (isNaN(total) || total < 1) total = null;

    // ---- 页眉 ----
    var header = document.createElement('header');
    header.className = 'lec-header';

    // kicker（如果有 act 就显示 "Act N"）
    if (cfg.act != null) {
      var kicker = document.createElement('div');
      kicker.className = 'lec-header-kicker';
      kicker.textContent = 'Act ' + cfg.act;
      header.appendChild(kicker);
    }

    // 标题区域
    var titles = document.createElement('div');
    titles.className = 'lec-header-titles';

    if (cfg.title) {
      var titleEl = document.createElement('div');
      titleEl.className = 'lec-header-title';
      titleEl.textContent = cfg.title;
      titles.appendChild(titleEl);
    }

    if (cfg.sub) {
      var subEl = document.createElement('div');
      subEl.className = 'lec-header-sub';
      subEl.textContent = cfg.sub;
      titles.appendChild(subEl);
    }

    if (titles.children.length > 0) {
      header.appendChild(titles);
    }

    // 进度条（仅用 data-page / data-total 计算百分比，不显示数字）
    if (page !== null && total !== null) {
      var progressWrap = document.createElement('div');
      progressWrap.className = 'lec-header-progress';
      var progressBar = document.createElement('div');
      progressBar.className = 'lec-progress-bar';
      var pct = (page / total) * 100;
      progressBar.style.width = pct + '%';
      progressWrap.appendChild(progressBar);
      header.appendChild(progressWrap);
    }

    // ---- 页脚 ----
    var footer = document.createElement('footer');
    footer.className = 'lec-footer';

    if (cfg.foot) {
      var take = document.createElement('div');
      take.className = 'lec-footer-take';
      take.textContent = cfg.foot;
      footer.appendChild(take);
    }

    // 插入 DOM
    stage.insertBefore(header, main);
    stage.appendChild(footer);

    // ---- 键盘翻页 ----
    function clickRel(rel) {
      var link = document.querySelector('a[rel="' + rel + '"]');
      if (link) link.click();
    }

    function onKeyDown(e) {
      if (e.defaultPrevented) return;
      // 如果焦点在输入框内，不拦截
      var tag = document.activeElement ? document.activeElement.tagName : '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

      if (e.key === 'ArrowRight' || e.key === 'Right' || e.keyCode === 39) {
        e.preventDefault();
        clickRel('next');
      } else if (e.key === 'ArrowLeft' || e.key === 'Left' || e.keyCode === 37) {
        e.preventDefault();
        clickRel('prev');
      }
    }

    document.addEventListener('keydown', onKeyDown);
  }

  // 挂到全局
  window.Lec = { K: K, P: P, mount: mount };
})();
