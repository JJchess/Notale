(function() {
  var K = {
    // 物理常量
    G: 6.67430e-11,           // 万有引力常数, m^3 kg^-1 s^-2
    g: 9.80665,               // 标准重力加速度, m/s^2
    c: 299792458,             // 真空光速, m/s
    // 天文距离
    AU: 1.495978707e11,       // 天文单位, m
    earthRadius: 6371000,     // 地球平均半径, m
    earthMass: 5.972e24,      // 地球质量, kg
    moonRadius: 1737400,      // 月球平均半径, m
    moonMass: 7.342e22,       // 月球质量, kg
    moonDistance: 3.844e8,    // 地月平均距离, m
    sunMass: 1.989e30,        // 太阳质量, kg
    sunRadius: 6.9634e8,      // 太阳半径, m
    // 人类尺度
    averageHumanHeight: 1.7,  // 平均身高, m
    averageHumanMass: 70,     // 平均体重, kg
    averageStepLength: 0.78,  // 平均步幅, m
    walkingSpeed: 1.4,        // 步行速度, m/s
    runningSpeed: 5.0,        // 跑步速度, m/s
    // 进化时间 (单位: 年, 距今)
    australopithecusStart: 4000000,
    australopithecusEnd: 2000000,
    homoHabilisStart: 2400000,
    homoHabilisEnd: 1600000,
    homoErectusStart: 1800000,
    homoErectusEnd: 100000,
    homoSapiensStart: 300000,
    // 脑容量 (cc)
    brainAustralopithecus: 450,
    brainHomoHabilis: 650,
    brainHomoErectus: 900,
    brainHomoSapiens: 1350,
    brainModernHuman: 1350,
    // 太空探索里程碑 (年份)
    sputnikYear: 1957,
    gagarinYear: 1961,
    apollo11Year: 1969,
    // 阿波罗数据
    apolloMaxSpeed: 11000,     // 阿波罗飞船最大速度, m/s
    saturnVExhaustVelocity: 3000, // 土星5号排气速度, m/s (近似)
    // 宇航服
    spacesuitMass: 100,        // 宇航服质量, kg (近似)
    // 国际空间站
    issAltitude: 408000,       // 轨道高度, m
    issSpeed: 7660,            // 轨道速度, m/s
    // 单位换算因子
    ftToM: 0.3048,
    miToM: 1609.344,
    kgToLb: 2.20462,
    mToFt: 3.28084,
    mToMi: 0.000621371,
    lbToKg: 0.453592
  };

  var P = {
    // 基础运动学
    speed: function(distance, time) {
      return distance / time;
    },
    distance: function(speed, time) {
      return speed * time;
    },
    time: function(distance, speed) {
      return distance / speed;
    },
    // 加速度
    acceleration: function(velocityChange, time) {
      return velocityChange / time;
    },
    finalVelocity: function(initialVelocity, acceleration, time) {
      return initialVelocity + acceleration * time;
    },
    // 动能
    kineticEnergy: function(mass, velocity) {
      return 0.5 * mass * velocity * velocity;
    },
    // 重力势能
    potentialEnergy: function(mass, height, g) {
      return mass * (g || K.g) * height;
    },
    // 自由落体时间
    freeFallTime: function(height, g) {
      return Math.sqrt(2 * height / (g || K.g));
    },
    // 自由落体末速度
    freeFallVelocity: function(height, g) {
      return Math.sqrt(2 * (g || K.g) * height);
    },
    // 逃逸速度
    escapeVelocity: function(mass, radius) {
      return Math.sqrt(2 * K.G * mass / radius);
    },
    // 圆轨道速度
    orbitalVelocity: function(mass, radius) {
      return Math.sqrt(K.G * mass / radius);
    },
    // 齐奥尔科夫斯基火箭方程
    deltaV: function(exhaustVelocity, initialMass, finalMass) {
      return exhaustVelocity * Math.log(initialMass / finalMass);
    },
    // 相对论 - 洛伦兹因子
    lorentzFactor: function(velocity) {
      var vOverC = velocity / K.c;
      return 1 / Math.sqrt(1 - vOverC * vOverC);
    },
    // 相对论时间膨胀 (运动系时间 / 静止系时间)
    timeDilation: function(velocity) {
      return 1 / P.lorentzFactor(velocity);
    },
    // 相对论长度收缩 (收缩因子)
    lengthContraction: function(velocity) {
      return 1 / P.lorentzFactor(velocity);
    },
    // 单位换算
    ftToM: function(ft) {
      return ft * K.ftToM;
    },
    mToFt: function(m) {
      return m * K.mToFt;
    },
    miToKm: function(mi) {
      return mi * K.miToM / 1000;
    },
    kmToMi: function(km) {
      return km * 1000 / K.miToM;
    },
    kgToLb: function(kg) {
      return kg * K.kgToLb;
    },
    lbToKg: function(lb) {
      return lb * K.lbToKg;
    },
    // 脑容量估算 (基于时间的线性插值, 时间单位: 年, 返回 cc)
    brainCapacity: function(yearsAgo) {
      if (yearsAgo <= K.homoSapiensStart) {
        return K.brainModernHuman;
      }
      if (yearsAgo <= K.homoErectusStart) {
        // 直立人到智人
        var t = (yearsAgo - K.homoSapiensStart) / (K.homoErectusStart - K.homoSapiensStart);
        return K.brainHomoSapiens + t * (K.brainHomoErectus - K.brainHomoSapiens);
      }
      if (yearsAgo <= K.homoHabilisStart) {
        var t2 = (yearsAgo - K.homoErectusStart) / (K.homoHabilisStart - K.homoErectusStart);
        return K.brainHomoErectus + t2 * (K.brainHomoHabilis - K.brainHomoErectus);
      }
      if (yearsAgo <= K.australopithecusStart) {
        var t3 = (yearsAgo - K.homoHabilisStart) / (K.australopithecusStart - K.homoHabilisStart);
        return K.brainHomoHabilis + t3 * (K.brainAustralopithecus - K.brainHomoHabilis);
      }
      return K.brainAustralopithecus;
    },
    // 某个年代距今的年数 (假设传入年份AD)
    yearsAgo: function(yearAD) {
      var currentYear = new Date().getFullYear();
      return currentYear - yearAD;
    },
    // 比较两个脑容量差异
    brainDifference: function(capacity1, capacity2) {
      return capacity2 - capacity1;
    },
    // 进化时间跨度
    evolutionSpan: function(start, end) {
      return start - end;
    },
    // 从步数和步幅推算距离
    distanceFromSteps: function(steps, stepLength) {
      return steps * (stepLength || K.averageStepLength);
    },
    // 步行时间
    walkingTime: function(distance, speed) {
      return distance / (speed || K.walkingSpeed);
    },
    // 跑步时间
    runningTime: function(distance, speed) {
      return distance / (speed || K.runningSpeed);
    },
    // 重力在不同星球上的重量
    weightOnPlanet: function(mass, surfaceGravity) {
      return mass * surfaceGravity;
    },
    // 地球表面重力加速度近似
    surfaceGravity: function(mass, radius) {
      return K.G * mass / (radius * radius);
    },
    // 声速 (海平面, 20°C)
    soundSpeed: 343,
    // 马赫数
    machNumber: function(velocity) {
      return velocity / P.soundSpeed;
    },
    // 百分比
    percent: function(part, whole) {
      return (part / whole) * 100;
    },
    // 比例
    ratio: function(a, b) {
      return a / b;
    }
  };

  function mount(cfg) {
    var stage = document.getElementById('stage');
    var main = document.getElementById('main');
    if (!stage || !main) {
      return;
    }

    var body = document.body;
    var page = parseInt(body.getAttribute('data-page'), 10);
    var total = parseInt(body.getAttribute('data-total'), 10);
    var hasPageData = !isNaN(page) && !isNaN(total) && total > 0;

    // 创建页眉
    var header = document.createElement('header');
    header.className = 'lec-header';

    var headerInner = document.createElement('div');
    headerInner.className = 'lec-header-inner';

    // act 如果有, 只显示数字, 不显示 "Act" 标签
    if (cfg.act !== undefined && cfg.act !== null) {
      var actSpan = document.createElement('span');
      actSpan.className = 'lec-act';
      actSpan.textContent = cfg.act;
      headerInner.appendChild(actSpan);
    }

    // title
    if (cfg.title) {
      var titleDiv = document.createElement('div');
      titleDiv.className = 'lec-title';
      titleDiv.textContent = cfg.title;
      headerInner.appendChild(titleDiv);
    }

    // sub (kicker)
    if (cfg.sub) {
      var subDiv = document.createElement('div');
      subDiv.className = 'lec-sub';
      subDiv.textContent = cfg.sub;
      headerInner.appendChild(subDiv);
    }

    header.appendChild(headerInner);
    stage.insertBefore(header, main);

    // 创建页脚
    var footer = document.createElement('footer');
    footer.className = 'lec-footer';

    var footerInner = document.createElement('div');
    footerInner.className = 'lec-footer-inner';

    // foot (takeaway)
    if (cfg.foot) {
      var footDiv = document.createElement('div');
      footDiv.className = 'lec-foot';
      footDiv.textContent = cfg.foot;
      footerInner.appendChild(footDiv);
    }

    // 进度条 (不显示页码数字)
    if (hasPageData) {
      var progressContainer = document.createElement('div');
      progressContainer.className = 'lec-progress';
      var progressBar = document.createElement('div');
      progressBar.className = 'lec-progress-bar';
      var percentage = (page / total) * 100;
      progressBar.style.width = percentage + '%';
      progressContainer.appendChild(progressBar);
      footerInner.appendChild(progressContainer);
    }

    footer.appendChild(footerInner);
    stage.appendChild(footer);
  }

  window.Lec = {
    K: K,
    P: P,
    mount: mount
  };
})();
