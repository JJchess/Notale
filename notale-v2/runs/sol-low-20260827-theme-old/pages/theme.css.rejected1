/* ==== INTERFACE ====
   token    --bg #F4F1E8             实验记录纸底色｜整页舞台背景
   token    --text #242424           主要文字与结构信息｜标题、正文、公式
   token    --muted #666666          次级信息｜注释、图注、辅助标签
   token    --line #8A8A8A           中性结构线｜分栏、表格、坐标与连接
   token    --line-light #C8C8C8     弱结构线｜刻度、辅助网格与禁用边界
   token    --surface #FCFCFC        仪器读数表面｜仅用于 panel 等读数或控件区域
   token    --model #2457A6          当前模型算出的值｜预测值、前向实线箭头、模型输出
   token    --attention #E56B2F      当前要观察或操作的位置｜活动控件、游标、当前步骤
   token    --focus #E56B2F          键盘焦点｜交互元素的清晰外轮廓
   token    --font-serif             每幕开头的一句主张｜仅用于 .scene-claim
   token    --font-sans              标题、正文、按钮、图表标签
   token    --font-mono              参数值、更新数值、步骤编号
   token    --fs-h1 44px             页标题
   token    --fs-h2 26px             区块标题
   token    --fs-lead 22px           导语或强调正文
   token    --fs-body 18px           正文
   token    --fs-sec 16px            次级成句说明
   token    --fs-label 15px          控件、图例、图注与提示
   token    --fs-tick 13px           仅纯数字刻度
   版心     1488×844                 #stage 已含 28px 56px padding
   版式     .canvas-full             主内容铺满可用版心并允许定位画布
   版式     .focus                   单焦点居中构图
   版式     .ledger                  纵向实验账页与修订记录
   版式     .split-lr                左右直角分栏
   版式     .split-tb                上下直角分栏
   版式     .stage-cards             横向阶段卡片序列
   版式     .triptych                三列等基线构图
   骨架     .k-process               用 .step、.arw 或 .axis 显示有方向的过程
   骨架     .k-process .arw.back     右向左双线箭头表示反向传播
   骨架     .k-comparison            用 .dim、.hdr、.rowline、.diff 同行同尺度比较
   骨架     .k-classification        用 .lv、.box、.bt 的嵌套和缩进显示归属
   骨架     .k-generalization        用 .claim、.trunk、.supports、.support 显示主张与支撑
   组件     .scene-claim             每幕开头唯一使用衬线体的主张句
   组件     .kicker                  标题上方的短标签并与标题同栏堆叠
   组件     .panel / .panel.q        读数与控件容器｜q 仅保留边距和边框
   组件     .big / .big.sm / .big.lg 大号读数及两种尺寸
   组件     .num / .unit             等宽数值与单位
   组件     .hint                    操作提示
   组件     .btn / .btns             按钮及按钮组
   组件     .ctl                     带刻度感的参数控制容器
   组件     input[type=range]         参数滑杆及选中、焦点、禁用状态
   组件     .tag                     直角文字标记
   组件     .legend > .li > .sw      图例条目与色块
   组件     .sw.line                 线型图例
   组件     .cvbox                   媒体定位、轻微圆角与裁切
   组件     .quiz / .opt / .fb       作答区、选项与反馈
   组件     .opt[aria-checked=true]   已选择状态｜与正确性状态分离
   组件     .opt.correct             正确性标记｜中性双线，不使用红绿色
   组件     .opt.incorrect           待修订标记｜中性虚线，不使用红绿色
   组件     .lead / .small / .note   导语、次级成句说明与提示文字
   组件     .backdrop                整页氛围图层
   组件     .backdrop-note           氛围图来源或说明
   ==== /INTERFACE ==== */

:root {
  --pad-x: 56px;
  --pad-y: 28px;

  --bg: #F4F1E8;
  --text: #242424;
  --muted: #666666;
  --line: #8A8A8A;
  --line-light: #C8C8C8;
  --surface: #FCFCFC;
  --model: #2457A6;
  --attention: #E56B2F;
  --focus: #E56B2F;

  --font-serif: "Noto Serif CJK SC", "Source Han Serif SC", "Songti SC", Georgia, serif;
  --font-sans: "Noto Sans CJK SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  --font-mono: "JetBrains Mono", "Source Code Pro", "SFMono-Regular", Consolas, monospace;

  --fs-h1: 44px;
  --fs-h2: 26px;
  --fs-lead: 22px;
  --fs-body: 18px;
  --fs-sec: 16px;
  --fs-label: 15px;
  --fs-tick: 13px;
}

#stage { display: flex; flex-direction: column; padding: var(--pad-y) var(--pad-x); }

#stage {
  position: relative;
  overflow: hidden;
  color: var(--text);
  background: var(--bg);
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.5;
  isolation: isolate;
}

#stage h1,
#stage h2,
#stage h3,
#stage p {
  margin-top: 0;
}

#stage h1 {
  margin-bottom: 18px;
  font-size: var(--fs-h1);
  line-height: 1.14;
  font-weight: 760;
  letter-spacing: -0.025em;
}

#stage h2 {
  margin-bottom: 12px;
  font-size: var(--fs-h2);
  line-height: 1.24;
  font-weight: 730;
}

#stage h3 {
  margin-bottom: 8px;
  font-size: var(--fs-body);
  line-height: 1.35;
  font-weight: 720;
}

#stage p {
  margin-bottom: 0.75em;
}

/* 文字角色 */

.scene-claim {
  max-width: 24em;
  margin: 0;
  font-family: var(--font-serif);
  font-size: 36px;
  line-height: 1.32;
  font-weight: 650;
  letter-spacing: -0.015em;
}

.kicker {
  display: block;
  margin: 0 0 8px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.lead {
  max-width: 42em;
  font-size: var(--fs-lead);
  line-height: 1.5;
  font-weight: 560;
}

.small {
  font-size: var(--fs-sec);
  line-height: 1.5;
  color: var(--muted);
}

.note {
  font-size: var(--fs-label);
  line-height: 1.45;
  color: var(--muted);
}

/* 版式 */

.canvas-full,
.focus,
.ledger,
.split-lr,
.split-tb,
.stage-cards,
.triptych {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.canvas-full {
  position: relative;
  display: block;
  width: 100%;
}

.focus {
  display: grid;
  place-items: center;
}

.ledger {
  display: grid;
  grid-auto-rows: minmax(0, auto);
  align-content: start;
  width: 100%;
  border-top: 2px solid var(--text);
  border-bottom: 1px solid var(--line);
}

.ledger > * {
  min-width: 0;
  padding-block: 16px;
  border-bottom: 1px solid var(--line-light);
}

.ledger > :last-child {
  border-bottom: 0;
}

.split-lr {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
}

.split-lr > * {
  min-width: 0;
  min-height: 0;
}

.split-lr > :not(:first-child) {
  border-left: 1px solid var(--line);
}

.split-tb {
  display: grid;
  grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
}

.split-tb > * {
  min-width: 0;
  min-height: 0;
}

.split-tb > :not(:first-child) {
  border-top: 1px solid var(--line);
}

.stage-cards {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  align-items: stretch;
}

.stage-cards > * {
  min-width: 0;
  min-height: 0;
  border-left: 1px solid var(--line-light);
}

.stage-cards > :first-child {
  border-left: 0;
}

.triptych {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
}

.triptych > * {
  min-width: 0;
  min-height: 0;
}

.triptych > :not(:first-child) {
  border-left: 1px solid var(--line);
}

/* 过程骨架 */

.k-process {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
}

.k-process .step {
  position: relative;
  z-index: 1;
  min-width: 0;
  border: 1.5px solid var(--line);
  padding: 14px 16px;
  background: var(--bg);
}

.k-process .step.current,
.k-process .step[aria-current="step"] {
  border: 3px solid var(--attention);
  font-weight: 700;
}

.k-process .arw {
  position: relative;
  flex: 0 0 58px;
  height: 18px;
  margin-inline: 8px;
}

.k-process .arw::before {
  content: "";
  position: absolute;
  left: 0;
  right: 7px;
  top: 8px;
  border-top: 2px solid var(--model);
}

.k-process .arw::after {
  content: "";
  position: absolute;
  right: 0;
  top: 4px;
  width: 8px;
  height: 8px;
  border-top: 2px solid var(--model);
  border-right: 2px solid var(--model);
  transform: rotate(45deg);
}

.k-process .arw.back::before {
  left: 8px;
  right: 0;
  top: 5px;
  height: 6px;
  border-top: 2px solid var(--text);
  border-bottom: 2px solid var(--text);
}

.k-process .arw.back::after {
  left: 0;
  right: auto;
  top: 4px;
  border: 0;
  border-left: 2px solid var(--text);
  border-bottom: 2px solid var(--text);
  transform: rotate(45deg);
}

.k-process .axis {
  position: absolute;
  z-index: 0;
  left: 0;
  right: 0;
  top: 50%;
  height: 0;
  border-top: 2px solid var(--model);
  pointer-events: none;
}

.k-process .axis::after {
  content: "";
  position: absolute;
  right: -1px;
  top: -6px;
  width: 9px;
  height: 9px;
  border-top: 2px solid var(--model);
  border-right: 2px solid var(--model);
  transform: rotate(45deg);
}

/* 比较骨架 */

.k-comparison {
  display: grid;
  grid-template-columns: minmax(150px, 0.8fr) repeat(var(--comparison-columns, 2), minmax(0, 1fr));
  align-items: stretch;
  border-top: 2px solid var(--text);
  border-bottom: 1px solid var(--line);
}

.k-comparison .dim,
.k-comparison .hdr,
.k-comparison .rowline,
.k-comparison .diff {
  display: flex;
  align-items: baseline;
  min-width: 0;
  padding: 12px 14px;
  border-right: 1px solid var(--line-light);
  border-bottom: 1px solid var(--line-light);
}

.k-comparison .dim {
  color: var(--muted);
  font-size: var(--fs-label);
  font-weight: 700;
}

.k-comparison .hdr {
  font-size: var(--fs-label);
  font-weight: 760;
}

.k-comparison .rowline {
  font-size: var(--fs-body);
  line-height: 1.4;
}

.k-comparison .diff {
  font-weight: 760;
}

.k-comparison > :nth-child(
  calc(var(--comparison-columns, 2) + 1)n
) {
  border-right: 0;
}

/* 分类骨架 */

.k-classification {
  display: grid;
  align-content: start;
  border-left: 2px solid var(--text);
}

.k-classification .lv {
  position: relative;
  min-width: 0;
  margin-left: calc(var(--level, 0) * 28px);
  padding: 10px 0 10px 22px;
  border-bottom: 1px solid var(--line-light);
}

.k-classification .lv::before {
  content: "";
  position: absolute;
  left: 0;
  top: 1.45em;
  width: 14px;
  border-top: 1.5px solid var(--line);
}

.k-classification .box {
  min-width: 0;
  border: 1.5px solid var(--line);
  padding: 12px 14px;
}

.k-classification .box > .box {
  margin: 10px 0 0 24px;
}

.k-classification .bt {
  display: block;
  margin-bottom: 5px;
  font-size: var(--fs-label);
  line-height: 1.35;
  font-weight: 760;
}

/* 概括骨架 */

.k-generalization {
  position: relative;
  display: grid;
  align-content: start;
}

.k-generalization .claim {
  position: relative;
  z-index: 1;
  border: 2px solid var(--text);
  padding: 18px 20px;
  font-size: var(--fs-lead);
  line-height: 1.42;
  font-weight: 780;
  background: var(--bg);
}

.k-generalization .trunk {
  width: 2px;
  min-height: 34px;
  margin-inline: auto;
  background: var(--text);
}

.k-generalization .supports {
  position: relative;
  display: grid;
  grid-template-columns: repeat(var(--support-columns, 3), minmax(0, 1fr));
}

.k-generalization .supports::before {
  content: "";
  position: absolute;
  left: calc(50% / var(--support-columns, 3));
  right: calc(50% / var(--support-columns, 3));
  top: 0;
  border-top: 1.5px solid var(--line);
}

.k-generalization .support {
  position: relative;
  min-width: 0;
  padding: 28px 14px 12px;
  font-size: var(--fs-sec);
  line-height: 1.5;
}

.k-generalization .support::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  height: 20px;
  border-left: 1.5px solid var(--line);
}

/* 仪器与读数 */

.panel {
  min-width: 0;
  padding: 18px 20px;
  border: 1.5px solid var(--line);
  background: var(--surface);
}

.panel.q {
  background: transparent;
}

.big,
.num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums lining-nums;
}

.big {
  display: inline-block;
  color: var(--text);
  font-size: 52px;
  line-height: 1;
  font-weight: 720;
  letter-spacing: -0.04em;
}

.big.sm {
  font-size: 38px;
}

.big.lg {
  font-size: 68px;
}

.num {
  white-space: nowrap;
}

.num.model {
  color: var(--model);
}

.unit {
  margin-left: 0.35em;
  color: var(--muted);
  font-family: var(--font-sans);
  font-size: 0.42em;
  line-height: 1;
  font-weight: 650;
  letter-spacing: 0;
}

/* 控件 */

.hint {
  font-size: var(--fs-label);
  line-height: 1.45;
  color: var(--muted);
}

.btns {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.btn {
  min-height: 44px;
  border: 1.5px solid var(--text);
  border-radius: 8px;
  padding: 9px 16px;
  color: var(--text);
  background: var(--surface);
  font: 700 var(--fs-label)/1.35 var(--font-sans);
  cursor: pointer;
}

.btn:hover {
  border-color: var(--attention);
}

.btn:active,
.btn.is-selected,
.btn[aria-pressed="true"] {
  border-color: var(--attention);
  background: var(--attention);
  color: #FFFFFF;
}

.btn:focus-visible,
.opt:focus-visible,
input[type="range"]:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}

.btn:disabled,
.btn[aria-disabled="true"] {
  border-color: var(--line-light);
  color: var(--muted);
  background: #E8E8E8;
  cursor: not-allowed;
  opacity: 0.72;
}

.ctl {
  position: relative;
  min-width: 0;
  border: 1.5px solid var(--line);
  border-radius: 12px;
  padding: 20px;
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 15px,
      rgba(102, 102, 102, 0.24) 15px,
      rgba(102, 102, 102, 0.24) 16px
    ) left 9px bottom 7px / calc(100% - 18px) 5px no-repeat,
    var(--surface);
}

.ctl:focus-within {
  border-color: var(--attention);
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.ctl.is-active,
.ctl[aria-current="true"] {
  border: 3px solid var(--attention);
  padding: 18px;
}

input[type="range"] {
  width: 100%;
  height: 28px;
  margin: 8px 0;
  background: transparent;
  cursor: pointer;
  accent-color: var(--attention);
}

input[type="range"]::-webkit-slider-runnable-track {
  height: 4px;
  border: 1px solid var(--line);
  background: #D8D8D8;
}

input[type="range"]::-webkit-slider-thumb {
  width: 22px;
  height: 22px;
  margin-top: -10px;
  border: 3px solid var(--attention);
  border-radius: 50%;
  background: var(--surface);
  -webkit-appearance: none;
}

input[type="range"]::-moz-range-track {
  height: 4px;
  border: 1px solid var(--line);
  background: #D8D8D8;
}

input[type="range"]::-moz-range-progress {
  height: 4px;
  background: var(--attention);
}

input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border: 3px solid var(--attention);
  border-radius: 50%;
  background: var(--surface);
}

input[type="range"]:disabled {
  cursor: not-allowed;
  opacity: 0.52;
  filter: grayscale(1);
}

/* 标记与图例 */

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  border: 1px solid var(--line);
  padding: 3px 8px;
  color: var(--text);
  background: transparent;
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  line-height: 1.35;
  font-weight: 700;
}

.tag.current {
  border: 2px solid var(--attention);
}

.legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: var(--fs-label);
  line-height: 1.4;
}

.legend > .li {
  display: inline-flex;
  align-items: center;
  min-width: 0;
}

.legend > .li > .sw {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  margin-right: 7px;
  border: 1px solid var(--line);
  background: currentColor;
}

.legend > .li > .sw.line {
  width: 28px;
  height: 0;
  border: 0;
  border-top: 3px solid currentColor;
  background: transparent;
}

.legend > .li > .sw.line.back {
  height: 7px;
  border-top: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
}

/* 媒体 */

.cvbox {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border-radius: 3px;
}

.cvbox > img,
.cvbox > video,
.cvbox > canvas,
.cvbox > svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.backdrop {
  position: absolute;
  z-index: -2;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.19;
  pointer-events: none;
}

.backdrop-note {
  position: absolute;
  z-index: 1;
  right: var(--pad-x);
  bottom: var(--pad-y);
  max-width: 34em;
  color: var(--muted);
  font-size: var(--fs-label);
  line-height: 1.4;
}

/* 作答 */

.quiz {
  display: grid;
  align-content: start;
  min-width: 0;
}

.opt {
  position: relative;
  width: 100%;
  min-height: 48px;
  border: 1.5px solid var(--line);
  border-radius: 8px;
  padding: 11px 42px 11px 14px;
  color: var(--text);
  background: transparent;
  font: 600 var(--fs-body)/1.4 var(--font-sans);
  text-align: left;
  cursor: pointer;
}

.opt:hover {
  border-color: var(--attention);
}

.opt[aria-checked="true"],
.opt.is-selected {
  border: 3px solid var(--attention);
  padding: 9px 40px 9px 12px;
}

.opt[aria-checked="true"]::after,
.opt.is-selected::after {
  content: "";
  position: absolute;
  right: 15px;
  top: 50%;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--attention);
  transform: translateY(-50%);
}

.opt.correct {
  border-style: double;
  border-width: 4px;
  border-color: var(--text);
  padding: 8px 39px 8px 11px;
}

.opt.incorrect {
  border-style: dashed;
  border-color: var(--text);
}

.opt:disabled,
.opt[aria-disabled="true"] {
  color: var(--muted);
  border-color: var(--line-light);
  background: #E8E8E8;
  cursor: not-allowed;
  opacity: 0.72;
}

.fb {
  min-height: 1.45em;
  border-top: 1px solid var(--line);
  padding-top: 10px;
  color: var(--text);
  font-size: var(--fs-label);
  line-height: 1.45;
}

.fb[aria-live="polite"]:empty {
  border-top-color: transparent;
}

/* SVG 防覆盖 */

svg .bar, svg .step, svg .cell, svg .box, svg .arw { width:auto; height:auto; }
