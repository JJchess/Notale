/* ==== INTERFACE ====
   token    --bg #F4F1E8              实验记录纸底色｜仅舞台与透明区域背景
   token    --text #202225            主文字与主要结构线｜标题、正文、公式
   token    --muted #5D6268           次级文字｜图注、说明、非活动标签
   token    --line #7A7D80            中性测量线｜边框、坐标轴、反向信息
   token    --line-soft #B8B9B7       弱结构线｜分隔、刻度、辅助连接
   token    --surface #FFFFFF         仪器表面｜仅 .panel、控件与作答选项
   token    --disabled #D5D5D2        禁用状态｜禁用控件和不可用读数
   token    --model #2457A6           当前模型算出的值｜预测值、前向箭头、前向曲线
   token    --attention #E56B2F       当前要观察或操作的点｜活动控件、游标、当前步骤
   token    --focus #E56B2F           键盘焦点｜可交互元素的焦点边界
   token    --font-sans               标题、正文、按钮、标签与图表文字
   token    --font-serif              每幕开头的一句主张｜仅 .scene-claim
   token    --font-mono               参数值、更新数值、步骤编号与纯数字刻度
   token    --fs-h1 38px              页标题
   token    --fs-h2 24px              区块标题
   token    --fs-lead 21px            导语或强调正文
   token    --fs-body 18px            正文
   token    --fs-sec 16px             次级成句说明
   token    --fs-label 15px           控件、图例、图注与提示
   token    --fs-tick 13px            仅纯数字刻度
   版心     1488×844                  #stage 已含 28px 56px padding
   版式     .canvas-full              占满版心的单一自由画布
   版式     .focus                    单焦点构图，内容集中于中央主区域
   版式     .ledger                   上部说明与下部实验账页的纵向关系
   版式     .split-lr                 左右直角分栏
   版式     .split-tb                 上下直角分栏
   版式     .stage-cards              横向连续阶段区，不作为普通卡片墙
   版式     .triptych                 三个同尺度直角分区
   版式     .title-stack              kicker 与标题在同栏纵向堆叠
   骨架     .k-process                用 .step 与 .arw 或贯穿 .axis 显示过程方向
   骨架     .step                     过程阶段；当前阶段用 aria-current 或 .is-current
   骨架     .arw                      左向右深蓝实线前向箭头
   骨架     .arw.back                 右向左中性双线反向箭头
   骨架     .axis                     贯穿多个阶段的前向主轴；.back 改为反向双线
   骨架     .k-comparison             同行、同尺度、同基线比较容器
   骨架     .dim                      比较维度列
   骨架     .hdr                      比较表头
   骨架     .rowline                  单行比较关系
   骨架     .diff                     行内关键差异
   骨架     .k-classification         通过嵌套与缩进表达归属
   骨架     .lv                       分类层级
   骨架     .box                      分类项边界
   骨架     .bt                       父子归属连接
   骨架     .k-generalization         主张与证据支撑关系
   骨架     .claim                    高权重主张
   骨架     .trunk                    连接主张和支撑的主干
   骨架     .supports                 支撑集合
   骨架     .support                  挂接主干的单条支撑
   组件     .panel                    有填色的读数与控件容器
   组件     .panel.q                  同边距的透明讲解容器
   组件     .big/.big.sm/.big.lg      主读数及尺寸变体
   组件     .num/.unit                等宽数值与单位
   组件     .update                   “更新前 → 更新后”实验账目
   组件     .hint                     操作提示；.is-active 标记当前提示
   组件     .btn/.btns                按钮及按钮组
   组件     .ctl                      带刻度语义的圆角参数控件框
   组件     .knob                     带刻度的圆形参数旋钮
   组件     input[type=range]         参数滑杆
   组件     .tag                      直角短标签
   组件     .legend/.li/.sw           图例、图例项与色块
   组件     .sw.line                  线型图例；.model、.attention、.back 对应语义
   组件     .cvbox                    媒体、Canvas 或图表的定位裁切框
   组件     .quiz/.opt/.fb            作答区、选项与反馈
   组件     .lead/.small/.note        导语、次级成句说明与提示文字
   组件     .scene-claim              每幕开头唯一使用衬线体的主张句
   组件     .backdrop                 整页氛围图层
   组件     .backdrop-note            氛围图来源或说明
   ==== /INTERFACE ==== */

:root { --pad-x: 56px; --pad-y: 28px; }
#stage { display: flex; flex-direction: column; padding: var(--pad-y) var(--pad-x); }

:root {
  --bg: #F4F1E8;
  --text: #202225;
  --muted: #5D6268;
  --line: #7A7D80;
  --line-soft: #B8B9B7;
  --surface: #FFFFFF;
  --disabled: #D5D5D2;
  --model: #2457A6;
  --attention: #E56B2F;
  --focus: #E56B2F;

  --font-sans: "Noto Sans SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  --font-serif: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
  --font-mono: "IBM Plex Mono", "JetBrains Mono", "SFMono-Regular", Consolas, monospace;

  --fs-h1: 38px;
  --fs-h2: 24px;
  --fs-lead: 21px;
  --fs-body: 18px;
  --fs-sec: 16px;
  --fs-label: 15px;
  --fs-tick: 13px;
}

/* 舞台与文字 */

#stage {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.5;
}

#stage > :not(.backdrop) {
  position: relative;
  z-index: 1;
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1 {
  font-family: var(--font-sans);
  font-size: var(--fs-h1);
  font-weight: 760;
  line-height: 1.16;
  letter-spacing: -0.02em;
}

h2 {
  font-family: var(--font-sans);
  font-size: var(--fs-h2);
  font-weight: 720;
  line-height: 1.25;
}

h3 {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.35;
}

p,
li {
  font-size: var(--fs-body);
  line-height: 1.5;
}

.title-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.kicker {
  order: -1;
  display: block;
  margin: 0 0 8px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 650;
  line-height: 1.35;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.scene-claim {
  max-width: 34em;
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30px;
  font-weight: 650;
  line-height: 1.42;
}

.lead {
  font-size: var(--fs-lead);
  font-weight: 560;
  line-height: 1.45;
}

.small {
  color: var(--muted);
  font-size: var(--fs-sec);
  line-height: 1.45;
}

.note {
  color: var(--muted);
  font-size: var(--fs-label);
  line-height: 1.4;
}

/* 版式 */

.canvas-full,
.focus,
.ledger,
.split-lr,
.split-tb,
.stage-cards,
.triptych {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.canvas-full {
  position: relative;
  display: block;
  width: 100%;
}

.focus {
  display: grid;
  place-items: center;
  grid-template-columns: minmax(0, 1fr);
}

.focus > * {
  min-width: 0;
  max-width: 100%;
}

.ledger {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  align-content: stretch;
}

.ledger > * {
  min-width: 0;
  min-height: 0;
}

.split-lr {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
}

.split-lr > * {
  min-width: 0;
  min-height: 0;
}

.split-lr > * + * {
  border-left: 1px solid var(--line-soft);
}

.split-tb {
  display: grid;
  grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
}

.split-tb > * {
  min-width: 0;
  min-height: 0;
}

.split-tb > * + * {
  border-top: 1px solid var(--line-soft);
}

.stage-cards {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  align-items: stretch;
}

.stage-cards > * {
  min-width: 0;
  min-height: 0;
  border: 1px solid var(--line);
  background: transparent;
}

.stage-cards > * + * {
  border-left: 0;
}

.triptych {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
}

.triptych > * {
  min-width: 0;
  min-height: 0;
}

.triptych > * + * {
  border-left: 1px solid var(--line-soft);
}

/* 过程骨架 */

.k-process {
  position: relative;
  display: flex;
  align-items: stretch;
  min-width: 0;
}

.k-process .step {
  position: relative;
  z-index: 1;
  min-width: 0;
  border: 1px solid var(--line);
  background: transparent;
}

.k-process .step[aria-current="step"],
.k-process .step.is-current {
  border: 4px solid var(--attention);
}

.k-process .step-no {
  display: block;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: 1.35;
}

.arw {
  position: relative;
  flex: 0 0 58px;
  align-self: center;
  height: 20px;
  color: var(--model);
}

.arw::before {
  position: absolute;
  top: 9px;
  right: 6px;
  left: 0;
  border-top: 3px solid currentColor;
  content: "";
}

.arw::after {
  position: absolute;
  top: 4px;
  right: 0;
  width: 10px;
  height: 10px;
  border-top: 3px solid currentColor;
  border-right: 3px solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.arw.back {
  color: var(--line);
}

.arw.back::before {
  top: 6px;
  right: 0;
  left: 6px;
  height: 6px;
  border-top: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
}

.arw.back::after {
  top: 4px;
  right: auto;
  left: 0;
  border: 0;
  border-bottom: 3px solid currentColor;
  border-left: 3px solid currentColor;
  transform: rotate(45deg);
}

.k-process.has-axis {
  padding-top: 32px;
}

.k-process > .axis {
  position: absolute;
  z-index: 0;
  top: 12px;
  right: 8px;
  left: 8px;
  height: 12px;
  border-top: 3px solid var(--model);
}

.k-process > .axis::after {
  position: absolute;
  top: -7px;
  right: 0;
  width: 10px;
  height: 10px;
  border-top: 3px solid var(--model);
  border-right: 3px solid var(--model);
  content: "";
  transform: rotate(45deg);
}

.k-process > .axis.back {
  height: 8px;
  border-top: 2px solid var(--line);
  border-bottom: 2px solid var(--line);
}

.k-process > .axis.back::after {
  top: -5px;
  right: auto;
  left: 0;
  border: 0;
  border-bottom: 3px solid var(--line);
  border-left: 3px solid var(--line);
  transform: rotate(45deg);
}

/* 比较骨架 */

.k-comparison {
  display: grid;
  min-width: 0;
  border-top: 2px solid var(--text);
  border-bottom: 1px solid var(--line);
}

.k-comparison .hdr,
.k-comparison .rowline {
  display: grid;
  grid-template-columns: minmax(160px, 0.8fr) repeat(var(--compare-cols, 2), minmax(0, 1fr));
  align-items: baseline;
  min-width: 0;
}

.k-comparison .hdr {
  border-bottom: 2px solid var(--text);
  font-size: var(--fs-label);
  font-weight: 720;
  line-height: 1.35;
}

.k-comparison .rowline {
  border-bottom: 1px solid var(--line-soft);
  font-size: var(--fs-body);
  line-height: 1.45;
}

.k-comparison .rowline:last-child {
  border-bottom: 0;
}

.k-comparison .dim {
  color: var(--muted);
  font-weight: 650;
}

.k-comparison .hdr > *,
.k-comparison .rowline > * {
  min-width: 0;
  padding: 12px 16px;
}

.k-comparison .hdr > * + *,
.k-comparison .rowline > * + * {
  border-left: 1px solid var(--line-soft);
}

.k-comparison .diff {
  color: var(--text);
  font-weight: 780;
  text-decoration: underline;
  text-decoration-color: var(--attention);
  text-decoration-thickness: 3px;
  text-underline-offset: 5px;
}

/* 分类骨架 */

.k-classification {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.k-classification .lv {
  position: relative;
  border-left: 2px solid var(--line);
}

.k-classification .lv .lv {
  margin-left: 34px;
  border-left-color: var(--line-soft);
}

.k-classification .box {
  position: relative;
  border: 1px solid var(--line);
  background: transparent;
}

.k-classification .lv > .box::before {
  position: absolute;
  top: 50%;
  right: 100%;
  width: 18px;
  border-top: 2px solid var(--line);
  content: "";
}

.k-classification .bt {
  position: relative;
  min-height: 24px;
  margin-left: 34px;
  border-left: 2px solid var(--line-soft);
}

.k-classification .bt::after {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 18px;
  border-bottom: 2px solid var(--line-soft);
  content: "";
}

/* 概括骨架 */

.k-generalization {
  display: grid;
  grid-template-columns: minmax(260px, 0.72fr) 52px minmax(0, 1.28fr);
  align-items: stretch;
  min-width: 0;
}

.k-generalization .claim {
  align-self: center;
  border: 3px solid var(--text);
  font-size: var(--fs-lead);
  font-weight: 780;
  line-height: 1.4;
}

.k-generalization .trunk {
  position: relative;
  min-height: 100%;
}

.k-generalization .trunk::before {
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  border-top: 3px solid var(--text);
  content: "";
}

.k-generalization .trunk::after {
  position: absolute;
  top: 12%;
  right: 0;
  bottom: 12%;
  border-right: 3px solid var(--text);
  content: "";
}

.k-generalization .supports {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  min-width: 0;
}

.k-generalization .support {
  position: relative;
  border: 1px solid var(--line);
  background: transparent;
  font-size: var(--fs-body);
  line-height: 1.45;
}

.k-generalization .support::before {
  position: absolute;
  top: 50%;
  right: 100%;
  width: 28px;
  border-top: 2px solid var(--text);
  content: "";
}

/* 仪器与读数 */

.panel {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 0;
  padding: 20px;
  background: var(--surface);
}

.panel.q {
  padding: 20px;
  background: transparent;
}

.big {
  display: inline-flex;
  align-items: baseline;
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 52px;
  font-weight: 720;
  font-variant-numeric: tabular-nums lining-nums;
  line-height: 1;
  letter-spacing: -0.04em;
}

.big.sm {
  font-size: 38px;
}

.big.lg {
  font-size: 68px;
}

.num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums lining-nums;
}

.num.model,
.big.model {
  color: var(--model);
}

.num.attention,
.big.attention {
  color: var(--attention);
}

.unit {
  margin-left: 0.28em;
  color: var(--muted);
  font-family: var(--font-sans);
  font-size: 0.42em;
  font-weight: 650;
  letter-spacing: 0;
}

.update {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: baseline;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: var(--fs-body);
  font-variant-numeric: tabular-nums lining-nums;
}

.update > * {
  min-width: 0;
  padding: 12px 14px;
}

.update > * + * {
  border-left: 1px solid var(--line-soft);
}

.update .before {
  color: var(--muted);
}

.update .after {
  color: var(--text);
  font-weight: 760;
}

.update .to {
  color: var(--attention);
  font-weight: 800;
}

/* 操作 */

.hint {
  display: block;
  border: 1px solid var(--line);
  padding: 10px 12px;
  color: var(--muted);
  background: transparent;
  font-size: var(--fs-label);
  line-height: 1.4;
}

.hint.is-active {
  border: 3px solid var(--attention);
  color: var(--text);
  font-weight: 700;
}

.btns {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.btn {
  min-height: 44px;
  border: 2px solid var(--text);
  border-radius: 10px;
  padding: 9px 16px;
  color: var(--text);
  background: var(--surface);
  font: 700 var(--fs-label)/1.35 var(--font-sans);
  cursor: pointer;
}

.btn:hover:not(:disabled):not([aria-disabled="true"]) {
  border-color: var(--attention);
}

.btn:active:not(:disabled):not([aria-disabled="true"]) {
  background: var(--text);
  color: var(--surface);
}

.btn:focus-visible {
  border-color: var(--focus);
}

.btn[aria-pressed="true"],
.btn[aria-selected="true"],
.btn.is-selected {
  border: 4px solid var(--attention);
  padding: 7px 14px;
}

.btn:disabled,
.btn[aria-disabled="true"] {
  border-color: var(--disabled);
  color: var(--muted);
  background: var(--disabled);
  cursor: not-allowed;
  opacity: 0.72;
}

.ctl {
  display: grid;
  grid-template-columns: minmax(120px, auto) minmax(0, 1fr) auto;
  align-items: center;
  min-width: 0;
  border: 2px solid var(--line);
  border-radius: 16px;
  padding: 12px 16px;
  background: var(--surface);
}

.ctl:focus-within,
.ctl.is-active {
  border: 4px solid var(--attention);
  padding: 10px 14px;
}

.ctl > label,
.ctl .label {
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: 1.35;
}

.ctl output {
  min-width: 6ch;
  color: var(--text);
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 700;
  font-variant-numeric: tabular-nums lining-nums;
  text-align: right;
}

.ctl[aria-disabled="true"] {
  border-color: var(--disabled);
  color: var(--muted);
  background: var(--disabled);
  opacity: 0.72;
}

.knob {
  position: relative;
  display: inline-grid;
  place-items: center;
  width: 82px;
  height: 82px;
  border: 2px solid var(--line);
  border-radius: 50%;
  color: var(--text);
  background:
    radial-gradient(circle at center, var(--surface) 0 56%, transparent 57%),
    repeating-conic-gradient(
      from -135deg,
      var(--line) 0 1.5deg,
      transparent 1.5deg 15deg
    );
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.knob::after {
  position: absolute;
  top: 9px;
  left: calc(50% - 2px);
  width: 4px;
  height: 18px;
  border-radius: 3px;
  background: var(--attention);
  content: "";
  transform: rotate(var(--knob-angle, 0deg));
  transform-origin: 2px 32px;
}

.knob[aria-disabled="true"] {
  border-color: var(--disabled);
  color: var(--muted);
  opacity: 0.65;
}

input[type="range"] {
  width: 100%;
  min-width: 120px;
  height: 28px;
  margin: 0;
  accent-color: var(--attention);
  background: transparent;
  cursor: pointer;
}

input[type="range"]::-webkit-slider-runnable-track {
  height: 4px;
  border: 1px solid var(--line);
  background: var(--surface);
}

input[type="range"]::-webkit-slider-thumb {
  width: 22px;
  height: 22px;
  margin-top: -10px;
  border: 3px solid var(--attention);
  border-radius: 50%;
  background: var(--surface);
  -webkit-appearance: none;
}

input[type="range"]::-moz-range-track {
  height: 4px;
  border: 1px solid var(--line);
  background: var(--surface);
}

input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border: 3px solid var(--attention);
  border-radius: 50%;
  background: var(--surface);
}

input[type="range"]:disabled {
  accent-color: var(--disabled);
  cursor: not-allowed;
  opacity: 0.58;
}

/* 标记与图例 */

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  border: 1px solid var(--line);
  border-radius: 0;
  padding: 3px 8px;
  color: var(--muted);
  background: transparent;
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 650;
  line-height: 1.35;
}

.tag.is-current {
  border: 3px solid var(--attention);
  padding: 1px 6px;
  color: var(--text);
}

.legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.legend > .li {
  display: inline-flex;
  align-items: center;
  color: var(--muted);
  font-size: var(--fs-label);
  line-height: 1.4;
}

.legend > .li > .sw {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  margin-right: 7px;
  border: 1px solid var(--line);
  background: transparent;
}

.legend > .li > .sw.model {
  border-color: var(--model);
  background: var(--model);
}

.legend > .li > .sw.attention {
  border-color: var(--attention);
  background: var(--attention);
}

.legend > .li > .sw.line {
  width: 30px;
  height: 10px;
  border: 0;
  border-top: 3px solid var(--line);
  background: transparent;
}

.legend > .li > .sw.line.model {
  border-top-color: var(--model);
}

.legend > .li > .sw.line.attention {
  border-top-color: var(--attention);
}

.legend > .li > .sw.line.back {
  height: 7px;
  border-top: 2px solid var(--line);
  border-bottom: 2px solid var(--line);
}

/* 媒体 */

.cvbox {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border-radius: 4px;
}

.cvbox > img,
.cvbox > video,
.cvbox > canvas,
.cvbox > svg {
  display: block;
  max-width: 100%;
}

.backdrop {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.18;
  pointer-events: none;
}

.backdrop-note {
  position: absolute !important;
  z-index: 2 !important;
  right: var(--pad-x);
  bottom: 12px;
  max-width: 46ch;
  color: var(--muted);
  font-size: var(--fs-label);
  line-height: 1.35;
  text-align: right;
  pointer-events: none;
}

/* 作答 */

.quiz {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.opt {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
  min-height: 48px;
  border: 2px solid var(--line);
  border-radius: 10px;
  padding: 10px 14px;
  color: var(--text);
  background: var(--surface);
  font-size: var(--fs-body);
  line-height: 1.45;
  cursor: pointer;
}

.opt:hover:not([aria-disabled="true"]) {
  border-color: var(--attention);
}

.opt:focus-within {
  border-color: var(--focus);
}

.opt[aria-checked="true"],
.opt[aria-selected="true"],
.opt.is-selected {
  border: 4px solid var(--attention);
  padding: 8px 12px;
}

.opt.is-correct,
.opt[data-correct="true"] {
  outline: 4px double var(--text);
  outline-offset: 3px;
}

.opt.is-incorrect,
.opt[data-correct="false"] {
  outline: 3px dashed var(--line);
  outline-offset: 3px;
}

.opt[aria-disabled="true"] {
  border-color: var(--disabled);
  color: var(--muted);
  background: var(--disabled);
  cursor: not-allowed;
  opacity: 0.72;
}

.fb {
  min-height: 44px;
  border-top: 2px solid var(--line);
  padding-top: 10px;
  color: var(--text);
  font-size: var(--fs-sec);
  font-weight: 600;
  line-height: 1.45;
}

.fb[data-state="correct"] {
  border-top-style: double;
  border-top-width: 5px;
}

.fb[data-state="incorrect"] {
  border-top-style: dashed;
}

/* SVG 防覆盖 */

svg .bar, svg .step, svg .cell, svg .box, svg .arw { width:auto; height:auto; }
