/* ==== INTERFACE ====
   token    --bg #F4F1E8          实验记录纸底色｜仅用于舞台、留白与透明表面
   token    --text #20242A        主文字｜标题、正文、公式与关键标注
   token    --muted #62666B       次级文字｜说明、图注与非活动刻度
   token    --line #85898D        结构灰线｜分栏、框线、坐标轴与连接关系
   token    --line-soft #C8C6BE   弱结构灰线｜辅助刻度、表格行与静止边界
   token    --surface #FAF8F2     仪器表面｜仅用于 .panel、按钮与输入区域
   token    --model #2457A6       当前模型算出的值｜预测值、前向信息、前向箭头
   token    --attention #E56B2F   当前要观察或操作的点｜活动控件、游标、当前步骤
   token    --focus #E56B2F       键盘焦点｜可交互元素的焦点轮廓
   token    --font-sans           无衬线正文｜标题、正文、按钮、图表标签
   token    --font-serif          衬线主张｜仅每幕开头的一句主张
   token    --font-mono           等宽数值｜参数、更新值、步骤编号
   token    --fs-h1 38px          页标题
   token    --fs-h2 25px          区块标题
   token    --fs-lead 21px        导语或强调正文
   token    --fs-body 18px        正文
   token    --fs-sec 16px         次级成句说明
   token    --fs-label 15px       控件、图例、图注与提示
   token    --fs-tick 13px        仅纯数字刻度
   版心     1488×844              #stage 已含 28px 56px padding
   版式     .canvas-full          单一画布占满主内容区
   版式     .focus                单焦点构图，内容集中于主要讲解对象
   版式     .ledger               实验账页构图，按行记录更新前后状态
   版式     .split-lr             左右直角分栏
   版式     .split-tb             上下直角分栏
   版式     .stage-cards          横向阶段分区，保留阶段间连接空间
   版式     .triptych             三列等基线分区
   骨架     .k-process            用 .step 与 .arw 或 .axis 显示有方向的过程
   骨架     .k-comparison         用 .dim、.hdr、.rowline、.diff 做同行同尺度比较
   骨架     .k-classification     用 .lv、.box、.bt 的嵌套与缩进显示归属
   骨架     .k-generalization     用较重 .claim、.trunk 与 .support 显示主张和支撑
   组件     .big/.num/.unit       投影读数、等宽数值与单位
   组件     .hint                 当前操作提示
   组件     .btn/.btns            按钮及按钮组
   组件     .ctl                  带刻度感的参数控件容器
   组件     input[type=range]     参数滑杆及活动、禁用状态
   组件     .tag                  直角文字标记
   组件     .legend/.li/.sw       图例项、色块与线型样本
   组件     .cvbox                媒体或 Canvas 的定位裁切容器
   组件     .quiz/.opt/.fb        作答区、选项与反馈
   组件     .lead/.small/.note    导语、次级正文与实验注记
   组件     .panel/.panel.q       填色仪器容器与不填色安静容器
   组件     .neuron/.layer        圆角六边形神经元与竖列网络层
   组件     .backdrop             整页氛围图
   组件     .backdrop-note        氛围图来源或说明
   ==== /INTERFACE ==== */

:root { --pad-x: 56px; --pad-y: 28px; }

:root {
  --bg: #F4F1E8;
  --text: #20242A;
  --muted: #62666B;
  --line: #85898D;
  --line-soft: #C8C6BE;
  --surface: #FAF8F2;
  --model: #2457A6;
  --attention: #E56B2F;
  --focus: #E56B2F;

  --font-sans: "Noto Sans CJK SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  --font-serif: "Noto Serif CJK SC", "Source Han Serif SC", "Songti SC", serif;
  --font-mono: "JetBrains Mono", "Cascadia Mono", "SFMono-Regular", Consolas, monospace;

  --fs-h1: 38px;
  --fs-h2: 25px;
  --fs-lead: 21px;
  --fs-body: 18px;
  --fs-sec: 16px;
  --fs-label: 15px;
  --fs-tick: 13px;

  --rule: 2px;
  --rule-strong: 4px;
  --control-radius: 12px;
}

#stage { display: flex; flex-direction: column; padding: var(--pad-y) var(--pad-x); }

#stage {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  color: var(--text);
  background: var(--bg);
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.45;
}

#stage *,
#stage *::before,
#stage *::after {
  box-sizing: border-box;
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1 {
  color: var(--text);
  font-family: var(--font-sans);
  font-size: var(--fs-h1);
  font-weight: 760;
  line-height: 1.16;
  letter-spacing: -0.02em;
}

h2 {
  color: var(--text);
  font-size: var(--fs-h2);
  font-weight: 740;
  line-height: 1.22;
}

h3 {
  color: var(--text);
  font-size: var(--fs-lead);
  font-weight: 700;
  line-height: 1.28;
}

p,
li,
dd,
dt {
  font-size: var(--fs-body);
  line-height: 1.45;
}

.title-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.kicker {
  margin: 0 0 8px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.opening-claim {
  max-width: 34em;
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 29px;
  font-weight: 650;
  line-height: 1.42;
}

/* 版式 */

.canvas-full,
.focus,
.ledger,
.split-lr,
.split-tb,
.stage-cards,
.triptych {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.canvas-full {
  position: relative;
  display: block;
  width: 100%;
  overflow: hidden;
}

.focus {
  display: grid;
  place-items: center;
  position: relative;
}

.focus > * {
  min-width: 0;
  max-width: 100%;
}

.ledger {
  display: grid;
  grid-auto-rows: minmax(0, auto);
  align-content: start;
  border-top: var(--rule-strong) solid var(--text);
  border-bottom: var(--rule) solid var(--line);
}

.ledger > * {
  min-width: 0;
  border-bottom: 1px solid var(--line-soft);
}

.ledger > *:last-child {
  border-bottom: 0;
}

.split-lr {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.split-lr > * {
  min-width: 0;
  min-height: 0;
}

.split-lr > * + * {
  border-left: var(--rule) solid var(--line);
}

.split-tb {
  display: grid;
  grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
}

.split-tb > * {
  min-width: 0;
  min-height: 0;
}

.split-tb > * + * {
  border-top: var(--rule) solid var(--line);
}

.stage-cards {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  align-items: stretch;
}

.stage-cards > * {
  position: relative;
  min-width: 0;
  min-height: 0;
  border: var(--rule) solid var(--line);
}

.stage-cards > * + * {
  border-left: 0;
}

.triptych {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
}

.triptych > * {
  min-width: 0;
  min-height: 0;
}

.triptych > * + * {
  border-left: var(--rule) solid var(--line);
}

/* 过程骨架 */

.k-process {
  position: relative;
  display: flex;
  align-items: stretch;
  min-width: 0;
}

.k-process .step {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  min-width: 0;
  border: var(--rule) solid var(--line);
  padding: 16px;
}

.k-process .step.is-current,
.k-process .step[aria-current="step"] {
  border: var(--rule-strong) solid var(--attention);
}

.k-process .step-no {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 750;
  line-height: 1.35;
}

.k-process .arw {
  position: relative;
  flex: 0 0 68px;
  align-self: center;
  height: 18px;
  color: var(--model);
}

.k-process .arw::before {
  content: "";
  position: absolute;
  left: 2px;
  right: 11px;
  top: 8px;
  border-top: 3px solid currentColor;
}

.k-process .arw::after {
  content: "";
  position: absolute;
  right: 2px;
  top: 3px;
  width: 11px;
  height: 11px;
  border-top: 3px solid currentColor;
  border-right: 3px solid currentColor;
  transform: rotate(45deg);
}

.k-process .arw.back {
  color: var(--attention);
}

.k-process .arw.back::before {
  left: 10px;
  right: 2px;
  top: 5px;
  height: 9px;
  border-top: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
}

.k-process .arw.back::after {
  left: 2px;
  right: auto;
  top: 3px;
  border: 0;
  border-bottom: 3px double currentColor;
  border-left: 3px double currentColor;
  transform: rotate(45deg);
}

.k-process .axis {
  position: absolute;
  z-index: 0;
  left: 0;
  right: 0;
  top: 50%;
  height: 0;
  border-top: 3px solid var(--model);
}

.k-process .axis::after {
  content: "";
  position: absolute;
  right: -1px;
  top: -7px;
  width: 12px;
  height: 12px;
  border-top: 3px solid var(--model);
  border-right: 3px solid var(--model);
  transform: rotate(45deg);
}

.k-process.is-backward .axis {
  height: 8px;
  border-top: 2px solid var(--attention);
  border-bottom: 2px solid var(--attention);
}

.k-process.is-backward .axis::after {
  left: -1px;
  right: auto;
  top: -6px;
  border: 0;
  border-bottom: 3px double var(--attention);
  border-left: 3px double var(--attention);
}

/* 比较骨架 */

.k-comparison {
  display: grid;
  min-width: 0;
  border-top: var(--rule-strong) solid var(--text);
  border-bottom: var(--rule) solid var(--line);
}

.k-comparison .hdr,
.k-comparison .rowline {
  display: grid;
  grid-template-columns: var(--comparison-cols, minmax(180px, 0.8fr) repeat(2, minmax(0, 1fr)));
  align-items: baseline;
  min-width: 0;
}

.k-comparison .hdr {
  color: var(--muted);
  font-size: var(--fs-label);
  font-weight: 720;
  line-height: 1.35;
  border-bottom: var(--rule) solid var(--line);
}

.k-comparison .rowline {
  font-size: var(--fs-body);
  line-height: 1.4;
  border-bottom: 1px solid var(--line-soft);
}

.k-comparison .rowline:last-child {
  border-bottom: 0;
}

.k-comparison .hdr > *,
.k-comparison .rowline > * {
  min-width: 0;
  padding: 12px 14px;
}

.k-comparison .hdr > * + *,
.k-comparison .rowline > * + * {
  border-left: 1px solid var(--line-soft);
}

.k-comparison .dim {
  color: var(--muted);
  font-weight: 650;
}

.k-comparison .diff {
  color: var(--text);
  font-weight: 780;
  outline: 2px solid var(--attention);
  outline-offset: -4px;
}

/* 分类骨架 */

.k-classification {
  position: relative;
  min-width: 0;
}

.k-classification .lv {
  position: relative;
  min-width: 0;
  padding-left: 28px;
}

.k-classification > .lv {
  padding-left: 0;
}

.k-classification .lv .lv {
  margin: 12px 0 0 24px;
  border-left: var(--rule) solid var(--line);
}

.k-classification .box {
  position: relative;
  min-width: 0;
  border: var(--rule) solid var(--line);
  padding: 13px 16px;
}

.k-classification .bt {
  position: absolute;
  left: 0;
  top: 25px;
  width: 28px;
  border-top: var(--rule) solid var(--line);
}

.k-classification .lv.is-current > .box {
  border: var(--rule-strong) solid var(--attention);
}

/* 归纳骨架 */

.k-generalization {
  position: relative;
  min-width: 0;
}

.k-generalization .claim {
  position: relative;
  z-index: 1;
  border: var(--rule-strong) solid var(--text);
  padding: 17px 20px;
  color: var(--text);
  font-size: var(--fs-lead);
  font-weight: 780;
  line-height: 1.4;
}

.k-generalization .trunk {
  position: relative;
  width: var(--trunk-width, 72%);
  height: 32px;
  margin: 0 auto;
  border-left: var(--rule) solid var(--line);
  border-right: var(--rule) solid var(--line);
  border-bottom: var(--rule) solid var(--line);
}

.k-generalization .supports {
  display: grid;
  grid-template-columns: repeat(var(--support-count, 3), minmax(0, 1fr));
  align-items: start;
}

.k-generalization .support {
  position: relative;
  min-width: 0;
  padding: 18px 16px 0;
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.45;
}

.k-generalization .support::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  height: 14px;
  border-left: var(--rule) solid var(--line);
}

/* 数值 */

.big,
.num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums lining-nums;
}

.big {
  color: var(--text);
  font-size: 54px;
  font-weight: 760;
  line-height: 1;
  letter-spacing: -0.045em;
}

.big.sm {
  font-size: 38px;
}

.big.lg {
  font-size: 72px;
}

.num {
  white-space: nowrap;
  font-weight: 700;
}

.num.model {
  color: var(--model);
}

.num.attention {
  color: var(--attention);
}

.unit {
  margin-left: 0.25em;
  color: var(--muted);
  font-family: var(--font-sans);
  font-size: 0.42em;
  font-weight: 650;
  letter-spacing: 0;
}

/* 控件 */

.hint {
  color: var(--attention);
  font-size: var(--fs-label);
  font-weight: 740;
  line-height: 1.4;
}

.btns {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.btn {
  appearance: none;
  min-height: 44px;
  border: var(--rule) solid var(--text);
  border-radius: var(--control-radius);
  padding: 9px 16px;
  color: var(--text);
  background: var(--surface);
  font: 720 var(--fs-label)/1.35 var(--font-sans);
  cursor: pointer;
}

.btn:hover {
  border-color: var(--attention);
}

.btn:active,
.btn.is-selected,
.btn[aria-pressed="true"] {
  border: var(--rule-strong) solid var(--attention);
  padding: 7px 14px;
  color: var(--text);
}

.btn:focus-visible {
  outline: 4px solid var(--focus);
  outline-offset: 3px;
}

.btn:disabled,
.btn[aria-disabled="true"] {
  border-color: var(--line-soft);
  color: var(--muted);
  background: var(--bg);
  cursor: not-allowed;
  opacity: 0.62;
}

.ctl {
  position: relative;
  min-width: 0;
  border: var(--rule) solid var(--line);
  border-radius: var(--control-radius);
  padding: 16px;
  background:
    linear-gradient(90deg, transparent 0 7px, var(--line-soft) 7px 8px, transparent 8px) left 12px bottom 9px / 24px 6px repeat-x,
    var(--surface);
}

.ctl:focus-within,
.ctl.is-active {
  border: var(--rule-strong) solid var(--attention);
  padding: 14px;
}

.ctl > label {
  display: block;
  margin-bottom: 10px;
  color: var(--text);
  font-size: var(--fs-label);
  font-weight: 720;
  line-height: 1.35;
}

.ctl output {
  color: var(--attention);
  font-family: var(--font-mono);
  font-size: var(--fs-body);
  font-weight: 760;
  font-variant-numeric: tabular-nums;
}

input[type="range"] {
  appearance: none;
  width: 100%;
  height: 32px;
  margin: 5px 0 12px;
  background: transparent;
  cursor: pointer;
}

input[type="range"]::-webkit-slider-runnable-track {
  height: 4px;
  border: 1px solid var(--line);
  background: var(--bg);
}

input[type="range"]::-moz-range-track {
  height: 4px;
  border: 1px solid var(--line);
  background: var(--bg);
}

input[type="range"]::-webkit-slider-thumb {
  appearance: none;
  width: 22px;
  height: 22px;
  margin-top: -10px;
  border: 4px solid var(--attention);
  border-radius: 50%;
  background: var(--surface);
}

input[type="range"]::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border: 4px solid var(--attention);
  border-radius: 50%;
  background: var(--surface);
}

input[type="range"]:focus-visible {
  outline: 4px solid var(--focus);
  outline-offset: 4px;
}

input[type="range"]:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

input[type="range"]:disabled::-webkit-slider-thumb {
  border-color: var(--line);
}

input[type="range"]:disabled::-moz-range-thumb {
  border-color: var(--line);
}

/* 标记与图例 */

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  border: 1px solid var(--line);
  padding: 4px 8px;
  color: var(--text);
  background: transparent;
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: 1.35;
}

.tag.is-current {
  border: 3px solid var(--attention);
  padding: 2px 6px;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.legend > .li {
  display: inline-flex;
  align-items: center;
  color: var(--muted);
  font-size: var(--fs-label);
  line-height: 1.35;
}

.legend > .li > .sw {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  margin-right: 7px;
  border: 2px solid currentColor;
  background: currentColor;
}

.legend > .li > .sw.line {
  width: 28px;
  height: 8px;
  border: 0;
  border-top: 3px solid currentColor;
  background: transparent;
}

.legend > .li > .sw.line.back {
  height: 10px;
  border-top: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
}

.sw.model {
  color: var(--model);
}

.sw.attention {
  color: var(--attention);
}

.sw.neutral {
  color: var(--line);
}

/* 媒体 */

.cvbox {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border-radius: 4px;
}

.cvbox > canvas,
.cvbox > img,
.cvbox > video,
.cvbox > svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.backdrop {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.18;
  pointer-events: none;
}

.backdrop::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(244, 241, 232, 0.78);
}

img.backdrop {
  filter: grayscale(0.35) contrast(0.9);
}

.backdrop-note {
  position: absolute;
  z-index: 2;
  right: var(--pad-x);
  bottom: 10px;
  max-width: 34em;
  color: var(--muted);
  font-size: var(--fs-label);
  line-height: 1.35;
}

/* 作答 */

.quiz {
  min-width: 0;
  border-top: var(--rule-strong) solid var(--text);
  padding-top: 14px;
}

.opt {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-height: 46px;
  border: var(--rule) solid var(--line);
  border-radius: var(--control-radius);
  padding: 10px 14px;
  color: var(--text);
  background: transparent;
  font: 650 var(--fs-body)/1.4 var(--font-sans);
  text-align: left;
  cursor: pointer;
}

.opt + .opt {
  margin-top: 10px;
}

.opt:hover {
  border-color: var(--attention);
}

.opt.is-selected,
.opt[aria-checked="true"] {
  border: var(--rule-strong) solid var(--attention);
  padding: 8px 12px;
}

.opt.is-correct {
  outline: 4px double var(--text);
  outline-offset: 3px;
  font-weight: 780;
}

.opt.is-incorrect {
  border-style: dashed;
}

.opt.is-selected.is-correct,
.opt[aria-checked="true"].is-correct {
  border-color: var(--attention);
  outline-color: var(--text);
}

.opt:focus-visible {
  outline: 4px solid var(--focus);
  outline-offset: 3px;
}

.opt:disabled,
.opt[aria-disabled="true"] {
  color: var(--muted);
  border-color: var(--line-soft);
  cursor: not-allowed;
  opacity: 0.65;
}

.fb {
  min-height: 24px;
  margin-top: 12px;
  color: var(--text);
  font-size: var(--fs-sec);
  font-weight: 650;
  line-height: 1.45;
}

.fb.is-attention {
  color: var(--attention);
}

/* 文字 */

.lead {
  color: var(--text);
  font-size: var(--fs-lead);
  font-weight: 620;
  line-height: 1.45;
}

.small {
  color: var(--muted);
  font-size: var(--fs-sec);
  line-height: 1.45;
}

.note {
  color: var(--muted);
  font-size: var(--fs-sec);
  line-height: 1.45;
}

.note::before {
  content: "修订 ";
  font-family: var(--font-mono);
  font-size: var(--fs-label);
  font-weight: 750;
}

/* 仪器表面 */

.panel {
  min-width: 0;
  border: var(--rule) solid var(--line);
  padding: 18px;
  background: var(--surface);
}

.panel.q {
  background: transparent;
}

.panel.is-current {
  border: var(--rule-strong) solid var(--attention);
  padding: 16px;
}

/* 网络图元 */

.layer {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  border-left: var(--rule) solid var(--line-soft);
  border-right: var(--rule) solid var(--line-soft);
}

.neuron {
  position: relative;
  display: grid;
  place-items: center;
  min-width: 112px;
  min-height: 68px;
  border: var(--rule) solid var(--line);
  border-radius: 14px;
  padding: 10px 18px;
  background: var(--bg);
  clip-path: polygon(12% 0, 88% 0, 100% 28%, 100% 72%, 88% 100%, 12% 100%, 0 72%, 0 28%);
  font-size: var(--fs-label);
  font-weight: 720;
  line-height: 1.35;
  text-align: center;
}

.neuron::before,
.neuron::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 16px;
  border-top: var(--rule) solid var(--line);
}

.neuron::before {
  right: 100%;
}

.neuron::after {
  left: 100%;
}

.neuron.is-forward {
  border-color: var(--model);
}

.neuron.is-current {
  border: var(--rule-strong) solid var(--attention);
}

/* 打印与动效 */

@media print {
  #stage {
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
}

svg .bar, svg .step, svg .cell, svg .box, svg .arw { width:auto; height:auto; }