{
  "schema_version": "notale_style_lab.v1",
  "_note": "Each cell is one style recipe worth comparing. Every cell renders locally in a headless browser, so there is no spend gate and no dry-run mode: the default is simply to run it.",
  "compare_hints": [
    "L1 vs L2: the same palette under fork_patch vs derived from prose",
    "L3 vs L4: a light editorial ground vs a dark technical one",
    "L5: a deliberately narrow type scale, to prove type_scale_conformance bites",
    "L6: an unreadable palette, to prove the contrast fallback catches it"
  ],
  "cells": [
    {
      "id": "L1_patch_warm",
      "build": "fork_patch",
      "pack_id": "lab-warm-red",
      "parent": "notale-default",
      "label": "Warm red, round, sparse",
      "patch": {
        "identity": {
          "notale_tokens": {
            "bg": "#FFF7F3",
            "surface": "#FFFFFF",
            "ink": "#2A1512",
            "muted": "#6E5A55",
            "accent": "#C53030",
            "accent-2": "#DD6B20",
            "accent-3": "#9B2C2C",
            "line": "#E6D2CB"
          },
          "radius_scale": "round"
        },
        "density_default": "classroom_sparse"
      },
      "contrast": "warm classroom skin over the neutral default"
    },
    {
      "id": "L2_from_text_warm",
      "build": "from_text",
      "pack_id": "lab-text-warm",
      "parent": "notale-default",
      "text": "暖红课堂风格，主色 #C53030，强调 #DD6B20，大圆角，稀疏留白",
      "contrast": "the same intent expressed as prose rather than a patch"
    },
    {
      "id": "L3_preset_editorial",
      "build": "preset",
      "pack_id": "paper-and-ink",
      "contrast": "a light editorial serif ground"
    },
    {
      "id": "L4_preset_technical",
      "build": "preset",
      "pack_id": "technical-world",
      "contrast": "a technical direction, same page roles"
    },
    {
      "id": "L5_narrow_scale",
      "build": "fork_patch",
      "pack_id": "lab-narrow-scale",
      "parent": "swiss-modern",
      "label": "Narrow type scale",
      "patch": {
        "type_scale": {
          "roles": {
            "title": {"min_px": 40, "preferred_vw": 3.6, "max_px": 46, "line_height": 1.15, "letter_spacing_em": 0.02, "bold": true, "color_role": "ink"},
            "banner": {"min_px": 24, "preferred_vw": 2.4, "max_px": 30, "line_height": 1.2, "bold": true, "color_role": "ink"},
            "lede": {"min_px": 18, "preferred_vw": 1.6, "max_px": 22, "line_height": 1.45, "color_role": "muted"},
            "card": {"min_px": 16, "preferred_vw": 1.4, "max_px": 20, "line_height": 1.4, "color_role": "ink"},
            "cell": {"min_px": 12, "preferred_vw": 1.1, "max_px": 15, "line_height": 1.3, "color_role": "ink"}
          }
        }
      },
      "contrast": "specimens set an 88px title, so a 46px ceiling must be reported"
    },
    {
      "id": "L6_unreadable_palette",
      "build": "fork_patch",
      "pack_id": "lab-unreadable",
      "parent": "swiss-modern",
      "label": "Unreadable on purpose",
      "patch": {
        "identity": {
          "notale_tokens": {"bg": "#FFFFFF", "ink": "#FAFAFA"}
        }
      },
      "contrast": "the contrast fallback should replace this with the parent's palette"
    }
  ]
}
