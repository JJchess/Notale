{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notale.local/schemas/style_pack.schema.json",
  "title": "StylePack",
  "description": "Versioned visual style asset for notale. Ported field-for-field from deckbase so packs move between the two systems without loss. notale compiles identity.notale_tokens + skill_body + compositions into executable CSS and a Builder-facing design Skill, and materializes mascot_policy assets into deterministic run-local HTML decorations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "version",
    "status",
    "provenance",
    "audience_hint",
    "identity",
    "chrome_rules",
    "role_exemplars",
    "density_default",
    "prompt_compile",
    "hard_negatives",
    "acceptance_hooks",
    "skill_body",
    "compositions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable pack identifier. notale slug rules (hyphens) rather than deckbase underscores, because the id also becomes the run-local design Skill name."
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preview_ok",
        "published",
        "deprecated"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "preset",
        "from_images",
        "from_pptx",
        "from_pdf",
        "from_text",
        "from_topic",
        "hybrid"
      ]
    },
    "audience_hint": {
      "type": "string",
      "enum": [
        "elementary",
        "academic",
        "general"
      ],
      "description": "Selection hint only; does not fork the plan."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_tokens",
        "notale_tokens"
      ],
      "properties": {
        "style_tokens": {
          "type": "object",
          "description": "deckbase abstract palette. Kept for interchange; notale renders notale_tokens instead.",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "background": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "window": {
              "type": "string"
            },
            "frame": {
              "type": "string"
            }
          }
        },
        "notale_tokens": {
          "type": "object",
          "description": "The eleven CSS custom properties notale actually emits into :root. Fonts must be exact IDs from the offline catalog.",
          "additionalProperties": false,
          "required": [
            "bg",
            "surface",
            "ink",
            "muted",
            "accent",
            "accent-2",
            "accent-3",
            "line",
            "font-display",
            "font-body",
            "font-mono"
          ],
          "properties": {
            "bg": {
              "type": "string"
            },
            "surface": {
              "type": "string"
            },
            "ink": {
              "type": "string"
            },
            "muted": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "accent-2": {
              "type": "string"
            },
            "accent-3": {
              "type": "string"
            },
            "line": {
              "type": "string"
            },
            "font-display": {
              "type": "string"
            },
            "font-body": {
              "type": "string"
            },
            "font-mono": {
              "type": "string"
            }
          }
        },
        "radius_scale": {
          "type": "string",
          "enum": [
            "sharp",
            "soft",
            "round"
          ],
          "description": "Qualitative corner language."
        },
        "type_hints": {
          "type": "string",
          "description": "Optional typography dialect note."
        }
      }
    },
    "skill_body": {
      "type": "string",
      "minLength": 1,
      "description": "Complete Builder-facing design Skill markdown, including the 1280x720 scale/spacing recipe and component grammar."
    },
    "compositions": {
      "type": "array",
      "minItems": 1,
      "description": "notale CompositionSpec catalog. Validated by core.models.CompositionSpec.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "primary",
          "page_types",
          "use_when",
          "spatial_logic",
          "dominant_carrier",
          "text_role",
          "variation",
          "avoid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "primary": {
            "type": "string"
          },
          "secondary": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "use_when": {
            "type": "string",
            "minLength": 1
          },
          "spatial_logic": {
            "type": "string",
            "minLength": 1
          },
          "dominant_carrier": {
            "type": "string",
            "minLength": 1
          },
          "text_role": {
            "type": "string",
            "minLength": 1
          },
          "variation": {
            "type": "string",
            "minLength": 1
          },
          "avoid": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chrome_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialect",
        "forbidden_effects"
      ],
      "properties": {
        "dialect": {
          "type": "string"
        },
        "forbidden_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "role_exemplars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cover",
        "section",
        "content",
        "closing"
      ],
      "description": "Paths relative to the pack directory. In notale these are real 1280x720 slides rendered from this pack, used as the visual baseline during inspection.",
      "properties": {
        "cover": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "closing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "density_default": {
      "type": "string"
    },
    "prompt_compile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_prose",
        "style_anchor"
      ],
      "description": "deckbase compiled prompt cache. notale uses style_prose as the Skill description; style_anchor is carried for interchange only.",
      "properties": {
        "style_prose": {
          "type": "string"
        },
        "style_anchor": {
          "type": "string"
        }
      }
    },
    "hard_negatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Banned visual moves, unioned with chrome_rules.forbidden_effects at compile time."
    },
    "acceptance_hooks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Style QA clause IDs surfaced to the page inspector."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "parent_preset_id": {
          "type": "string"
        },
        "legacy_profile_key": {
          "type": "string"
        },
        "source_asset_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "extractors": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved for StyleBuild extractors."
    },
    "or_hints": {
      "type": "object",
      "additionalProperties": true,
      "description": "deckbase image-backend hints. Carried for interchange; notale does not render from them.",
      "properties": {
        "aspect_ratio": {
          "type": "string"
        },
        "exemplars_optional": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "layout_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Advisory layout bias. In notale it biases composition selection; it never overrides an assigned composition.",
      "properties": {
        "default_family": {
          "type": "string",
          "enum": [
            "window_focus",
            "left_action_right_material",
            "full_width_material",
            "observe_split"
          ]
        },
        "by_page_role": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cover": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "closing": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "mascot_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Decorative asset policy. notale content-addresses these assets into style_refs, selects them by page role/family, and injects them into the measured HTML page.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "corner_accent",
            "side_character"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "family_id": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "placement_hint": {
                    "type": "string"
                  },
                  "usage": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "selection": {
          "type": "string",
          "enum": [
            "all",
            "rotate_by_page"
          ]
        },
        "max_area_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "roles_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "info_form_bias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "type_scale": {
      "type": "object",
      "description": "Per-pack typographic bands, compiled to CSS clamp(). Absent means the default sanity envelope in core.models.DEFAULT_TYPE_SCALE. Validated by core.models.TypeScale.",
      "additionalProperties": false,
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_px",
                "preferred_vw",
                "max_px",
                "line_height"
              ],
              "properties": {
                "min_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "preferred_vw": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 2.4
                },
                "letter_spacing_em": {
                  "type": "number"
                },
                "bold": {
                  "type": "boolean"
                },
                "color_role": {
                  "type": "string",
                  "enum": [
                    "ink",
                    "muted",
                    "accent",
                    "accent-2",
                    "accent-3"
                  ]
                }
              }
            },
            "lede": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_px",
                "preferred_vw",
                "max_px",
                "line_height"
              ],
              "properties": {
                "min_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "preferred_vw": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 2.4
                },
                "letter_spacing_em": {
                  "type": "number"
                },
                "bold": {
                  "type": "boolean"
                },
                "color_role": {
                  "type": "string",
                  "enum": [
                    "ink",
                    "muted",
                    "accent",
                    "accent-2",
                    "accent-3"
                  ]
                }
              }
            },
            "banner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_px",
                "preferred_vw",
                "max_px",
                "line_height"
              ],
              "properties": {
                "min_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "preferred_vw": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 2.4
                },
                "letter_spacing_em": {
                  "type": "number"
                },
                "bold": {
                  "type": "boolean"
                },
                "color_role": {
                  "type": "string",
                  "enum": [
                    "ink",
                    "muted",
                    "accent",
                    "accent-2",
                    "accent-3"
                  ]
                }
              }
            },
            "card": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_px",
                "preferred_vw",
                "max_px",
                "line_height"
              ],
              "properties": {
                "min_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "preferred_vw": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 2.4
                },
                "letter_spacing_em": {
                  "type": "number"
                },
                "bold": {
                  "type": "boolean"
                },
                "color_role": {
                  "type": "string",
                  "enum": [
                    "ink",
                    "muted",
                    "accent",
                    "accent-2",
                    "accent-3"
                  ]
                }
              }
            },
            "cell": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_px",
                "preferred_vw",
                "max_px",
                "line_height"
              ],
              "properties": {
                "min_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "preferred_vw": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 2.4
                },
                "letter_spacing_em": {
                  "type": "number"
                },
                "bold": {
                  "type": "boolean"
                },
                "color_role": {
                  "type": "string",
                  "enum": [
                    "ink",
                    "muted",
                    "accent",
                    "accent-2",
                    "accent-3"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
