<style>
[data-notale-widget-root]{width:100%;height:100%;min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);gap:12px;padding:16px;background:var(--notale-bg);color:var(--notale-ink);border:1px solid var(--notale-line);border-radius:var(--notale-radius-lg);overflow:hidden}
.ncr-head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:16px}.ncr-title{font-size:22px;font-weight:720;letter-spacing:-.02em}.ncr-instruction{margin-top:4px;color:var(--notale-muted);font-size:14px;line-height:1.4;max-width:68ch}.ncr-actions{display:flex;gap:8px}.ncr-button{border:1px solid var(--notale-line);border-radius:9px;padding:8px 14px;background:var(--notale-surface);color:var(--notale-ink);cursor:pointer;transition:transform .15s ease,border-color .15s ease,background .15s ease}.ncr-button:hover{border-color:var(--notale-accent)}.ncr-button:active{transform:scale(.97)}.ncr-button.primary{background:var(--notale-accent);border-color:var(--notale-accent);color:var(--notale-bg);font-weight:700}
.ncr-workspace{min-height:0;display:grid;grid-template-columns:minmax(0,1.18fr) minmax(260px,.82fr);gap:12px}.ncr-editor,.ncr-results{min-width:0;min-height:0;border:1px solid var(--notale-line);border-radius:12px;background:var(--notale-surface);overflow:hidden}.ncr-editor{display:grid;grid-template-rows:30px minmax(0,1fr)}.ncr-filebar{display:flex;align-items:center;padding:0 12px;border-bottom:1px solid var(--notale-line);font:12px var(--notale-mono);color:var(--notale-muted)}textarea{display:block;width:100%;height:100%;min-height:0;resize:none;border:0;outline:0;padding:14px;background:transparent;color:var(--notale-ink);font:13px/1.55 var(--notale-mono);tab-size:2}.ncr-results{display:grid;grid-template-rows:auto minmax(0,1fr)}.ncr-result-head{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-bottom:1px solid var(--notale-line);font-size:13px;font-weight:700}.ncr-status{font:12px var(--notale-mono);color:var(--notale-muted)}.ncr-list{min-height:0;display:grid;align-content:start;gap:8px;padding:10px;overflow:hidden}.ncr-case{display:grid;grid-template-columns:18px minmax(0,1fr);gap:8px;align-items:start;padding:9px;border:1px solid var(--notale-line);border-radius:9px}.ncr-mark{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;background:var(--notale-bg);color:var(--notale-muted);font-size:11px}.ncr-case.pass .ncr-mark{background:var(--notale-accent);color:var(--notale-bg)}.ncr-case.fail .ncr-mark{background:var(--notale-accent-2);color:var(--notale-bg)}.ncr-name{font-size:13px;font-weight:650}.ncr-detail{margin-top:3px;color:var(--notale-muted);font:11px/1.35 var(--notale-mono);overflow-wrap:anywhere}
</style>
<section data-notale-widget-root aria-label="__NOTALE_TITLE__">
  <header class="ncr-head"><div><div class="ncr-title">__NOTALE_TITLE__</div><div class="ncr-instruction">__NOTALE_INSTRUCTION__</div></div><div class="ncr-actions"><button class="ncr-button" type="button" data-action="reset">__NOTALE_RESET_LABEL__</button><button class="ncr-button primary" type="button" data-action="run">__NOTALE_RUN_LABEL__</button></div></header>
  <div class="ncr-workspace"><div class="ncr-editor"><div class="ncr-filebar">solution.js · solve(input)</div><textarea aria-label="JavaScript editor" spellcheck="false"></textarea></div><section class="ncr-results"><header class="ncr-result-head"><span>__NOTALE_TESTS_LABEL__</span><output class="ncr-status" aria-live="polite"></output></header><div class="ncr-list"></div></section></div>
</section>
<script>
(()=>{"use strict";const starter=__NOTALE_STARTER__;const fixtures=__NOTALE_FIXTURES__;const labels=__NOTALE_LABELS__;const editor=document.querySelector("textarea");const list=document.querySelector(".ncr-list");const status=document.querySelector(".ncr-status");let worker=null;let timer=0;editor.value=starter;const canonical=value=>{if(Array.isArray(value))return value.map(canonical);if(value&&typeof value==="object")return Object.fromEntries(Object.keys(value).sort().map(key=>[key,canonical(value[key])]));return value};const same=(a,b)=>JSON.stringify(canonical(a))===JSON.stringify(canonical(b));const detail=value=>{try{return JSON.stringify(value)}catch{return String(value)}};function update(results,message){list.replaceChildren();let passed=0;fixtures.forEach((fixture,index)=>{const result=results&&results[index];const ok=!!result&&result.ok&&same(result.value,fixture.expected);if(ok)passed++;const row=document.createElement("div");row.className=`ncr-case ${ok?"pass":"fail"}`;const mark=document.createElement("span");mark.className="ncr-mark";mark.textContent=ok?"✓":"×";const copy=document.createElement("div");const name=document.createElement("div");name.className="ncr-name";name.textContent=fixture.name;const info=document.createElement("div");info.className="ncr-detail";info.textContent=result?(result.ok?`got ${detail(result.value)} · expected ${detail(fixture.expected)}`:result.error):"not run";copy.append(name,info);row.append(mark,copy);list.append(row)});status.textContent=message||`${passed}/${fixtures.length} · ${passed===fixtures.length?labels.passed:labels.failed}`}
function workerSource(source){return `"use strict";\nconst __solve=(()=>{\n${source}\nreturn typeof solve==="function"?solve:null;\n})();\nif(!__solve)throw new Error("solve(input) is missing");\nself.onmessage=event=>{const fixtures=event.data;Promise.all(fixtures.map(async fixture=>{try{return {ok:true,value:await __solve(fixture.input)}}catch(error){return {ok:false,error:String(error&&error.message||error)}}})).then(results=>self.postMessage(results));};`}
function runCode(){if(worker)worker.terminate();clearTimeout(timer);status.textContent=labels.ready;const url=URL.createObjectURL(new Blob([workerSource(editor.value)],{type:"text/javascript"}));try{worker=new Worker(url);worker.onmessage=event=>{clearTimeout(timer);worker.terminate();worker=null;URL.revokeObjectURL(url);update(event.data)};worker.onerror=event=>{clearTimeout(timer);worker.terminate();worker=null;URL.revokeObjectURL(url);update(fixtures.map(()=>({ok:false,error:event.message||"runtime error"})))};worker.postMessage(fixtures);timer=setTimeout(()=>{if(worker)worker.terminate();worker=null;URL.revokeObjectURL(url);update(fixtures.map(()=>({ok:false,error:labels.timeout})),labels.timeout)},1200)}catch(error){URL.revokeObjectURL(url);update(fixtures.map(()=>({ok:false,error:String(error)})))}}
document.querySelector('[data-action="run"]').addEventListener("click",runCode);document.querySelector('[data-action="reset"]').addEventListener("click",()=>{editor.value=starter;runCode()});update(null,labels.ready);setTimeout(runCode,0)})();
</script>
