          "type": "material",
          "title": "交互模拟：复制叉动态 — 前导链与后随链",
          "order": 2,
          "metadata": {
            "materialType": "html",
            "html": "<style>\n.replifork-root { font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", sans-serif; background: var(--color-background-primary, #fff); color: var(--color-text-primary, #222); padding: 16px; max-width: 760px; }\n.replifork-root h2 { font-size: 16px; font-weight: 500; margin: 0 0 12px; }\n.replifork-root canvas { display: block; border: 1px solid var(--color-border-tertiary, #d0d0d0); border-radius: var(--border-radius-md, 4px); background: var(--color-background-secondary, #fafafa); margin-bottom: 12px; width: 100%; height: auto; }\n.replifork-root .controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }\n.replifork-root button { padding: 6px 14px; border: 1px solid #bbb; border-radius: 4px; background: #f5f5f5; font-size: 13px; cursor: pointer; font-family: inherit; }\n.replifork-root button:hover { background: #e8e8e8; }\n.replifork-root button.active { background: #2563eb; color: #fff; border-color: #2563eb; }\n.replifork-root .legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12px; margin-bottom: 8px; }\n.replifork-root .legend-item { display: flex; align-items: center; gap: 4px; }\n.replifork-root .legend-dot { width: 10px; height: 10px; border-radius: 2px; }\n.replifork-root .status { font-size: 13px; color: var(--color-text-secondary, #555); min-height: 20px; }\n.replifork-root .speed-label { font-size: 12px; color: #888; margin-left: 8px; }\n</style>\n<div class=\"replifork-root\">\n<h2>复制叉动态模拟 — 前导链与后随链</h2>\n<div class=\"legend\">\n  <div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:#1a73e8\"></span> 前导链 (连续合成)</div>\n  <div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:#e37400\"></span> 后随链 (冈崎片段)</div>\n  <div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:#999\"></span> 亲代模板链</div>\n  <div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:#ea4335\"></span> RNA 引物</div>\n  <div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:#34a853\"></span> 解旋酶</div>\n</div>\n<div class=\"controls\">\n  <button id=\"btn-play\" class=\"active\">▶ 播放</button>\n  <button id=\"btn-pause\">⏸ 暂停</button>\n  <button id=\"btn-reset\">↺ 重置</button>\n  <span class=\"speed-label\">速率: <span id=\"speed-val\">1x</span></span>\n  <button id=\"btn-speed-down\">−</button>\n  <button id=\"btn-speed-up\">+</button>\n</div>\n<canvas id=\"replifork-canvas\" width=\"720\" height=\"380\"></canvas>\n<div class=\"status\" id=\"replifork-status\">解旋酶正在打开双螺旋... 前导链连续合成，后随链分段启动冈崎片段。</div>\n</div>\n<script>\n(function(){\nvar canvas=document.getElementById('replifork-canvas');\nvar ctx=canvas.getContext('2d');\nvar W=720,H=380;\nvar playing=true,speed=1,simTime=0;\nvar FORK_SPEED=0.4,OKAZAKI_INTERVAL=90,LEAD_SPEED=0.55;\nvar forkPos=80,leadLen=0,okazakiFragments=[],nextOkazakiAt=OKAZAKI_INTERVAL;\nfunction reset(){simTime=0;forkPos=80;leadLen=0;okazakiFragments=[];nextOkazakiAt=OKAZAKI_INTERVAL;}\nfunction update(){if(!playing)return;simTime+=speed;forkPos+=FORK_SPEED*speed;leadLen+=LEAD_SPEED*speed;for(var i=0;i<okazakiFragments.length;i++){var f=okazakiFragments[i];if(!f.done)f.len+=LEAD_SPEED*0.7*speed;if(f.len>=f.maxLen&&!f.done)f.done=true;}if(forkPos>nextOkazakiAt&&forkPos<W-100){okazakiFragments.push({startX:forkPos-8,len:12+Math.random()*8,maxLen:50+Math.random()*15,done:false,primerLen:8});nextOkazakiAt=forkPos+OKAZAKI_INTERVAL;}}\nfunction draw(){ctx.clearRect(0,0,W,H);var topY=140,botY=240;ctx.strokeStyle='#999';ctx.lineWidth=2;ctx.setLineDash([]);ctx.beginPath();ctx.moveTo(0,topY);ctx.lineTo(W,topY);ctx.stroke();ctx.beginPath();ctx.moveTo(0,botY);ctx.lineTo(W,botY);ctx.stroke();ctx.setLineDash([4,4]);ctx.strokeStyle='#ccc';ctx.beginPath();ctx.moveTo(forkPos,topY);ctx.lineTo(W,topY);ctx.stroke();ctx.beginPath();ctx.moveTo(forkPos,botY);ctx.lineTo(W,botY);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='rgba(26,115,232,0.04)';ctx.fillRect(forkPos,topY-12,W-forkPos,botY-topY+24);ctx.strokeStyle='#1a73e8';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(forkPos,topY);var leadEndX=forkPos+leadLen;ctx.lineTo(Math.min(leadEndX,W-10),topY+30);ctx.stroke();if(leadLen>0){ctx.strokeStyle='#ea4335';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(forkPos,topY);ctx.lineTo(Math.min(forkPos+10,leadEndX),topY+3);ctx.stroke();}for(var i=0;i<okazakiFragments.length;i++){var f=okazakiFragments[i];var segEndX=f.startX-f.len;ctx.strokeStyle='#e37400';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(f.startX,botY);ctx.lineTo(Math.max(segEndX,f.startX-f.len+f.primerLen),botY-30);ctx.stroke();ctx.strokeStyle='#ea4335';ctx.lineWidth=3;ctx.beginPath();var psx=f.startX-f.len+f.primerLen;ctx.moveTo(Math.max(psx,0),botY-30*(1-Math.max(0,f.primerLen)/f.len));ctx.lineTo(Math.max(segEndX,0),botY-30);ctx.stroke();}var hx=forkPos,hy=(topY+botY)/2;ctx.fillStyle='#34a853';ctx.beginPath();ctx.moveTo(hx,hy-12);ctx.lineTo(hx+10,hy);ctx.lineTo(hx,hy+12);ctx.lineTo(hx-10,hy);ctx.closePath();ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 10px sans-serif';ctx.textAlign='center';ctx.fillText('解旋酶',hx,hy+4);ctx.textAlign='start';ctx.fillStyle='#1a73e8';ctx.font='bold 12px \"PingFang SC\",sans-serif';ctx.fillText('前导链 (5\\'→3\\' 连续合成)',forkPos+12,topY+46);var lastF=okazakiFragments.length>0?okazakiFragments[okazakiFragments.length-1]:null;var lx=lastF?Math.max(lastF.startX-lastF.len-10,10):forkPos+12;ctx.fillStyle='#e37400';ctx.fillText('后随链 (冈崎片段)',lx,botY-42);ctx.strokeStyle='#555';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(forkPos-24,hy);ctx.lineTo(forkPos-6,hy);ctx.moveTo(forkPos-10,hy-5);ctx.lineTo(forkPos-6,hy);ctx.lineTo(forkPos-10,hy+5);ctx.stroke();ctx.fillStyle='#999';ctx.font='11px \"PingFang SC\",sans-serif';ctx.fillText('亲代模板 (3\\'→5\\')',W-180,topY-8);ctx.fillText('亲代模板 (5\\'→3\\')',W-180,botY+16);var nDone=okazakiFragments.filter(function(f){return f.done;}).length;document.getElementById('replifork-status').textContent='复制叉位置: '+Math.round(forkPos)+'px | 前导链已合成: '+Math.round(leadLen)+'nt | 已完成冈崎片段: '+nDone+' 个';}\nfunction loop(){update();draw();requestAnimationFrame(loop);}\ndocument.getElementById('btn-play').addEventListener('click',function(){playing=true;this.classList.add('active');document.getElementById('btn-pause').classList.remove('active');});\ndocument.getElementById('btn-pause').addEventListener('click',function(){playing=false;this.classList.add('active');document.getElementById('btn-play').classList.remove('active');});\ndocument.getElementById('btn-reset').addEventListener('click',reset);\ndocument.getElementById('btn-speed-down').addEventListener('click',function(){speed=Math.max(0.25,speed-0.25);document.getElementById('speed-val').textContent=speed+'x';});\ndocument.getElementById('btn-speed-up').addEventListener('click',function(){speed=Math.min(4,speed+0.25);document.getElementById('speed-val').textContent=speed+'x';});\nreset();loop();\n})();\n</script>"
          }
        }
      ]
    },
