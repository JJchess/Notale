{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/v2/content-pack.schema.json",
  "title": "V2 Content Pack",
  "type": "object",
  "required": ["version", "title", "sources", "pages"],
  "properties": {
    "version": { "const": "2.0" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "language": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "sourceIds"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "sourceIds": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "coreLogic": { "type": "string" },
          "graph": {
            "type": "object",
            "required": ["nodes", "edges"],
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "label": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "code": {
            "type": "object",
            "required": ["language", "source"],
            "properties": {
              "language": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": false
          },
          "speakerNotes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
