{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecture-workflow.local/schemas/native-scene.schema.json",
  "title": "Native HTML scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pageId", "mode", "canvas", "theme", "nodes", "assets", "interactions", "observedElementCount", "reconstructionCoverage", "confidence", "rationale"],
  "properties": {
    "version": { "const": "1.0" },
    "pageId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["dom2d", "asset-assisted", "css3d", "webgl-exception"] },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "foreground", "muted", "accent", "secondary", "surface"],
      "properties": {
        "background": { "type": "string" },
        "foreground": { "type": "string" },
        "muted": { "type": "string" },
        "accent": { "type": "string" },
        "secondary": { "type": "string" },
        "surface": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "role", "parentId", "bbox", "z", "binding", "style", "variant", "shape", "assetId", "depth", "tilt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["text", "shape", "image", "svg", "chart", "diagram", "css3d", "hotspot"] },
          "role": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "bbox": { "$ref": "#/$defs/bbox" },
          "sourceBBox": { "anyOf": [{ "$ref": "#/$defs/sourceBBox" }, { "type": "null" }] },
          "anchors": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
          "geometryConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "layerConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "z": { "type": "integer", "minimum": 0, "maximum": 100 },
          "binding": { "$ref": "#/$defs/binding" },
          "style": { "$ref": "#/$defs/style" },
          "svgPaths": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["d", "fill", "stroke", "strokeWidth", "opacity"],
              "properties": {
                "d": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "fill": { "type": ["string", "null"] },
                "stroke": { "type": ["string", "null"] },
                "strokeWidth": { "type": "number", "minimum": 0, "maximum": 80 },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "variant": { "type": ["string", "null"] },
          "shape": { "type": ["string", "null"], "enum": ["rect", "circle", "pill", "line", "none", null] },
          "assetId": { "type": ["string", "null"] },
          "depth": { "type": "number", "minimum": -500, "maximum": 500 },
          "tilt": { "type": "number", "minimum": -60, "maximum": 60 }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "prompt", "bbox", "transparent", "providerPreference", "useReference"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["background", "photo", "portrait", "illustration", "texture", "cutout", "decorative-vector"] },
          "prompt": { "type": "string", "minLength": 1 },
          "bbox": { "$ref": "#/$defs/bbox" },
          "transparent": { "type": "boolean" },
          "providerPreference": { "enum": ["seedream", "gpt-image-2", "recraft"] },
          "useReference": { "type": "boolean" }
        }
      }
    },
    "interactions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "type", "trigger", "label"],
        "properties": {
          "targetId": { "type": "string" },
          "type": { "enum": ["expand", "rotate", "toggle", "reset"] },
          "trigger": { "enum": ["hover", "click", "drag", "keyboard", "touch"] },
          "label": { "type": "string" }
        }
      }
    },
    "observedElementCount": { "type": "integer", "minimum": 1, "maximum": 160 },
    "reconstructionCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string" }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "sourceBBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "key"],
      "properties": {
        "kind": { "enum": ["title", "purpose", "coreLogic", "displayCopy", "claim", "graphNode", "seriesLabel", "seriesValue", "code", "none"] },
        "index": { "type": ["integer", "null"], "minimum": 0 },
        "key": { "type": ["string", "null"] }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "background", "fontSize", "fontWeight", "borderRadius", "borderWidth", "borderColor", "opacity", "align", "shadow", "rotation"],
      "properties": {
        "color": { "type": ["string", "null"] },
        "background": { "type": ["string", "null"] },
        "fontSize": { "type": ["number", "null"], "minimum": 10, "maximum": 180 },
        "fontWeight": { "type": ["integer", "null"], "minimum": 100, "maximum": 900 },
        "borderRadius": { "type": ["number", "null"], "minimum": 0, "maximum": 200 },
        "borderWidth": { "type": ["number", "null"], "minimum": 0, "maximum": 20 },
        "borderColor": { "type": ["string", "null"] },
        "opacity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "align": { "type": ["string", "null"], "enum": ["left", "center", "right", null] },
        "shadow": { "type": ["string", "null"] },
        "rotation": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    }
  }
}
