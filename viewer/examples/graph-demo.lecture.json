{
  "schemaVersion": "1.0",
  "id": "graph-demo",
  "title": "graph 块渲染夹具",
  "language": "zh-CN",
  "theme": "slate",
  "scenes": [
    {
      "id": "s0",
      "kind": "hero",
      "notes": "封面。",
      "blocks": [
        {
          "id": "b0",
          "type": "hero",
          "title": [
            "graph 块",
            "树 / DAG / 分支流程"
          ]
        }
      ]
    },
    {
      "id": "s1",
      "kind": "content",
      "headline": "二叉搜索树（tree，纵向）",
      "notes": "讲 BST 的定义性质与左右子树约束。",
      "blocks": [
        {
          "id": "b1",
          "type": "graph",
          "graphType": "tree",
          "orientation": "vertical",
          "nodes": [
            {
              "id": "root",
              "title": "根 50",
              "sub": "BST 根节点",
              "state": "on"
            },
            {
              "id": "l",
              "title": "左子树",
              "sub": "全部 < 50"
            },
            {
              "id": "r",
              "title": "右子树",
              "sub": "全部 > 50"
            },
            {
              "id": "ll",
              "title": "30"
            },
            {
              "id": "lr",
              "title": "45"
            },
            {
              "id": "rl",
              "title": "60"
            },
            {
              "id": "rr",
              "title": "80"
            }
          ],
          "edges": [
            {
              "from": "root",
              "to": "l",
              "label": "左"
            },
            {
              "from": "root",
              "to": "r",
              "label": "右"
            },
            {
              "from": "l",
              "to": "ll"
            },
            {
              "from": "l",
              "to": "lr"
            },
            {
              "from": "r",
              "to": "rl"
            },
            {
              "from": "r",
              "to": "rr"
            }
          ],
          "caption": "中序遍历 BST 即得有序序列"
        }
      ]
    },
    {
      "id": "s2",
      "kind": "content",
      "headline": "课程依赖（dag，多父汇聚）",
      "notes": "讲知识点之间的前置依赖关系。",
      "blocks": [
        {
          "id": "b2",
          "type": "graph",
          "graphType": "dag",
          "orientation": "horizontal",
          "nodes": [
            {
              "id": "arr",
              "title": "数组"
            },
            {
              "id": "lnk",
              "title": "链表"
            },
            {
              "id": "stk",
              "title": "栈与队列"
            },
            {
              "id": "tree",
              "title": "树"
            },
            {
              "id": "heap",
              "title": "堆",
              "sub": "依赖数组+树"
            }
          ],
          "edges": [
            {
              "from": "arr",
              "to": "stk"
            },
            {
              "from": "lnk",
              "to": "stk"
            },
            {
              "from": "arr",
              "to": "heap"
            },
            {
              "from": "tree",
              "to": "heap"
            },
            {
              "from": "stk",
              "to": "tree",
              "style": "dashed"
            }
          ],
          "caption": "虚线表示弱依赖（了解即可）"
        }
      ]
    },
    {
      "id": "s3",
      "kind": "content",
      "headline": "查找判定（flowchart，含回边）",
      "notes": "讲二分查找的分支判定与循环回边。",
      "blocks": [
        {
          "id": "b3",
          "type": "graph",
          "graphType": "flowchart",
          "orientation": "vertical",
          "nodes": [
            {
              "id": "st",
              "title": "取中点 mid",
              "shape": "round"
            },
            {
              "id": "cmp",
              "title": "key = a[mid]?",
              "shape": "diamond"
            },
            {
              "id": "ok",
              "title": "命中返回",
              "shape": "round",
              "state": "on"
            },
            {
              "id": "nar",
              "title": "缩小区间"
            }
          ],
          "edges": [
            {
              "from": "st",
              "to": "cmp"
            },
            {
              "from": "cmp",
              "to": "ok",
              "label": "是"
            },
            {
              "from": "cmp",
              "to": "nar",
              "label": "否"
            },
            {
              "from": "nar",
              "to": "st",
              "label": "循环",
              "style": "dashed"
            }
          ],
          "caption": "回边用虚线，与主流程区分"
        }
      ]
    }
  ]
}