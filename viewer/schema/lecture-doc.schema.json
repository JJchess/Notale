{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicosmos.ai/schemas/lecture-doc/v1",
  "title": "LectureDoc v1",
  "description": "新一代讲义的内容协议。一门课 = 一个 LectureDoc；agent 只产出符合本 schema 的 JSON，渲染由 doc-to-deck 运行时完成。语义与创作规范见同目录 SPEC.md。",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "language", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "language": { "type": "string", "examples": ["zh-CN", "en"] },
    "audience": { "type": "string" },
    "theme": { "enum": ["cartesian", "cobalt-grid", "lab", "slate"], "default": "cartesian", "description": "视觉主题：agent 按课程气质选一套，选定后整份讲义强制一致（无 per-page 覆盖）。cartesian=暖沙米色+Playfair 衬线，克制留白；cobalt-grid=电钴蓝双色 risograph+方格坐标纸+封面反相，研究公报感；lab=暗磷光仪表台，专给物理/化学/算法仿真（含 sim.widget canvas 动画）；slate=冷灰绘图纸+Newsreader 衬线+单一琥珀强调，冷静克制的编辑/工程气质。选择指南见 SPEC.md §8。" },
    "tutor": { "$ref": "#/$defs/tutor" },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "inlineMd": {
      "type": "string",
      "description": "受限行内 markdown：**强调**(衬线斜体) / *强调* / `等宽` / $行内LaTeX$。禁止原始 HTML。"
    },
    "tutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suggestions": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "kb": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "answer"],
            "additionalProperties": false,
            "properties": {
              "pattern": { "type": "string", "description": "JS 正则源码（不含定界符）" },
              "flags": { "type": "string", "pattern": "^[gimsuy]*$" },
              "answer": { "$ref": "#/$defs/inlineMd" }
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "kind", "blocks", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "enum": ["hero", "content", "quiz", "statement", "section"] },
        "eyebrow": { "type": "string" },
        "headline": { "$ref": "#/$defs/inlineMd" },
        "headlineSize": { "type": "number", "minimum": 20, "maximum": 60 },
        "lead": { "$ref": "#/$defs/inlineMd" },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "description": "本页版式（per-scene，可只用于某一页）。kind 缺省 flow=竖排。版式是开放集，这里是起步几种。",
          "properties": {
            "kind": { "enum": ["flow", "index", "split", "compose"], "description": "flow 默认竖排 | index 片内分节(左目录+右切入) | split 锚定分栏(左锚常驻+右递进) | compose 中间层(12列区域图+role，见 cols/areas/preset)" },
            "centered": { "type": "boolean", "description": "flow：body 内容垂直居中" },
            "gap": { "type": "number", "minimum": 0, "maximum": 60 },
            "cols": { "type": "integer", "minimum": 2, "maximum": 12, "description": "kind=compose：栅格列数（默认 12）" },
            "preset": { "enum": ["sidenote"], "description": "kind=compose：罐装区域图预设（sidenote 旁注=主栏+右窄侧栏）。给了 preset 就不用手写 areas。" },
            "areas": {
              "type": "array",
              "description": "kind=compose：区域图。每区把若干 block 摆到栅格的列/行线号上，role 驱动样式。未被引用的 block 不丢，整行全宽追加。",
              "items": {
                "type": "object",
                "required": ["blockIds"],
                "additionalProperties": false,
                "properties": {
                  "blockIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "该区包含的 block id（引用本页 blocks[].id）" },
                  "col": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "maxItems": 2, "description": "列线号 [起, 止]（1..cols+1）；只给一个数=单列" },
                  "row": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "maxItems": 2, "description": "行线号 [起, 止]（可选，缺省自动流）" },
                  "role": { "enum": ["main", "aside", "feature", "caption", "quote"], "description": "语义角色，驱动 token 化样式（aside=低对比窄栏旁注…）" }
                }
              }
            },
            "steps": {
              "type": "array",
              "description": "kind=index：把本页 blocks 按 id 分成子节（顺序即步进顺序），label 显式给。未引用的 block 不丢，并入末节。",
              "items": {
                "type": "object",
                "required": ["label", "blockIds"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "description": "子节目录名（inline-md）" },
                  "blockIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "该子节包含的 block id（引用本页 blocks[].id）" }
                }
              }
            },
            "anchor": { "type": "array", "items": { "type": "string" }, "description": "kind=split：左侧常驻锚的 block id（引用本页 blocks[].id）；其余进右主栏。" },
            "ratio": { "type": "number", "minimum": 0.25, "maximum": 0.6, "description": "kind=split：左锚栏宽度占比（默认 0.4）" }
          }
        },
        "decor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rings": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": ["size"],
                "additionalProperties": false,
                "properties": {
                  "size": { "type": "number" },
                  "top": { "type": "number" }, "right": { "type": "number" },
                  "bottom": { "type": "number" }, "left": { "type": "number" }
                }
              }
            }
          }
        },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
        "notes": { "type": "string", "minLength": 1, "description": "演讲者备注（详细讲解收纳处；正文保持克制）" }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string", "description": "块 id（规划器分配，全局唯一）；scene.layout 的 steps/anchor 按此引用块" },
        "type": { "enum": ["hero", "statement", "list", "agenda", "callout", "timeline", "formula", "flow", "table", "code", "compare", "grid", "quiz", "sim", "chart", "stats", "diagram", "graph", "runnable", "embed", "freeform", "pullquote", "video"] },
        "status": { "enum": ["ready", "pending", "error"], "default": "ready" },
        "fragment": { "type": "boolean", "description": "整块渐显" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "hero" } } }, "then": { "$ref": "#/$defs/heroBlock" } },
        { "if": { "properties": { "type": { "const": "statement" } } }, "then": { "$ref": "#/$defs/statementBlock" } },
        { "if": { "properties": { "type": { "const": "list" } } }, "then": { "$ref": "#/$defs/listBlock" } },
        { "if": { "properties": { "type": { "const": "agenda" } } }, "then": { "$ref": "#/$defs/agendaBlock" } },
        { "if": { "properties": { "type": { "const": "callout" } } }, "then": { "$ref": "#/$defs/calloutBlock" } },
        { "if": { "properties": { "type": { "const": "timeline" } } }, "then": { "$ref": "#/$defs/timelineBlock" } },
        { "if": { "properties": { "type": { "const": "formula" } } }, "then": { "$ref": "#/$defs/formulaBlock" } },
        { "if": { "properties": { "type": { "const": "flow" } } }, "then": { "$ref": "#/$defs/flowBlock" } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "$ref": "#/$defs/tableBlock" } },
        { "if": { "properties": { "type": { "const": "code" } } }, "then": { "$ref": "#/$defs/codeBlock" } },
        { "if": { "properties": { "type": { "const": "compare" } } }, "then": { "$ref": "#/$defs/compareBlock" } },
        { "if": { "properties": { "type": { "const": "grid" } } }, "then": { "$ref": "#/$defs/gridBlock" } },
        { "if": { "properties": { "type": { "const": "quiz" } } }, "then": { "$ref": "#/$defs/quizBlock" } },
        { "if": { "properties": { "type": { "const": "sim" } } }, "then": { "$ref": "#/$defs/simBlock" } },
        { "if": { "properties": { "type": { "const": "chart" } } }, "then": { "$ref": "#/$defs/chartBlock" } },
        { "if": { "properties": { "type": { "const": "stats" } } }, "then": { "$ref": "#/$defs/statsBlock" } },
        { "if": { "properties": { "type": { "const": "diagram" } } }, "then": { "$ref": "#/$defs/diagramBlock" } },
        { "if": { "properties": { "type": { "const": "graph" } } }, "then": { "$ref": "#/$defs/graphBlock" } },
        { "if": { "properties": { "type": { "const": "runnable" } } }, "then": { "$ref": "#/$defs/runnableBlock" } },
        { "if": { "properties": { "type": { "const": "embed" } } }, "then": { "$ref": "#/$defs/embedBlock" } },
        { "if": { "properties": { "type": { "const": "freeform" } } }, "then": { "$ref": "#/$defs/freeformBlock" } },
        { "if": { "properties": { "type": { "const": "pullquote" } } }, "then": { "$ref": "#/$defs/pullquoteBlock" } },
        { "if": { "properties": { "type": { "const": "video" } } }, "then": { "$ref": "#/$defs/videoBlock" } }
      ]
    },
    "heroBlock": {
      "required": ["title"],
      "properties": {
        "tag": { "type": "string" },
        "title": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" }, "description": "标题行数组，每项一行" },
        "titleSize": { "type": "number", "minimum": 28, "maximum": 80 },
        "sub": { "$ref": "#/$defs/inlineMd" },
        "facts": { "type": "string", "description": "一行纯文字元信息，用 · 分隔。禁止胶囊徽标。" },
        "accentRule": { "type": "boolean", "description": "标题下的一条黑色细线（全系统唯一纯黑线）" },
        "hint": { "type": "string" }
      }
    },
    "statementBlock": {
      "required": ["statement"],
      "properties": {
        "statement": { "$ref": "#/$defs/inlineMd" },
        "sub": { "$ref": "#/$defs/inlineMd" },
        "cite": { "type": "string" }
      }
    },
    "pullquoteBlock": {
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/inlineMd", "description": "抽自正文的关键句，编辑级放大旁置（每页≤2）" },
        "cite": { "$ref": "#/$defs/inlineMd", "description": "出处/署名（可选）" }
      }
    },
    "videoBlock": {
      "description": "一等视频块：播放本地 vendored 视频（agent 生成的科普讲解 clip，见 create-video/render-video 管线）。红线：src/poster/captions 只能是本地相对路径或 data:，禁远程 URL(守离线)。至少给 src 或 poster。",
      "anyOf": [{ "required": ["src"] }, { "required": ["poster"] }],
      "properties": {
        "src": { "type": "string", "pattern": "^(?!\\s*(https?:)?//).+", "description": "本地视频相对路径(如 assets/x.webm)；禁 http(s):// 与协议相对 //host" },
        "poster": { "type": "string", "pattern": "^(?!\\s*(https?:)?//).+", "description": "海报图本地路径或 data:image；无 src 时作占位" },
        "captions": { "type": "string", "pattern": "^(?!\\s*(https?:)?//).+", "description": "本地 WebVTT 字幕(.vtt)相对路径" },
        "caption": { "$ref": "#/$defs/inlineMd", "description": "视频下方一行说明" },
        "loop": { "type": "boolean" },
        "language": { "type": "string", "description": "字幕语言(默认 zh)" }
      }
    },
    "listBlock": {
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "required": ["text"], "additionalProperties": false,
            "properties": {
              "lead": { "$ref": "#/$defs/inlineMd", "description": "可选：条目粗体小标题，渲染为强调色小字块（给长列表一层可扫读层级）" },
              "text": { "$ref": "#/$defs/inlineMd" },
              "icon": { "type": "string", "description": "本地图标 id（由 attach_icons 确定性回填），见 viewer/vendor/icons/icons.json" },
              "fragment": { "type": "boolean" }
            }
          }
        }
      }
    },
    "agendaBlock": {
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "required": ["label", "text"], "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "text": { "$ref": "#/$defs/inlineMd" },
              "fragment": { "type": "boolean" }
            }
          }
        }
      }
    },
    "calloutBlock": {
      "required": ["label", "text"],
      "properties": {
        "label": { "type": "string" },
        "text": { "$ref": "#/$defs/inlineMd" },
        "latex": { "type": "string", "description": "可选：附在文字下方的展示公式（LaTeX）" },
        "latexSize": { "type": "number" }
      }
    },
    "timelineBlock": {
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "required": ["time", "title"], "additionalProperties": false,
            "properties": { "time": { "type": "string" }, "title": { "$ref": "#/$defs/inlineMd" }, "desc": { "$ref": "#/$defs/inlineMd" } }
          }
        }
      }
    },
    "formulaBlock": {
      "required": ["latex"],
      "properties": {
        "latex": { "type": "string" },
        "size": { "type": "number" },
        "caption": { "$ref": "#/$defs/inlineMd" }
      }
    },
    "flowBlock": {
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array", "minItems": 2, "maxItems": 7,
          "items": {
            "type": "object", "required": ["title"], "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/inlineMd" },
              "sub": { "type": "string" },
              "state": { "enum": ["on", "q"], "description": "on=实线强调节点；q=虚线待解节点" }
            }
          }
        },
        "loopNote": { "type": "string", "description": "尾部循环注记，如 ↺ 循环至收敛" }
      }
    },
    "chartBlock": {
      "required": ["chartType"],
      "properties": {
        "chartType": { "enum": ["bar", "line", "area", "scatter"] },
        "categories": { "type": "array", "items": { "type": "string" }, "description": "bar/line/area：类目轴（须与每条 series.values 等长）" },
        "series": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["name", "values"], "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "values": { "type": "array", "items": { "type": "number" } } }
          },
          "description": "bar/line/area：一条或多条数据序列（bar 仅渲染第一条）"
        },
        "points": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["x", "y"], "additionalProperties": false,
            "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "label": { "type": "string" } }
          },
          "description": "scatter：散点（每点两个数值坐标）"
        },
        "xLabel": { "type": "string" },
        "yLabel": { "type": "string" },
        "caption": { "$ref": "#/$defs/inlineMd" }
      },
      "allOf": [
        { "if": { "properties": { "chartType": { "const": "scatter" } } }, "then": { "required": ["points"] }, "else": { "required": ["categories", "series"] } }
      ]
    },
    "statsBlock": {
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "required": ["value", "label"], "additionalProperties": false,
            "properties": { "value": { "type": "string" }, "label": { "type": "string" }, "delta": { "type": "string", "description": "可选：同比/环比变化，如 +12%/-3pp" } }
          }
        }
      }
    },
    "diagramBlock": {
      "required": ["diagramType", "nodes"],
      "properties": {
        "diagramType": { "enum": ["cycle", "pyramid", "staircase", "snake", "arrow-seq", "circular-grid", "connected-circles"] },
        "nodes": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "required": ["title"], "additionalProperties": false,
            "properties": { "title": { "$ref": "#/$defs/inlineMd" }, "sub": { "type": "string", "description": "可选：一行说明" } }
          }
        }
      }
    },
    "graphBlock": {
      "description": "带命名边的一等图块：树 / DAG / 分支流程。与 diagram/flow 的根本区别是它有 edges —— 那两者只能表达一条线性链或一圈环，一棵带父子关系的真实树在它们里根本不可表达。渲染为真 SVG 分层图（自动分层 + 计算边路由），不是文字箭头。",
      "required": ["graphType", "nodes", "edges"],
      "properties": {
        "graphType": { "enum": ["tree", "dag", "flowchart"], "description": "tree=层次树（每节点至多一个父）；dag=有向无环图（可多父/汇聚）；flowchart=带分支判定的流程" },
        "orientation": { "enum": ["vertical", "horizontal"], "default": "vertical", "description": "vertical=自顶向下（树的默认）；horizontal=自左向右（长链更省横向空间）" },
        "nodes": {
          "type": "array", "minItems": 2, "maxItems": 14,
          "items": {
            "type": "object", "required": ["id", "title"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$", "description": "节点 id，edges 按此引用；同块内唯一" },
              "title": { "$ref": "#/$defs/inlineMd" },
              "sub": { "type": "string", "description": "可选：一行说明" },
              "state": { "enum": ["on", "q"], "description": "on=高亮当前节点；q=待定/疑问（虚线框）" },
              "shape": { "enum": ["box", "round", "diamond"], "default": "box", "description": "diamond 用于 flowchart 的判定节点" }
            }
          }
        },
        "edges": {
          "type": "array", "minItems": 1, "maxItems": 24,
          "items": {
            "type": "object", "required": ["from", "to"], "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "description": "源节点 id" },
              "to": { "type": "string", "description": "目标节点 id" },
              "label": { "type": "string", "maxLength": 12, "description": "可选：边上的短标注，如「是」「否」「左子树」" },
              "style": { "enum": ["solid", "dashed"], "default": "solid", "description": "dashed 表示可选/回边/弱关系" }
            }
          }
        },
        "caption": { "$ref": "#/$defs/inlineMd" }
      }
    },
    "tableBlock": {
      "required": ["head", "rows"],
      "properties": {
        "head": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "rows": {
          "type": "array", "minItems": 1,
          "items": { "type": "array", "items": {
            "oneOf": [
              { "$ref": "#/$defs/inlineMd" },
              { "type": "object", "required": ["text"], "additionalProperties": false,
                "properties": { "text": { "$ref": "#/$defs/inlineMd" }, "hi": { "type": "boolean" } } }
            ]
          } }
        }
      }
    },
    "codeBlock": {
      "required": ["language", "source"],
      "properties": {
        "filename": { "type": "string" },
        "language": { "enum": ["python", "javascript", "text"] },
        "source": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "compareBlock": {
      "required": ["left", "right"],
      "properties": {
        "left": { "$ref": "#/$defs/compareSide" },
        "right": { "$ref": "#/$defs/compareSide" }
      }
    },
    "compareSide": {
      "type": "object", "required": ["block"], "additionalProperties": false,
      "properties": {
        "caption": { "type": "string" },
        "block": { "$ref": "#/$defs/block" }
      }
    },
    "gridBlock": {
      "description": "通用网格容器：N 列，子项是普通 block（递归、可嵌套），子项可跨列。compare 是它的两列特例。",
      "required": ["columns", "items"],
      "properties": {
        "columns": { "type": "integer", "minimum": 2, "maximum": 4 },
        "gap": { "type": "number", "minimum": 0, "maximum": 80 },
        "items": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "required": ["block"], "additionalProperties": false,
            "properties": {
              "block": { "$ref": "#/$defs/block" },
              "span": { "type": "integer", "minimum": 1, "maximum": 4, "description": "跨几列（默认 1），用于不对称布局" }
            }
          }
        }
      }
    },
    "quizBlock": {
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["objective", "subjective"] },
        "stem": { "$ref": "#/$defs/inlineMd", "description": "题干：选项上方的问题（可含行内公式）；不写则问题体现在页 headline" },
        "context": { "$ref": "#/$defs/inlineMd", "description": "stem 的兼容旧别名（等价于 stem，渲染时 stem 优先）" },
        "choices": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "required": ["key", "text"], "additionalProperties": false,
            "properties": { "key": { "type": "string", "pattern": "^[a-z]$" }, "text": { "$ref": "#/$defs/inlineMd" } }
          }
        },
        "answer": { "type": "string", "pattern": "^[a-z]$" },
        "explain": { "$ref": "#/$defs/inlineMd" },
        "prompt": { "$ref": "#/$defs/inlineMd", "description": "主观题题干" },
        "angles": { "type": "array", "items": { "type": "string" }, "description": "主观题可选切入角度" },
        "instruction": { "$ref": "#/$defs/inlineMd", "description": "主观题作答/提交要求" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "objective" } } },
          "then": { "required": ["kind", "choices", "answer", "explain"] } },
        { "if": { "properties": { "kind": { "const": "subjective" } } },
          "then": { "required": ["kind", "prompt"] } }
      ]
    },
    "simParam": {
      "type": "object", "required": ["name", "label", "min", "max", "step", "default"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "label": { "type": "string" },
        "min": { "type": "number" }, "max": { "type": "number" },
        "step": { "type": "number" }, "default": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "simBlock": {
      "required": ["engine"],
      "properties": {
        "engine": { "enum": ["dynamics1d", "searchCompare", "custom", "widget"] },
        "params": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/simParam" }, "description": "滑块参数（声明式引擎必填；widget 引擎不用——控件长在片段内部）" },
        "html": { "type": "string", "description": "仅 engine=widget：自包含 HTML 片段（<style>→markup→<script>），跑在 sandbox iframe 里；契约与安全见 SPEC.md §3.2" },
        "caption": { "type": "string", "description": "仅 engine=widget：组件下方一行说明（可选）" },
        "reseedLabel": { "type": "string", "description": "换随机种子按钮文字；缺省则不显示按钮" },
        "model": { "type": "object", "description": "引擎专属模型定义，见 SPEC.md 各引擎小节" },
        "regimes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["when", "label", "desc"], "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "description": "受限布尔表达式（参数白名单）；按序取第一个为真者" },
              "label": { "type": "string" }, "desc": { "type": "string" },
              "tone": { "enum": ["line", "accent", "ink"] },
              "dash": { "type": "string", "description": "solid 或 SVG dash 数组如 6,3" }
            }
          }
        },
        "noiseNote": {
          "type": "object", "required": ["when", "text"], "additionalProperties": false,
          "properties": { "when": { "type": "string" }, "text": { "type": "string" } }
        },
        "sidecar": {
          "type": "object", "additionalProperties": false,
          "properties": { "code": { "$ref": "#/$defs/codeBlock" } },
          "description": "面板里随附的说明物（如更新规则代码卡）"
        },
        "legend": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "chart": { "type": "object", "description": "坐标轴标签/目标线等图表规格，见 SPEC.md" },
        "computeJs": { "type": "string", "description": "仅 engine=custom：沙箱 JS 纯函数源码，契约见 SPEC.md" }
      },
      "allOf": [
        { "if": { "properties": { "engine": { "const": "custom" } } }, "then": { "required": ["engine", "params", "computeJs", "chart"] } },
        { "if": { "properties": { "engine": { "const": "dynamics1d" } } }, "then": { "required": ["engine", "params", "model"] } },
        { "if": { "properties": { "engine": { "const": "searchCompare" } } }, "then": { "required": ["engine", "params", "model"] } },
        { "if": { "properties": { "engine": { "const": "widget" } } }, "then": { "required": ["engine", "html"] } }
      ]
    },
    "runnableBlock": {
      "required": ["languages", "starter", "env"],
      "properties": {
        "languages": { "type": "array", "minItems": 1, "items": { "enum": ["python", "js"] } },
        "starter": {
          "type": "object", "additionalProperties": false,
          "properties": { "python": { "type": "string" }, "js": { "type": "string" } }
        },
        "env": {
          "type": "object", "required": ["kind"],
          "properties": {
            "kind": { "enum": ["objective1d", "custom"] },
            "objective": { "type": "string" },
            "domain": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "yDomain": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "candidates": { "type": "integer", "minimum": 10, "maximum": 2000 },
            "pythonPreamble": { "type": "string", "description": "仅 kind=custom" },
            "jsPreamble": { "type": "string", "description": "仅 kind=custom：求值后须返回 helper 对象的 JS 表达式" }
          }
        },
        "hint": { "type": "string" },
        "consoleHint": { "type": "string" }
      }
    },
    "embedBlock": {
      "description": "保留位：嵌入后端产品（代码实验室/互动视频/互动实验室）。运行时当前仅渲染占位框。",
      "required": ["product"],
      "properties": {
        "product": { "enum": ["codelab", "video", "sim"] },
        "launch": { "type": "object" },
        "artifact": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" }, "toolCallId": { "type": "string" },
            "url": { "type": "string" }, "needsOpen": { "type": "boolean" },
            "status": { "enum": ["pending", "ready", "failed"] }
          }
        },
        "fallbackPoster": { "type": "string" }
      }
    },
    "freeformBlock": {
      "description": "逃生舱：当 正式 block 类型都无法表达所需版式/内容形态时的最后手段。永远以显眼的\"未分类内容\"样式渲染，绝不悄悄融入正常排版——有意的摩擦，抑制滥用，且高频 rationale 是未来长出新正式 block 类型的信号。html 支持结构/媒体/SVG + 布局类 style（grid/flex/定位/尺寸），但颜色/字体/背景/描边等只接受 var(--token) 或 currentColor（裸色值被剥离，强制在主题内）；img 仅限本地（vendor//assets//data:image/）；禁 script/style/iframe/object/embed/内联事件/javascript:/url()。运行时 sanitizeFreeformHtml 是权威净化，validate.mjs 做静态预检。",
      "required": ["html", "rationale"],
      "properties": {
        "html": { "type": "string", "minLength": 1, "description": "结构化 HTML 片段（非完整文档）；运行时净化后原样渲染。布局用 style（grid/flex/尺寸/定位），色与字用 var(--token)。" },
        "rationale": { "type": "string", "minLength": 10, "description": "必须具体说明现有各正式类型分别为何不适用，而不是泛泛的\"需要自定义排版\"。" }
      }
    }
  }
}
