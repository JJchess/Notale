          "source": "import torch\nimport torch.nn as nn\n\nmodel = nn.Sequential(nn.Linear(784, 256), nn.ReLU(), nn.Linear(256, 10))\noptim = torch.optim.SGD(model.parameters(), lr=1e-2)\nloss_fn = nn.CrossEntropyLoss()\n\nx = torch.randn(64, 784)          # 一个 mini-batch\ny = torch.randint(0, 10, (64,))   # 真实标签\n\n# 1) 清空上一步残留的 .grad —— 否则梯度会累加\noptim.zero_grad()\n\n# 2) 前向：动态图被构建，中间激活被缓存以供反向使用\nlogits = model(x)                 # requires_grad=True 的张量\n\n# 3) 计算损失：loss 是图中的叶节点之一\nloss = loss_fn(logits, y)\n\n# 4) 反向传播：沿动态图反向遍历，逐层计算并累积 .grad\nloss.backward()                   # 此刻释放中间激活，显存占用回落\n\n# 5) 用 .grad 更新参数\noptim.step()\n\n# ---- 以下两种场景需要切断梯度流，避免无谓的显存开销 ----\n\n# (a) detach(): 把张量从计算图上摘下，后续运算不建图、不缓存\nwith torch.no_grad():\n    val_logits = model(x_val)     # 推理/评估：整段不追踪梯度\n    val_loss = loss_fn(val_logits, y_val)\n\n# (b) detach(): 只对单个张量断开，常用于把网络输出喂给不参与训练的模块\ntarget = model(x).detach()        # target 不再带 grad_fn\n",
