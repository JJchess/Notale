          "engine": "widget",
          "html": "<style>\n  .widget { display: flex; flex-direction: column; height: 100%; background: var(--bg); color: var(--ink); font-family: var(--sans); overflow: hidden; }\n  .stage-wrap { flex: 1; position: relative; min-height: 0; display: flex; align-items: center; justify-content: center; }\n  #stage { width: 100%; height: 100%; display: block; background: var(--bg2); }\n  .controls { padding: 12px 16px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; border-top: 3px solid var(--ink); background: var(--card); }\n  .ctrl-group { display: flex; align-items: center; gap: 8px; }\n  .ctrl-group label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; color: var(--text2); }\n  input[type=range] { accent-color: var(--accent); width: 100px; cursor: pointer; }\n  .val { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 14px; font-weight: 700; min-width: 32px; text-align: right; color: var(--ink); }\n  button { font-family: var(--sans); font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em; padding: 6px 14px; border: 2px solid var(--ink); background: var(--bg); color: var(--ink); cursor: pointer; box-shadow: 4px 4px 0 var(--ink); transition: transform 160ms ease-out, box-shadow 160ms ease-out; }\n  button:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--ink); }\n  button:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ink); }\n  .badge { position: absolute; top: 16px; right: 16px; border: 2px solid var(--ink); border-radius: 50%; width: 68px; height: 68px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--card); box-shadow: 4px 4px 0 var(--ink); pointer-events: none; }\n  .badge .rate { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 22px; font-weight: 900; line-height: 1; color: var(--ink); }\n  .badge .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; color: var(--text2); }\n  .step-label { position: absolute; top: 16px; left: 16px; font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 12px; color: var(--text2); pointer-events: none; }\n</style>\n<div class=\"widget\">\n  <div class=\"stage-wrap\">\n    <svg id=\"stage\" viewBox=\"0 0 600 400\" preserveAspectRatio=\"xMidYMid meet\"></svg>\n    <div class=\"badge\">\n      <span class=\"rate\" id=\"rateVal\">20%</span>\n      <span class=\"label\">感染率</span>\n    </div>\n    <div class=\"step-label\" id=\"stepLabel\">步骤 3</div>\n  </div>\n  <div class=\"controls\">\n    <div class=\"ctrl-group\">\n      <label for=\"initialSources\">信源数</label>\n      <input type=\"range\" id=\"initialSources\" min=\"1\" max=\"8\" step=\"1\" value=\"3\">\n      <span class=\"val\" id=\"srcVal\">3</span>\n    </div>\n    <div class=\"ctrl-group\">\n      <label for=\"trustLevel\">信任度</label>\n      <input type=\"range\" id=\"trustLevel\" min=\"0.05\" max=\"0.5\" step=\"0.01\" value=\"0.18\">\n      <span class=\"val\" id=\"trustVal\">0.18</span>\n    </div>\n    <button id=\"playpause\">暂停</button>\n    <button id=\"reset\">重置</button>\n  </div>\n</div>\n<script>\n  const N = 30;\n  const nodes = [];\n  const edges = [];\n  const adj = Array.from({length: N}, () => []);\n\n  // Layout: 10 inner, 20 outer\n  for (let i = 0; i < 10; i++) {\n    const angle = (2 * Math.PI * i) / 10 - Math.PI / 2;\n    nodes.push({ x: 300 + 110 * Math.cos(angle), y: 200 + 110 * Math.sin(angle) });\n  }\n  for (let i = 0; i < 20; i++) {\n    const angle = (2 * Math.PI * i) / 20 - Math.PI / 2;\n    nodes.push({ x: 300 + 230 * Math.cos(angle), y: 200 + 190 * Math.sin(angle) });\n  }\n\n  const addEdge = (a, b) => {\n    if (a === b || adj[a].includes(b)) return;\n    adj[a].push(b);\n    adj[b].push(a);\n    edges.push([a, b]);\n  };\n\n  // Inner ring\n  for (let i = 0; i < 10; i++) addEdge(i, (i + 1) % 10);\n  // Outer ring\n  for (let i = 0; i < 20; i++) addEdge(10 + i, 10 + (i + 1) % 20);\n  // Outer skips\n  for (let i = 0; i < 20; i++) addEdge(10 + i, 10 + (i + 4) % 20);\n  // Cross links\n  for (let i = 0; i < 10; i++) addEdge(i, 10 + (2 * i) % 20);\n\n  const state = {\n    initialSources: 3,\n    trustLevel: 0.18,\n    step: 3,\n    isRunning: true,\n    infectedNodes: new Set([2, 7, 14, 5, 9, 11]),\n    network: adj\n  };\n\n  const svg = document.getElementById('stage');\n  const edgeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n  const nodeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n  svg.appendChild(edgeGroup);\n  svg.appendChild(nodeGroup);\n\n  const edgeEls = [];\n  const nodeEls = [];\n\n  edges.forEach(([a, b]) => {\n    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n    line.setAttribute('x1', nodes[a].x);\n    line.setAttribute('y1', nodes[a].y);\n    line.setAttribute('x2', nodes[b].x);\n    line.setAttribute('y2', nodes[b].y);\n    line.setAttribute('stroke', 'var(--line)');\n    line.setAttribute('stroke-width', '1.5');\n    line.setAttribute('vector-effect', 'non-scaling-stroke');\n    line.dataset.a = a;\n    line.dataset.b = b;\n    edgeGroup.appendChild(line);\n    edgeEls.push(line);\n  });\n\n  nodes.forEach((n, i) => {\n    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n    circle.setAttribute('cx', n.x);\n    circle.setAttribute('cy', n.y);\n    circle.setAttribute('r', '8');\n    circle.setAttribute('stroke', 'var(--ink)');\n    circle.setAttribute('stroke-width', '2');\n    circle.setAttribute('vector-effect', 'non-scaling-stroke');\n    circle.style.transition = 'fill 160ms ease-out';\n    nodeGroup.appendChild(circle);\n    nodeEls.push(circle);\n  });\n\n  function resetSimulation() {\n    state.step = 0;\n    state.infectedNodes = new Set();\n    const indices = Array.from({length: N}, (_, i) => i);\n    for (let i = indices.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [indices[i], indices[j]] = [indices[j], indices[i]];\n    }\n    for (let i = 0; i < state.initialSources; i++) {\n      state.infectedNodes.add(indices[i]);\n    }\n  }\n\n  function update(shouldStep = false) {\n    if (shouldStep && state.isRunning) {\n      const newInfected = new Set(state.infectedNodes);\n      for (let i = 0; i < N; i++) {\n        if (!state.infectedNodes.has(i)) {\n          for (const neighbor of state.network[i]) {\n            if (state.infectedNodes.has(neighbor)) {\n              if (Math.random() < state.trustLevel) {\n                newInfected.add(i);\n                break;\n              }\n            }\n          }\n        }\n      }\n      state.infectedNodes = newInfected;\n      state.step++;\n    }\n\n    const infectedColor = '#b91c1c';\n    const uninfectedColor = '#d4d4d8';\n\n    nodeEls.forEach((el, i) => {\n      el.setAttribute('fill', state.infectedNodes.has(i) ? infectedColor : uninfectedColor);\n    });\n\n    edgeEls.forEach(el => {\n      const a = parseInt(el.dataset.a);\n      const b = parseInt(el.dataset.b);\n      const aInf = state.infectedNodes.has(a);\n      const bInf = state.infectedNodes.has(b);\n      if (aInf && bInf) {\n        el.setAttribute('stroke', infectedColor);\n        el.setAttribute('stroke-opacity', '0.6');\n      } else if (aInf || bInf) {\n        el.setAttribute('stroke', infectedColor);\n        el.setAttribute('stroke-opacity', '0.3');\n      } else {\n        el.setAttribute('stroke', 'var(--line)');\n        el.setAttribute('stroke-opacity', '1');\n      }\n    });\n\n    const rate = Math.round((state.infectedNodes.size / N) * 100);\n    document.getElementById('rateVal').textContent = rate + '%';\n    document.getElementById('stepLabel').textContent = '步骤 ' + state.step;\n  }\n\n  document.getElementById('initialSources').addEventListener('input', e => {\n    state.initialSources = parseInt(e.target.value);\n    document.getElementById('srcVal').textContent = state.initialSources;\n    resetSimulation();\n    update();\n  });\n\n  document.getElementById('trustLevel').addEventListener('input', e => {\n    state.trustLevel = parseFloat(e.target.value);\n    document.getElementById('trustVal').textContent = state.trustLevel.toFixed(2);\n    update();\n  });\n\n  document.getElementById('playpause').addEventListener('click', () => {\n    state.isRunning = !state.isRunning;\n    document.getElementById('playpause').textContent = state.isRunning ? '暂停' : '继续';\n  });\n\n  document.getElementById('reset').addEventListener('click', () => {\n    resetSimulation();\n    update();\n  });\n\n  // Initial paint\n  update();\n\n  // Auto-advance\n  setInterval(() => {\n    if (state.isRunning) {\n      update(true);\n    }\n  }, 800);\n</script>",
          "id": "b_panic_sim"
        },
        {
          "type": "callout",
          "label": "恐惧的实核",
          "text": "流言并非凭空捏造：1789 年 7 月巴黎面包价格已涨至 *4 苏*，贵族确实在三级会议中拒绝按人头计票——大恐慌是对**真实威胁**的扭曲放大，而非无端臆想。",
          "id": "b_panic_callout"
        }
      ],
      "layout": {
        "kind": "compose",
        "preset": "sidenote"
      }
    },
    {
      "id": "bastille",
      "kind": "content",
      "eyebrow": "革命爆发",
      "headline": "攻占巴士底狱：面包与武器的诉求",
      "lead": "1789 年 7 月 14 日，巴黎民众冲向巴士底狱——他们寻找的不是政治自由的象征，而是武器和面包。",
      "notes": "这是全课的具象锚点。攻占巴士底狱后来被神圣化为自由战胜专制的象征，但回到当天现场：巴黎民众的真实诉求极其具体——他们要巴士底狱里储存的火药和武器来武装国民卫队，要确保面包供应。巴士底狱当时只关了 7 名囚犯（包括几个伪造支票者和两个疯子），它不是'暴政的象征'被有意识地攻击，而是因为它有火药。这个具象例子帮学生理解：历史事件的意义往往是事后赋予的，而当事人的动机可能非常朴素。妇女向凡尔赛进军（10 月 5 日）同理——她们要面包，要国王回到巴黎亲眼看到饥荒。",
      "blocks": [
        {
          "type": "statement",
          "statement": "攻占巴士底狱的真实诉求是 **30,000 磅火药**与面包，'自由象征'只是事后追认的政治神话。",
          "id": "b_bastille_statement"
        },
        {
          "type": "list",
          "items": [
            {
              "lead": "政治象征的虚像",
              "text": "1789 年 7 月 14 日攻占巴士底狱时，这座专制堡垒内仅关押着 **7 名囚犯**（4 名伪造犯、2 名精神病患者、1 名贵族债务人），并无政治犯。",
              "icon": "pie-chart"
            },
            {
              "lead": "武器的真实诉求",
              "text": "民众冲击该地的直接目标是院内仓库的 **250 桶火药**，而非解救囚犯；此前他们已从荣军院抢走 3 万支步枪，急需弹药以武装国民自卫军。",
              "icon": "target"
            },
            {
              "lead": "面包的生存底线",
              "text": "同年 10 月妇女向凡尔赛进军，高喊的是 *Du pain!*（面包！）；当时一个 4 磅面包的价格飙升至 14.5 苏，耗去普通工人日薪的近 88%。",
              "icon": "user"
