    {
      "id": "time-freq-duality",
      "kind": "content",
      "eyebrow": "直觉入门",
      "headline": "时域与频域：同一信号的两副面孔",
      "lead": "一段波形既是时间的函数，也是一组频率的清单——两种视角完全等价，却各自照亮不同的信息。",
      "notes": "承接上一页的引入，大家看屏幕上的模拟：时域里复杂的波形，在频域视角下被拆解成了几根清晰的谱线。很多初学者会误以为频域是某种“新生成”的信号，但请记住，它只是同一信号在正交基下的另一种投影，信息量完全等价。既然频域是由离散的谱线构成的，那么这些谱线的位置能随意排列吗？这就自然引出了下一页的核心问题——为什么频率必须是基频的整数倍。",
      "blocks": [
        {
          "type": "statement",
          "statement": "同一个方波，示波器上是棱角分明的电压跳变，频谱仪上是基频与奇次谐波的离散谱线——**信息完全等价**，只是换了一副面孔。",
          "id": "b_duality"
        },
        {
          "type": "sim",
          "engine": "widget",
          "html": "<style>\n  .lab { background: var(--bg2); border-radius: var(--radius, 12px); padding: 20px; color: var(--ink); }\n  .lab canvas { display: block; width: 100%; max-width: 680px; height: auto; margin: 0 auto;\n                background: var(--card); border-radius: var(--radius, 8px); }\n  .row { display: flex; align-items: center; gap: 12px; margin-top: 16px; }\n  .lab label { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--text2); }\n  .lab input[type=range] { flex: 1; accent-color: var(--accent); }\n  .val { font-family: var(--mono); font-variant-numeric: tabular-nums;\n         font-size: 14px; color: var(--accent); min-width: 32px; text-align: right; }\n  .lab button { background: var(--bg); border: 1px solid var(--line); color: var(--ink);\n                padding: 6px 16px; border-radius: var(--radius, 6px); cursor: pointer;\n                font-family: var(--sans); font-size: 13px; transition: all 120ms linear; }\n  .lab button:hover { border-color: var(--accent); color: var(--accent); }\n  .lab button:active { transform: scale(0.96); }\n</style>\n<div class=\"lab\">\n  <canvas id=\"stage\" width=\"680\" height=\"360\"></canvas>\n  <div class=\"row\">\n    <label for=\"harmonics\">谐波数</label>\n    <input type=\"range\" id=\"harmonics\" min=\"1\" max=\"50\" step=\"1\" value=\"5\">\n    <span class=\"val mono\" id=\"harmonicsVal\">5</span>\n    <button id=\"playpause\">暂停</button>\n  </div>\n</div>\n<script>\n  const root = document.documentElement;\n  const tok = n => getComputedStyle(root).getPropertyValue(n).trim();\n  const ctx = document.getElementById('stage').getContext('2d');\n\n  const W = 680, H = 360;\n  const cx = 160, cy = H / 2;\n  const waveStartX = 300, waveEndX = 660, waveWidth = waveEndX - waveStartX;\n  const period = 2 * Math.PI;\n  const scale = 50;\n\n  let numHarmonics = 5;\n  let time = 1.2;\n  let wave = [];\n  let isPlaying = true;\n\n  function getTipPos(t, nMax) {\n    let x = cx, y = cy;\n    for (let k = 1; k <= nMax; k++) {\n      const n = 2 * k - 1;\n      const r = scale * 4 / (n * Math.PI);\n      x += r * Math.cos(n * t);\n      y -= r * Math.sin(n * t);\n    }\n    return { x, y };\n  }\n\n  function prefillWave() {\n    wave = [];\n    const step = 0.02;\n    for (let t = 0; t <= time; t += step) {\n      const p = getTipPos(t, numHarmonics);\n      wave.push({ t, y: p.y });\n    }\n  }\n\n  prefillWave();\n\n  document.getElementById('harmonics').addEventListener('input', e => {\n    numHarmonics = parseInt(e.target.value);\n    document.getElementById('harmonicsVal').textContent = numHarmonics;\n    wave = [];\n  });\n\n  document.getElementById('playpause').addEventListener('click', () => {\n    isPlaying = !isPlaying;\n    document.getElementById('playpause').textContent = isPlaying ? '暂停' : '播放';\n  });\n\n  function update() {\n    const C = {\n      ink: tok('--ink'), accent: tok('--accent'), line: tok('--line'),\n      bg: tok('--bg'), card: tok('--card'), muted: tok('--text2'), mono: tok('--mono')\n    };\n\n    ctx.clearRect(0, 0, W, H);\n\n    // Grid & Ticks (lab signature)\n    ctx.strokeStyle = C.line;\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(waveStartX, cy);\n    ctx.lineTo(waveEndX, cy);\n    ctx.stroke();\n\n    for (let i = 0; i <= 4; i++) {\n      const tx = waveStartX + (waveWidth / 4) * i;\n      ctx.beginPath();\n      ctx.moveTo(tx, cy - 4);\n      ctx.lineTo(tx, cy + 4);\n      ctx.stroke();\n    }\n\n    // Draw Circles\n    let x = cx, y = cy;\n    for (let k = 1; k <= numHarmonics; k++) {\n      const n = 2 * k - 1;\n      const r = Math.max(0.5, scale * 4 / (n * Math.PI));\n      \n      ctx.beginPath();\n      ctx.arc(x, y, r, 0, Math.PI * 2);\n      ctx.strokeStyle = C.line;\n      ctx.lineWidth = 1;\n      ctx.stroke();\n\n      const nx = x + r * Math.cos(n * time);\n      const ny = y - r * Math.sin(n * time);\n\n      ctx.beginPath();\n      ctx.moveTo(x, y);\n      ctx.lineTo(nx, ny);\n      ctx.strokeStyle = C.muted;\n      ctx.lineWidth = 1;\n      ctx.stroke();\n\n      x = nx;\n      y = ny;\n    }\n\n    // Tip glow (lab signature: only active trace glows)\n    ctx.beginPath();\n    ctx.arc(x, y, 4, 0, Math.PI * 2);\n    ctx.fillStyle = C.accent;\n    ctx.shadowColor = C.accent;\n    ctx.shadowBlur = 14;\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    // Connecting line\n    ctx.beginPath();\n    ctx.moveTo(x, y);\n    ctx.lineTo(waveStartX, y);\n    ctx.strokeStyle = C.accent;\n    ctx.lineWidth = 1;\n    ctx.setLineDash([4, 4]);\n    ctx.stroke();\n    ctx.setLineDash([]);\n\n    // Draw Wave\n    if (wave.length > 1) {\n      ctx.beginPath();\n      for (let i = 0; i < wave.length; i++) {\n        const p = wave[i];\n        const px = waveStartX + (time - p.t) * (waveWidth / period);\n        if (i === 0) ctx.moveTo(px, p.y);\n        else ctx.lineTo(px, p.y);\n      }\n      ctx.strokeStyle = C.accent;\n      ctx.lineWidth = 2;\n      ctx.shadowColor = C.accent;\n      ctx.shadowBlur = 8;\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    // Corner readouts (lab signature)\n    ctx.fillStyle = C.muted;\n    ctx.font = '11px ' + C.mono;\n    ctx.textAlign = 'left';\n    ctx.fillText('N ' + numHarmonics, 16, 24);\n    ctx.fillText('t  ' + time.toFixed(2), 16, 40);\n  }\n\n  let last = performance.now();\n  (function loop(now) {\n    const dt = Math.min((now - last) / 1000, 0.05);\n    last = now;\n\n    if (isPlaying) {\n      time += dt * 2;\n      const p = getTipPos(time, numHarmonics);\n      wave.push({ t: time, y: p.y });\n\n      let trimIndex = 0;\n      while (trimIndex < wave.length && wave[trimIndex].t < time - period) {\n        trimIndex++;\n      }\n      if (trimIndex > 0) wave.splice(0, trimIndex);\n    }\n\n    update();\n    requestAnimationFrame(loop);\n  })(performance.now());\n</script>",
          "id": "b_epicycles"
        },
