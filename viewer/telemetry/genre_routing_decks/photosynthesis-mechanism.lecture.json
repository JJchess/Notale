  "scenes": [
    {
      "id": "cover",
      "kind": "hero",
      "notes": "欢迎来到光合作用机制这一讲，我们要打破“植物只是简单吸收二氧化碳释放氧气”的直觉误区，认识到这其实是地球生物圈将光能转化为化学能的核心引擎。整个过程并非单一反应，而是由一系列高度协同的精密步骤组成。接下来，我们将首先深入发生这一切的微观工厂——叶绿体，看看它作为光能捕获反应器的精妙结构。",
      "blocks": [
        {
          "type": "hero",
          "tag": "细胞生物学",
          "title": [
            "光合作用的机制",
            "从光子到糖的微观流水线"
          ],
          "sub": "拆解叶绿体内 *光反应* 与 *卡尔文循环* 如何接力，把 $h\\nu$ 与 $\\mathrm{CO_2}$ 转化为 $\\mathrm{(CH_2O)_n}$。",
          "facts": "每还原一分子 CO2 约需 8–10 个光子；全球光合年固碳约 120 Gt。",
          "hint": "难点不在'光反应+暗反应'的标签，而在两类反应如何通过 ATP 与 NADPH 精确配比、实时耦合。",
          "id": "b_cover"
        }
      ]
    },
    {
      "id": "structure",
      "kind": "content",
      "eyebrow": "结构与物理前提",
      "headline": "叶绿体：光能捕获的精密反应器",
      "lead": "类囊体垛叠成基粒不仅增加受光面积，更实现了质子梯度的空间隔离。",
      "notes": "上一页我们总览了光合作用的全局，现在拉近镜头看叶绿体这个精密反应器。大家要特别注意类囊体堆叠成基粒的设计，这不仅是单纯为了装下更多色素，而是极大地扩展了膜面积（单个叶绿体的类囊体膜展开可达数百平方微米），从而容纳海量的光系统蛋白复合物。这里学生常犯的错误是把基质和细胞质混淆，或者误以为光反应和暗反应在同一个地方发生——实际上光反应在类囊体膜上，暗反应在基质中，空间上的区隔保证了高效协作。带着对类囊体膜这个“光反应车间”的认识，下一页我们将深入膜上的蛋白质机器，看看电子如何像瀑布一样在Z链中传递并劈开水分子。",
      "blocks": [
        {
          "type": "diagram",
          "diagramType": "connected-circles",
          "nodes": [
            {
              "title": "外被膜",
              "sub": "双层膜系统，调控代谢物进出"
            },
            {
              "title": "基质",
              "sub": "Calvin 循环在此固定 CO₂ 生成 G3P"
            },
            {
              "title": "类囊体膜",
