        ]
      }
    },
    {
      "id": "sim-ink",
      "kind": "content",
      "eyebrow": "交互体验",
      "headline": "墨晕实验：绢本与纸本的媒介分野",
      "lead": "文人画的笔墨表现力高度依赖媒介。拖动滑块，观察同一笔墨在绢本与宋代皮纸上的晕染差异。",
      "notes": "刚才我们讲了“墨戏”的技法，但这种抒写性必须依赖特定媒介才能实现，即本页的纸本对绢本的替代；大家常误以为文人选纸仅因便宜，其实纸本吸水产生的“墨晕”偶然性，恰恰契合了他们反叛院体精工的审美直觉。这种从笔法到媒介的自觉实验，让文人在物质载体上也与职业画师划清了界限，从而自然引出下一页关于士大夫身份焦虑与话语权争夺的讨论。",
      "blocks": [
        {
          "type": "sim",
          "engine": "widget",
          "html": "<style>\n  .widget {\n    background: var(--bg2);\n    border-radius: var(--radius, 12px);\n    padding: 20px;\n    color: var(--ink);\n    font-family: var(--sans);\n    height: 100%;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }\n  @media (prefers-reduced-motion: no-preference) {\n    .widget { animation: fadeIn 0.45s ease; }\n  }\n  .stage-wrap {\n    flex: 1;\n    min-height: 120px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  #stage {\n    display: block;\n    background: var(--card);\n    border-radius: var(--radius, 8px);\n    cursor: crosshair;\n    touch-action: none;\n  }\n  .controls {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    flex-wrap: wrap;\n  }\n  .ctrl {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex: 1;\n    min-width: 160px;\n  }\n  .ctrl label {\n    font-size: 13px;\n    color: var(--text2);\n    white-space: nowrap;\n    font-family: var(--serif);\n  }\n  .ctrl input[type=range] {\n    flex: 1;\n    accent-color: var(--accent);\n    min-width: 0;\n  }\n  .val {\n    font-family: var(--mono);\n    font-variant-numeric: tabular-nums;\n    font-size: 13px;\n    color: var(--ink);\n    min-width: 36px;\n    text-align: right;\n    transition: color 0.3s ease;\n  }\n  .val.flash {\n    color: var(--accent);\n  }\n  button {\n    font-family: var(--sans);\n    font-size: 12px;\n    padding: 8px 16px;\n    border: 1px solid var(--line);\n    background: transparent;\n    color: var(--text2);\n    border-radius: var(--radius, 6px);\n    cursor: pointer;\n    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;\n    letter-spacing: 0.05em;\n  }\n  button:hover {\n    color: var(--ink);\n    border-color: var(--ink);\n  }\n  button:active {\n    transform: scale(0.97);\n  }\n</style>\n<div class=\"widget\">\n  <div class=\"stage-wrap\">\n    <canvas id=\"stage\" width=\"680\" height=\"360\"></canvas>\n  </div>\n  <div class=\"controls\">\n    <div class=\"ctrl\">\n      <label for=\"ink\">墨量</label>\n      <input type=\"range\" id=\"ink\" min=\"0.1\" max=\"1.0\" step=\"0.05\" value=\"0.65\">\n      <span class=\"val mono\" id=\"inkVal\">0.65</span>\n    </div>\n    <div class=\"ctrl\">\n      <label for=\"speed\">笔速</label>\n      <input type=\"range\" id=\"speed\" min=\"0.1\" max=\"1.0\" step=\"0.05\" value=\"0.50\">\n      <span class=\"val mono\" id=\"speedVal\">0.50</span>\n    </div>\n    <button id=\"clear\">净纸</button>\n  </div>\n</div>\n<script>\n(function() {\n  const root = document.documentElement;\n  const tok = n => getComputedStyle(root).getPropertyValue(n).trim();\n\n  const canvas = document.getElementById('stage');\n  const ctx = canvas.getContext('2d');\n  const W = canvas.width, H = canvas.height;\n  const mid = W / 2;\n\n  const state = {\n    ink: 0.65,\n    speed: 0.5,\n    strokes: [{points:[{x:0.2,y:0.5},{x:0.8,y:0.5}],ink:0.65,speed:0.5}],\n    isDrawing: false\n  };\n\n  let currentStroke = null;\n\n  function hash(x, y) {\n    let h = ((x | 0) * 374761393 + (y | 0) * 668265263) | 0;\n    h = (h ^ (h >> 13)) * 1274126177 | 0;\n    return ((h ^ (h >> 16)) >>> 0) / 4294967295;\n  }\n\n  function update() {\n    const inkColor = tok('--ink');\n    const lineColor = tok('--line');\n    const muteColor = tok('--text2');\n    const serifFont = tok('--serif');\n\n    ctx.clearRect(0, 0, W, H);\n\n    // 绢本纹理：细密经纬线\n    ctx.strokeStyle = lineColor;\n    ctx.lineWidth = 0.5;\n    ctx.globalAlpha = 0.05;\n    for (let x = 0; x < mid; x += 5) {\n      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();\n    }\n    for (let y = 0; y < H; y += 5) {\n      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(mid, y); ctx.stroke();\n    }\n\n    // 皮纸纹理：纤维点\n    ctx.fillStyle = lineColor;\n    ctx.globalAlpha = 0.04;\n    for (let i = 0; i < 600; i++) {\n      const fx = mid + hash(i, 0) * (W - mid);\n      const fy = hash(i, 1) * H;\n      ctx.beginPath(); ctx.arc(fx, fy, 0.6, 0, Math.PI * 2); ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n\n    // 中线\n    ctx.strokeStyle = lineColor;\n    ctx.lineWidth = 1;\n    ctx.setLineDash([3, 5]);\n    ctx.beginPath();\n    ctx.moveTo(mid, 30);\n    ctx.lineTo(mid, H - 12);\n    ctx.stroke();\n    ctx.setLineDash([]);\n\n    // 材质标注\n    ctx.font = '13px ' + serifFont;\n    ctx.fillStyle = muteColor;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'top';\n    ctx.fillText('绢本', mid / 2, 10);\n    ctx.fillText('皮纸', mid + mid / 2, 10);\n\n    // 渲染所有 strokes\n    state.strokes.forEach(stroke => {\n      const pts = stroke.points.map(p => ({x: p.x * W, y: p.y * H}));\n      if (pts.length < 1) return;\n\n      // 左半（绢本）\n      ctx.save();\n      ctx.beginPath();\n      ctx.rect(0, 0, mid, H);\n      ctx.clip();\n      renderSilk(pts, stroke, inkColor);\n      ctx.restore();\n\n      // 右半（皮纸）\n      ctx.save();\n      ctx.beginPath();\n      ctx.rect(mid, 0, W - mid, H);\n      ctx.clip();\n      renderPaper(pts, stroke, inkColor);\n      ctx.restore();\n    });\n  }\n\n  function renderSilk(pts, stroke, inkColor) {\n    const inkAmount = stroke.ink;\n    const speed = stroke.speed;\n    const baseWidth = 3 + inkAmount * 5;\n\n    if (pts.length < 2) {\n      ctx.fillStyle = inkColor;\n      ctx.globalAlpha = 0.55 + inkAmount * 0.35;\n      ctx.beginPath();\n      ctx.arc(pts[0].x, pts[0].y, baseWidth / 2, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.globalAlpha = 1;\n      return;\n    }\n\n    // 锐利主笔触\n    ctx.strokeStyle = inkColor;\n    ctx.globalAlpha = 0.55 + inkAmount * 0.35;\n    ctx.lineWidth = baseWidth;\n    ctx.lineCap = 'round';\n    ctx.lineJoin = 'round';\n    ctx.beginPath();\n    ctx.moveTo(pts[0].x, pts[0].y);\n    for (let j = 1; j < pts.length; j++) ctx.lineTo(pts[j].x, pts[j].y);\n    ctx.stroke();\n\n    // 绢本极少飞白（speed > 0.5 才有轻微断续）\n    if (speed > 0.5) {\n      const intensity = (speed - 0.5) / 0.5;\n      ctx.fillStyle = inkColor;\n      for (let i = 0; i < pts.length - 1; i++) {\n        const p1 = pts[i], p2 = pts[i+1];\n        const dist = Math.hypot(p2.x - p1.x, p2.y - p1.y);\n        const steps = Math.floor(dist / 1.5);\n        for (let s = 0; s < steps; s++) {\n          const t = s / steps;\n          const x = p1.x + (p2.x - p1.x) * t;\n          const y = p1.y + (p2.y - p1.y) * t;\n          const seed = hash(Math.floor(x * 8), Math.floor(y * 8));\n          if (seed < intensity * 0.2) continue;\n          ctx.globalAlpha = 0.4 + inkAmount * 0.3;\n          ctx.beginPath();\n          ctx.arc(x, y, 1 + inkAmount * 1.2, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n    }\n    ctx.globalAlpha = 1;\n  }\n\n  function renderPaper(pts, stroke, inkColor) {\n    const inkAmount = stroke.ink;\n    const speed = stroke.speed;\n    const baseWidth = 2.5 + inkAmount * 4;\n\n    if (pts.length < 2) {\n      for (let i = 5; i >= 1; i--) {\n        ctx.fillStyle = inkColor;\n        ctx.globalAlpha = (0.03 + inkAmount * 0.05) * (1 - (i-1) / 5 * 0.6);\n        ctx.beginPath();\n        ctx.arc(pts[0].x, pts[0].y, (2 + inkAmount * 3) + i * (1.5 + inkAmount * 2), 0, Math.PI * 2);\n        ctx.fill();\n      }\n      ctx.fillStyle = inkColor;\n      ctx.globalAlpha = 0.3 + inkAmount * 0.3;\n      ctx.beginPath();\n      ctx.arc(pts[0].x, pts[0].y, 1.5 + inkAmount * 1.5, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.globalAlpha = 1;\n      return;\n    }\n\n    // 渗化层（多层 stroke，宽度递增、透明度递减）\n    const layers = 5;\n    for (let i = layers; i >= 1; i--) {\n      ctx.strokeStyle = inkColor;\n      const t = i / layers;\n      ctx.globalAlpha = (0.025 + inkAmount * 0.05) * (1 - t * 0.5);\n      ctx.lineWidth = baseWidth * (1 + t * (1.2 + inkAmount * 1.5));\n      ctx.lineCap = 'round';\n      ctx.lineJoin = 'round';\n      ctx.beginPath();\n      ctx.moveTo(pts[0].x, pts[0].y);\n      for (let j = 1; j < pts.length; j++) ctx.lineTo(pts[j].x, pts[j].y);\n      ctx.stroke();\n    }\n\n    // 主笔触 + 飞白（粒子方式）\n    ctx.fillStyle = inkColor;\n    const flyWhiteProb = speed * 0.5;\n    const diffuseR = 2 + inkAmount * 3;\n\n    for (let i = 0; i < pts.length - 1; i++) {\n      const p1 = pts[i], p2 = pts[i+1];\n      const dist = Math.hypot(p2.x - p1.x, p2.y - p1.y);\n      const steps = Math.max(1, Math.floor(dist / 1.2));\n      for (let s = 0; s <= steps; s++) {\n        const t = s / steps;\n        const cx = p1.x + (p2.x - p1.x) * t;\n        const cy = p1.y + (p2.y - p1.y) * t;\n\n        const seed = hash(Math.floor(cx * 10), Math.floor(cy * 10));\n        if (seed < flyWhiteProb) continue;\n\n        // 中心粒子\n        ctx.globalAlpha = 0.25 + inkAmount * 0.3;\n        ctx.beginPath();\n        ctx.arc(cx, cy, 1 + inkAmount * 1.3, 0, Math.PI * 2);\n        ctx.fill();\n\n        // 扩散粒子\n        for (let p = 0; p < 3; p++) {\n          const sa = hash(Math.floor(cx * 10) + p * 17, Math.floor(cy * 10) + p * 23);\n          const sr = hash(Math.floor(cx * 7) + p * 11, Math.floor(cy * 7) + p * 13);\n          const angle = sa * Math.PI * 2;\n          const r = Math.sqrt(sr) * diffuseR;\n          ctx.globalAlpha = (0.1 + inkAmount * 0.12) * (1 - r / (diffuseR + 0.5));\n          ctx.beginPath();\n          ctx.arc(cx + Math.cos(angle) * r, cy + Math.sin(angle) * r, 0.7, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n    }\n    ctx.globalAlpha = 1;\n  }\n\n  // canvas 尺寸适配\n  function fitCanvas() {\n    const wrap = canvas.parentElement;\n    const wr = wrap.getBoundingClientRect();\n    if (wr.width === 0 || wr.height === 0) return;\n    const cr = W / H;\n    let dw = wr.width;\n    let dh = dw / cr;\n    if (dh > wr.height) {\n      dh = wr.height;\n      dw = dh * cr;\n    }\n    canvas.style.width = Math.floor(dw) + 'px';\n    canvas.style.height = Math.floor(dh) + 'px';\n  }\n\n  function getCanvasPoint(e) {\n    const rect = canvas.getBoundingClientRect();\n    const x = (e.clientX - rect.left) / rect.width;\n    const y = (e.clientY - rect.top) / rect.height;\n    return { x: Math.max(0, Math.min(1, x)), y: Math.max(0, Math.min(1, y)) };\n  }\n\n  canvas.addEventListener('pointerdown', e => {\n    e.preventDefault();\n    canvas.setPointerCapture(e.pointerId);\n    state.isDrawing = true;\n    const pt = getCanvasPoint(e);\n    currentStroke = { points: [pt], ink: state.ink, speed: state.speed };\n    state.strokes.push(currentStroke);\n    update();\n  });\n\n  canvas.addEventListener('pointermove', e => {\n    if (!state.isDrawing || !currentStroke) return;\n    e.preventDefault();\n    const pt = getCanvasPoint(e);\n    const last = currentStroke.points[currentStroke.points.length - 1];\n    const dx = pt.x - last.x, dy = pt.y - last.y;\n    if (dx * dx + dy * dy < 0.0004) return;\n    currentStroke.points.push(pt);\n    update();\n  });\n\n  function endDraw() {\n    state.isDrawing = false;\n    currentStroke = null;\n  }\n  canvas.addEventListener('pointerup', endDraw);\n  canvas.addEventListener('pointercancel', endDraw);\n\n  // 滑块\n  const inkSlider = document.getElementById('ink');\n  const speedSlider = document.getElementById('speed');\n  const inkVal = document.getElementById('inkVal');\n  const speedVal = document.getElementById('speedVal');\n\n  function flashVal(el) {\n    el.classList.add('flash');\n    clearTimeout(el._t);\n    el._t = setTimeout(() => el.classList.remove('flash'), 300);\n  }\n\n  inkSlider.addEventListener('input', e => {\n    state.ink = parseFloat(e.target.value);\n    inkVal.textContent = state.ink.toFixed(2);\n    flashVal(inkVal);\n  });\n\n  speedSlider.addEventListener('input', e => {\n    state.speed = parseFloat(e.target.value);\n    speedVal.textContent = state.speed.toFixed(2);\n    flashVal(speedVal);\n  });\n\n  document.getElementById('clear').addEventListener('click', () => {\n    state.strokes = [];\n    update();\n  });\n\n  // 主题变化重绘\n  new MutationObserver(update).observe(root, {attributes: true, attributeFilter: ['data-theme']});\n\n  // 初始化\n  fitCanvas();\n  update();\n\n  if (window.ResizeObserver) {\n    new ResizeObserver(fitCanvas).observe(canvas.parentElement);\n  } else {\n    window.addEventListener('resize', fitCanvas);\n  }\n})();\n</script>",
          "id": "b5_sim"
