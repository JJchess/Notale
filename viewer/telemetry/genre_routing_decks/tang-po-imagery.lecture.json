{
  "id": "tang-po-imagery",
  "title": "唐诗中的意象",
  "subtitle": "物色与情思的交融",
  "language": "zh-CN",
  "audience": "高中及以上文学爱好者",
  "theme": "vellum",
  "tutor": {
    "suggestions": [
      "为什么'鸡声茅店月'全是名词却画面感极强？",
      "李白的'月'和杜甫的'月'有什么本质不同？",
      "没去过玉门关的诗人为什么也爱写玉门关？",
      "现代人如何跨越时空与唐诗意象共情？"
    ],
    "kb": [
      {
        "pattern": "意象|客观物象",
        "answer": "客观物象与主观情思的融合。非纯然景物，亦非抽象情感，而是'意中之象'，如'明月'不仅是天体，更是思乡的肉身。"
      },
      {
        "pattern": "意境|意境生成",
        "answer": "多个意象组合后生成的整体氛围与审美空间。意象是砖石，意境是殿堂；意象是局部，意境是整体。"
      },
      {
        "pattern": "并置|名词并置",
        "answer": "意象组合技巧之一，省去动词与逻辑连接词，将几个名词直接排列，如'鸡声茅店月'，强迫读者用想象填补空白，产生蒙太奇效果。"
      },
      {
        "pattern": "公共意象|集体无意识",
        "answer": "被整个时代或文化反复使用、具有固定情感指向的意象，如'折柳'表送别、'长亭'表羁旅，承载集体无意识。"
      },
      {
        "pattern": "个人化意象|奇诡意象",
        "answer": "带有诗人强烈个性印记、甚至精神病理特征的意象，如李贺的'鬼雨''恨血'，无法被轻易复制或替代。"
      }
    ]
  },
  "scenes": [
    {
      "id": "cover",
      "kind": "hero",
      "notes": "唐诗之所以能跨越千年引发共鸣，靠的不是词藻堆砌，而是那些承载情感的“密码”——意象，但大家常误以为意象仅仅是诗里的“景物”或简单的“比喻”。实际上它远比客观描写更主观、更深刻，那么古人是如何把个人情思注入客观物象的呢？我们马上进入下一页，拆解意象的真正构成。",
      "blocks": [
        {
          "type": "hero",
          "tag": "古典诗歌",
          "title": [
            "唐诗中的",
            "意象"
          ],
          "sub": "以*孤月*、*落花*与*长亭*为例，解码诗人如何将情思寄托于物",
          "facts": "《全唐诗》收录诗作四万八千余首，高频意象不足百种",
          "hint": "试着在阅读时捕捉那些反复出现的自然物象",
          "id": "b_cover"
        }
      ]
    },
    {
      "id": "definition",
      "kind": "content",
      "eyebrow": "审美与文本",
      "headline": "意象：客观物象与主观情思的融合",
      "lead": "意象非纯然景物，亦非抽象情感，而是物色与情思的婚媾。",
      "notes": "大家注意，意象绝不是单纯的景物描写，而是客观的‘象’被诗人主观的‘意’浸染后的产物，比如同是一轮明月，在李白笔下是思乡，在边塞诗里则是苍凉。很多同学常把意象和普通的修辞比喻混为一谈，忽略了它必须承载作者真实的情感投射。刚才我们界定了什么是单个意象，那么当这些带着情感的意象在诗中叠加碰撞时，又会产生怎样更宏大的‘意境’呢？这就是下一页我们要探讨的重点。",
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "lead": "定义",
              "text": "意象 = 客观物象 + 主观情思的融合。王维《使至塞上》\"大漠孤烟直，长河落日圆\"中，\"孤烟\"\"落日\"并非纯写景，而是苍凉孤寂之情的载体——物象即情思。",
              "icon": "trending-up"
            },
            {
              "lead": "区别于比喻",
              "text": "比喻是临时修辞，甲喻乙、关系明确且一次性；意象是反复出现、积淀文化情感的稳定物象。李商隐\"春蚕到死丝方尽\"中春蚕是比喻（一次性喻相思者），而\"月\"在张九龄\"海上生明月，天涯共此时\"、李白\"举头望明月，低头思故乡\"中反复承载思乡，是意象。",
              "fragment": "fade-up",
              "icon": "lightbulb"
            },
            {
              "lead": "区别于象征",
              "text": "象征侧重抽象理念的对应，意象侧重情感氛围的营造。\"松柏\"象征坚贞品格（理念对应），而孟浩然\"野旷天低树，江清月近人\"中的\"旷野\"\"清江\"营造的是孤寂漂泊的情感氛围，而非某个理念。",
              "fragment": "fade-up",
              "icon": "lightbulb"
            },
            {
              "lead": "文化复现",
              "text": "同一意象在不同诗作中承载相似情感，形成集体记忆。\"柳\"在王维\"客舍青青柳色新\"与李白\"年年柳色，灞陵伤别\"中均承载离别之情。",
              "icon": "lightbulb"
            }
          ],
          "id": "b1"
        },
        {
          "type": "callout",
          "label": "辨析",
          "text": "比喻重在“比”（如“芙蓉如面”取形似），象征重在“征”（如“梅”征坚贞为约定），意象重在“融”（如“孤帆”融客愁，物我合一）。",
          "id": "b2"
        }
      ],
      "layout": {
        "kind": "compose",
        "preset": "sidenote"
      }
    },
    {
      "id": "combination",
      "kind": "content",
      "eyebrow": "组合与意境",
      "headline": "意象的组合与意境的生成",
      "lead": "孤立意象仅是词汇，意象叠加方生意境。",
      "transition": "zoom",
      "notes": "上一页我们定义了单个意象是主客观的融合，这一页则要探讨这些意象如何像电影蒙太奇一样拼接出整体的“意境”。大家常有个误区，以为意境是靠华丽辞藻堆砌或直接抒情写出来的，其实唐诗的高妙往往在于“鸡声茅店月”这种纯名词的跳跃组合，通过意象间的留白激发读者的联想。这种组合方式看似是诗人的个人技巧，但意象的选取和拼接逻辑其实深深植根于当时的时代生活，这就自然引出下一页我们要讲的唐代制度与风物土壤。",
      "blocks": [
        {
          "type": "statement",
          "statement": "纯名词并置如蒙太奇般直接生成意境——温庭筠**鸡声茅店月，人迹板桥霜**十字全为意象，无一动词连缀。",
          "id": "b3"
        },
        {
          "type": "flow",
          "nodes": [
            {
              "title": "意象并置",
              "sub": "「鸡声茅店月，人迹板桥霜」——温庭筠《商山早行》，六名词零动词，早行孤旅之象自现"
            },
            {
              "title": "意象叠加",
              "sub": "「星垂平野阔，月涌大江流」——杜甫《旅夜书怀》，天地交映，孤舟渺然其间"
            },
            {
              "title": "通感转换",
              "sub": "「芙蓉泣露香兰笑」——李贺《李凭箜篌引》，箜篌乐声化为花容泣笑，耳听转目见"
            },
            {
              "title": "意境生成",
              "sub": "孤寂·苍茫·瑰丽——象外之味不可言传，却已盈胸"
            }
          ],
          "fragment": "fade-up",
          "id": "b4"
        }
      ],
