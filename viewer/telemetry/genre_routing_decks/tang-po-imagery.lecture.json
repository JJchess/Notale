          "engine": "widget",
          "html": "<style>\n  :root {\n    --stage-w: 800;\n    --stage-h: 500;\n  }\n  .widget {\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    background: var(--bg);\n    color: var(--ink);\n    font-family: var(--sans);\n    user-select: none;\n    overflow: hidden;\n  }\n  #stage {\n    flex: 1;\n    width: 100%;\n    min-height: 0;\n    display: block;\n    cursor: crosshair;\n  }\n  #stage use {\n    cursor: grab;\n    transition: opacity 450ms ease;\n  }\n  #stage use:active {\n    cursor: grabbing;\n  }\n  #fogRect {\n    transition: opacity 450ms ease;\n  }\n  .stop-trans {\n    transition: stop-color 450ms ease;\n  }\n  #emotionText {\n    font-family: var(--serif);\n    font-size: 24px;\n    letter-spacing: 0.1em;\n    transition: fill 450ms ease;\n    pointer-events: none;\n  }\n  #palette {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 16px;\n    padding: 12px 16px;\n    background: var(--bg2);\n    border-top: 1px solid var(--line);\n  }\n  .pal-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n    padding: 8px 12px;\n    border-radius: var(--radius);\n    border: 1px solid var(--line);\n    background: var(--card);\n    cursor: grab;\n    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;\n  }\n  .pal-item:hover {\n    transform: translateY(-2px);\n    border-color: var(--accent);\n    box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n  }\n  .pal-item:active {\n    transform: translateY(0);\n    cursor: grabbing;\n  }\n  .pal-item svg {\n    width: 32px;\n    height: 32px;\n    color: var(--ink);\n  }\n  .pal-label {\n    font-size: 12px;\n    color: var(--text2);\n    font-family: var(--serif);\n  }\n</style>\n\n<div class=\"widget\">\n  <svg id=\"stage\" viewBox=\"0 0 800 500\" preserveAspectRatio=\"xMidYMid slice\">\n    <defs>\n      <linearGradient id=\"bgGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop id=\"stop1\" class=\"stop-trans\" offset=\"0%\" stop-color=\"hsl(205, 32%, 44%)\" />\n        <stop id=\"stop2\" class=\"stop-trans\" offset=\"100%\" stop-color=\"hsl(225, 32%, 24%)\" />\n      </linearGradient>\n      <filter id=\"fogFilter\">\n        <feGaussianBlur stdDeviation=\"20\" />\n      </filter>\n      \n      <symbol id=\"sym-moon\" viewBox=\"-25 -25 50 50\">\n        <circle cx=\"0\" cy=\"0\" r=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\" />\n        <path d=\"M6,-16 A18,18 0 0,1 6,16 A12,12 0 0,0 6,-16 Z\" fill=\"currentColor\" opacity=\"0.25\" vector-effect=\"non-scaling-stroke\" />\n      </symbol>\n      \n      <symbol id=\"sym-boat\" viewBox=\"-30 -25 60 50\">\n        <path d=\"M-22,6 Q-18,16 0,16 Q18,16 22,6 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\" />\n        <line x1=\"0\" y1=\"6\" x2=\"0\" y2=\"-14\" stroke=\"currentColor\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\" />\n        <path d=\"M0,-14 L12,-4 L0,2 Z\" fill=\"currentColor\" opacity=\"0.2\" stroke=\"currentColor\" stroke-width=\"1\" vector-effect=\"non-scaling-stroke\" />\n      </symbol>\n      \n      <symbol id=\"sym-flower\" viewBox=\"-25 -25 50 50\">\n        <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\">\n          <path d=\"M0,-16 Q8,-8 0,0 Q-8,-8 0,-16 Z\" fill=\"currentColor\" opacity=\"0.2\" />\n          <path d=\"M15.1,5.3 Q5.3,8.5 0,0 Q8.5,-5.3 15.1,5.3 Z\" fill=\"currentColor\" opacity=\"0.2\" />\n          <path d=\"M-15.1,5.3 Q-8.5,-5.3 0,0 Q-5.3,8.5 -15.1,5.3 Z\" fill=\"currentColor\" opacity=\"0.2\" />\n          <path d=\"M9.4,-13 Q5.3,0 0,0 Q-5.3,-13 9.4,-13 Z\" fill=\"currentColor\" opacity=\"0.2\" />\n          <path d=\"M-9.4,-13 Q0,0 -5.3,-13 Z\" fill=\"currentColor\" opacity=\"0.2\" />\n          <circle cx=\"0\" cy=\"0\" r=\"3\" fill=\"currentColor\" opacity=\"0.4\" />\n        </g>\n      </symbol>\n      \n      <symbol id=\"sym-pavilion\" viewBox=\"-30 -30 60 60\">\n        <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\">\n          <path d=\"M-24,0 Q-12,-8 0,-20 Q12,-8 24,0\" />\n          <path d=\"M-18,-4 Q-9,-10 0,-16 Q9,-10 18,-4\" />\n          <line x1=\"-16\" y1=\"0\" x2=\"-16\" y2=\"16\" />\n          <line x1=\"16\" y1=\"0\" x2=\"16\" y2=\"16\" />\n          <line x1=\"-24\" y1=\"16\" x2=\"24\" y2=\"16\" />\n        </g>\n      </symbol>\n    </defs>\n\n    <rect id=\"bgRect\" width=\"100%\" height=\"100%\" fill=\"url(#bgGrad)\" />\n    <rect id=\"fogRect\" x=\"-50\" y=\"-50\" width=\"900\" height=\"600\" fill=\"white\" opacity=\"0.22\" filter=\"url(#fogFilter)\" />\n    \n    <g id=\"placedGroup\"></g>\n    \n    <text id=\"emotionText\" x=\"400\" y=\"470\" text-anchor=\"middle\" fill=\"hsl(205, 60%, 70%)\">清冷孤寂</text>\n  </svg>\n\n  <div id=\"palette\">\n    <div class=\"pal-item\" draggable=\"true\" data-type=\"moon\">\n      <svg><use href=\"#sym-moon\" width=\"32\" height=\"32\" x=\"16\" y=\"16\" /></svg>\n      <span class=\"pal-label\">明月</span>\n    </div>\n    <div class=\"pal-item\" draggable=\"true\" data-type=\"boat\">\n      <svg><use href=\"#sym-boat\" width=\"32\" height=\"32\" x=\"14\" y=\"16\" /></svg>\n      <span class=\"pal-label\">孤舟</span>\n    </div>\n    <div class=\"pal-item\" draggable=\"true\" data-type=\"flower\">\n      <svg><use href=\"#sym-flower\" width=\"32\" height=\"32\" x=\"16\" y=\"16\" /></svg>\n      <span class=\"pal-label\">落花</span>\n    </div>\n    <div class=\"pal-item\" draggable=\"true\" data-type=\"pavilion\">\n      <svg><use href=\"#sym-pavilion\" width=\"32\" height=\"32\" x=\"14\" y=\"14\" /></svg>\n      <span class=\"pal-label\">长亭</span>\n    </div>\n  </div>\n</div>\n\n<script>\n  const SVG_NS = 'http://www.w3.org/2000/svg';\n  const W = 800, H = 500;\n\n  const state = {\n    placed: [\n      { type: 'moon', x: 0.28, y: 0.24 },\n      { type: 'boat', x: 0.63, y: 0.69 }\n    ],\n    bgHue: 205,\n    bgSat: 0.32,\n    bgLight: 0.34,\n    fogOpacity: 0.22,\n    emotionLabel: '清冷孤寂',\n    emotionHue: 205\n  };\n\n  const hueMap = { moon: 210, boat: 200, flower: 340, pavilion: 30 };\n  const satMap = { moon: 0.4, boat: 0.3, flower: 0.5, pavilion: 0.5 };\n  const lightMap = { moon: 0.4, boat: 0.3, flower: 0.5, pavilion: 0.5 };\n  const fogMap = { moon: 0.3, boat: 0.2, flower: 0.1, pavilion: 0.15 };\n\n  const emotionMap = {\n    'moon': { label: '孤月清辉', hue: 210 },\n    'boat': { label: '孤舟独泊', hue: 200 },\n    'flower': { label: '落花伤春', hue: 340 },\n    'pavilion': { label: '长亭送别', hue: 30 },\n    'boat+moon': { label: '清冷孤寂', hue: 205 },\n    'flower+moon': { label: '月下伤春', hue: 275 },\n    'moon+pavilion': { label: '月夜离愁', hue: 120 },\n    'boat+flower': { label: '流水落花', hue: 270 },\n    'boat+pavilion': { label: '江岸送别', hue: 115 },\n    'flower+pavilion': { label: '暮春长亭', hue: 185 },\n    'boat+flower+moon': { label: '孤舟月下落花', hue: 250 },\n    'boat+moon+pavilion': { label: '月夜江岸送别', hue: 140 },\n    'flower+moon+pavilion': { label: '月下长亭伤春', hue: 190 },\n    'boat+flower+pavilion': { label: '落花江岸送别', hue: 190 },\n    'boat+flower+moon+pavilion': { label: '千古离愁', hue: 195 },\n    '': { label: '空山新雨', hue: 180 }\n  };\n\n  const svg = document.getElementById('stage');\n  const stop1 = document.getElementById('stop1');\n  const stop2 = document.getElementById('stop2');\n  const fogRect = document.getElementById('fogRect');\n  const emotionText = document.getElementById('emotionText');\n  const placedGroup = document.getElementById('placedGroup');\n\n  function update() {\n    let sinH = 0, cosH = 0, sumS = 0, sumL = 0, sumF = 0;\n    const n = state.placed.length || 1;\n\n    state.placed.forEach(p => {\n      const h = hueMap[p.type] * Math.PI / 180;\n      sinH += Math.sin(h);\n      cosH += Math.cos(h);\n      sumS += satMap[p.type];\n      sumL += lightMap[p.type];\n      sumF += fogMap[p.type];\n    });\n\n    state.bgHue = Math.atan2(sinH, cosH) * 180 / Math.PI;\n    if (state.bgHue < 0) state.bgHue += 360;\n    state.bgSat = Math.min(0.55, Math.max(0.05, sumS / n));\n    state.bgLight = Math.min(0.6, Math.max(0.12, sumL / n));\n    state.fogOpacity = Math.min(0.5, Math.max(0, sumF / n));\n\n    const key = state.placed.map(p => p.type).sort().join('+');\n    const emotion = emotionMap[key] || emotionMap[''];\n    state.emotionLabel = emotion.label;\n    state.emotionHue = emotion.hue;\n\n    const h = Math.round(state.bgHue);\n    const s = Math.round(state.bgSat * 100);\n    const l = Math.round(state.bgLight * 100);\n    \n    stop1.setAttribute('stop-color', `hsl(${h}, ${s}%, ${Math.min(90, l + 15)}%)`);\n    stop2.setAttribute('stop-color', `hsl(${(h + 20) % 360}, ${s}%, ${Math.max(10, l - 10)}%)`);\n    \n    fogRect.setAttribute('opacity', state.fogOpacity.toFixed(2));\n\n    const eH = Math.round(state.emotionHue);\n    emotionText.textContent = state.emotionLabel;\n    emotionText.setAttribute('fill', `hsl(${eH}, 60%, 75%)`);\n\n    // Rebuild placed items\n    placedGroup.innerHTML = '';\n    state.placed.forEach((p, i) => {\n      const use = document.createElementNS(SVG_NS, 'use');\n      use.setAttribute('href', `#sym-${p.type}`);\n      use.setAttribute('x', '-25');\n      use.setAttribute('y', '-25');\n      use.setAttribute('width', '50');\n      use.setAttribute('height', '50');\n      use.setAttribute('transform', `translate(${p.x * W}, ${p.y * H})`);\n      use.setAttribute('color', `hsl(${eH}, 50%, 85%)`);\n      use.dataset.index = i;\n      use.style.opacity = '0';\n      placedGroup.appendChild(use);\n      // Trigger fade in\n      requestAnimationFrame(() => { use.style.opacity = '1'; });\n    });\n  }\n\n  // Drag from palette\n  document.querySelectorAll('.pal-item').forEach(item => {\n    item.addEventListener('dragstart', e => {\n      e.dataTransfer.setData('text/plain', item.dataset.type);\n      e.dataTransfer.effectAllowed = 'copy';\n    });\n  });\n\n  svg.addEventListener('dragover', e => {\n    e.preventDefault();\n    e.dataTransfer.dropEffect = 'copy';\n  });\n\n  svg.addEventListener('drop', e => {\n    e.preventDefault();\n    const type = e.dataTransfer.getData('text/plain');\n    if (!type || state.placed.length >= 4 || state.placed.some(p => p.type === type)) return;\n\n    const pt = svg.createSVGPoint();\n    pt.x = e.clientX;\n    pt.y = e.clientY;\n    const svgPt = pt.matrixTransform(svg.getScreenCTM().inverse());\n    \n    const x = Math.max(0.05, Math.min(0.95, svgPt.x / W));\n    const y = Math.max(0.05, Math.min(0.95, svgPt.y / H));\n\n    state.placed.push({ type, x, y });\n    update();\n  });\n\n  // Drag within SVG\n  let dragIdx = -1;\n  let dragStartX, dragStartY;\n  let origX, origY;\n  let hasMoved = false;\n\n  placedGroup.addEventListener('mousedown', e => {\n    const use = e.target.closest('use');\n    if (!use) return;\n    e.preventDefault();\n    \n    dragIdx = parseInt(use.dataset.index);\n    dragStartX = e.clientX;\n    dragStartY = e.clientY;\n    origX = state.placed[dragIdx].x;\n    origY = state.placed[dragIdx].y;\n    hasMoved = false;\n  });\n\n  window.addEventListener('mousemove', e => {\n    if (dragIdx === -1) return;\n    \n    const dx = e.clientX - dragStartX;\n    const dy = e.clientY - dragStartY;\n    \n    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {\n      hasMoved = true;\n    }\n\n    const ctm = svg.getScreenCTM();\n    const scale = ctm.a; // Assuming uniform scaling\n    \n    const newX = origX + (dx / scale) / W;\n    const newY = origY + (dy / scale) / H;\n    \n    state.placed[dragIdx].x = Math.max(0.05, Math.min(0.95, newX));\n    state.placed[dragIdx].y = Math.max(0.05, Math.min(0.95, newY));\n    \n    const use = placedGroup.querySelector(`use[data-index=\"${dragIdx}\"]`);\n    if (use) {\n      use.setAttribute('transform', `translate(${state.placed[dragIdx].x * W}, ${state.placed[dragIdx].y * H})`);\n    }\n  });\n\n  window.addEventListener('mouseup', e => {\n    if (dragIdx === -1) return;\n    \n    if (!hasMoved) {\n      // Click to remove\n      state.placed.splice(dragIdx, 1);\n      update();\n    }\n    \n    dragIdx = -1;\n  });\n\n  // Initial paint\n  update();\n</script>",
          "id": "b11"
        },
        {
          "type": "callout",
          "label": "跨时空共鸣",
          "text": "现代人虽无永州贬谪之苦，却能在`孤舟蓑笠翁`中照见都市喧嚣下的精神孤立——意象的留白让千年寒江雪落在了现代人的内耗里。",
          "id": "b12"
        }
      ],
      "layout": {
        "kind": "split",
        "anchor": [
          "b12"
        ],
        "ratio": 0.4
      }
    },
    {
      "id": "ending",
      "kind": "hero",
      "notes": "同学们，承接上一页的“现代解码”，我们在这最后一页看到唐诗意象不仅是文学修辞，更是跨越千年的文化英雄。大家常误以为意象只是考卷上需要死记硬背的修辞套路，其实它们是古人留给我们的情感密码，需要我们在生活体验中去激活。今天这堂课只是起点，希望大家以后在看到明月、落花时，能真正与千年前的诗人产生共鸣，做自己精神世界的英雄。",
      "blocks": [
        {
          "type": "hero",
          "tag": "结语",
          "title": [
            "意象，是通往唐诗内心世界的密钥"
          ],
          "sub": "从*明月*到*孤帆*，从*落花*到*长河*——每一个意象都是诗人递出的暗号。",
          "facts": "《全唐诗》近五万首诗中，'月'出现逾万次，'风'逾八千次。",
          "hint": "读懂意象，便读懂了诗人心跳的节拍。",
          "id": "b_ending"
        }
      ]
    }
  ],
  "schemaVersion": "1.0"
